      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Movers</string>
          <string name="Source"><![CDATA[--[[
	Movers.luau
	The selectable mover looks (original designs) and the costume builder that dresses a
	rig in one. Movers are small and chunky: a big blocky head (a rounded cube) with a
	simple face, a short body, big brown work gloves and chunky boots. The shirt always
	takes the player's slot colour and carries the slot number on the chest and back, so
	colour is never the only identifier; each style has its own head silhouette.

	Movers.Build dresses any set of R15-named anchor parts: the server uses the real
	character (MoverBuilder.luau, parts welded on), the Look menu uses a static preview
	model in a ViewportFrame (Movers.PreviewModel, anchored, no welds).
]]

local Shapes = require(script.Parent.Shapes)

local Movers = {}

local V = Vector3.new
local CF = CFrame.new
local Angles = CFrame.Angles
local rad = math.rad
local rgb = Color3.fromRGB

local GLOVE = rgb(168, 108, 62)
local CUFF = rgb(112, 70, 42)
local SHOE = rgb(104, 66, 44)
local SOLE = rgb(60, 44, 36)
local PANTS = rgb(56, 62, 86)
local INK = rgb(34, 26, 30)

Movers.Styles = {
	{ Name = "Boxy", Head = "Box", Color = rgb(214, 166, 112), Size = V(2.35, 2.04, 2.20), Card = rgb(232, 150, 70), Pants = rgb(70, 64, 60) },
	{ Name = "Cap Kid", Head = "Cap", Color = rgb(255, 212, 168), Size = V(2.24, 2.10, 2.14), Card = rgb(70, 150, 220), Pants = PANTS, Accent = rgb(255, 120, 60), Hair = rgb(120, 72, 40) },
	{ Name = "Bear", Head = "Bear", Color = rgb(150, 98, 62), Size = V(2.35, 2.04, 2.14), Card = rgb(200, 70, 60), Pants = rgb(70, 90, 60), Accent = rgb(236, 204, 160) },
	{ Name = "Robot", Head = "Robot", Color = rgb(176, 192, 208), Size = V(2.35, 2.04, 2.14), Card = rgb(110, 110, 170), Pants = rgb(60, 66, 80), Accent = rgb(90, 230, 255) },
	{ Name = "Frog", Head = "Frog", Color = rgb(116, 200, 92), Size = V(2.55, 1.79, 2.14), Card = rgb(60, 160, 80), Pants = rgb(80, 60, 50) },
	{ Name = "Bunny", Head = "Bunny", Color = rgb(246, 240, 234), Size = V(2.24, 2.04, 2.10), Card = rgb(230, 120, 170), Pants = rgb(90, 120, 170), Accent = rgb(255, 160, 190) },
	{ Name = "Pumpkin", Head = "Pumpkin", Color = rgb(246, 140, 40), Size = V(2.49, 2.04, 2.29), Card = rgb(130, 80, 160), Pants = rgb(60, 50, 70) },
	{ Name = "Sock Hat", Head = "Sock", Color = rgb(124, 82, 56), Size = V(2.24, 2.10, 2.14), Card = rgb(200, 170, 50), Pants = PANTS, Accent = rgb(60, 170, 160), Hair = rgb(30, 22, 20) },
}

function Movers.Get(i: number?)
	return Movers.Styles[math.clamp(math.floor(i or 1), 1, #Movers.Styles)]
end

----------------------------------------------------------------------------------------
-- Costume builder

type Ctx = { Parent: Instance, Weld: boolean }

local Ball = "Ball"
local Cyl = "Cyl"

local function piece(ctx: Ctx, anchor: BasePart, size: Vector3, offset: CFrame, color: Color3, shape: string?, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = "Costume"
	p.Size = size
	if shape == Ball then
		Shapes.Ball(p)
	elseif shape == Cyl then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = anchor.CFrame * offset
	if ctx.Weld then
		local w = Instance.new("Weld")
		w.Part0 = anchor
		w.Part1 = p
		w.C0 = offset
		w.Parent = p
	else
		p.Anchored = true
	end
	p.Parent = ctx.Parent
	return p
end

-- A box with rounded edges: three crossed blocks, edge cylinders and corner balls
-- (full), or only the four vertical edges rounded (cheaper, for small pieces).
local function roundBox(ctx: Ctx, anchor: BasePart, size: Vector3, offset: CFrame, color: Color3, r: number, material: Enum.Material?, full: boolean?): Part
	local x, y, z = size.X, size.Y, size.Z
	r = math.min(r, x / 2 - 0.01, y / 2 - 0.01, z / 2 - 0.01)
	local d = r * 2
	local hx, hy, hz = x / 2 - r, y / 2 - r, z / 2 - r
	local main
	if full then
		main = piece(ctx, anchor, V(x - d, y - d, z), offset, color, nil, material)
		piece(ctx, anchor, V(x, y - d, z - d), offset, color, nil, material)
		piece(ctx, anchor, V(x - d, y, z - d), offset, color, nil, material)
		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				piece(ctx, anchor, V(x - d, d, d), offset * CF(0, a * hy, b * hz), color, Cyl, material)
				piece(ctx, anchor, V(y - d, d, d), offset * CF(a * hx, 0, b * hz) * Angles(0, 0, rad(90)), color, Cyl, material)
				piece(ctx, anchor, V(z - d, d, d), offset * CF(a * hx, b * hy, 0) * Angles(0, rad(90), 0), color, Cyl, material)
				for _, c in { -1, 1 } do
					piece(ctx, anchor, V(d, d, d), offset * CF(a * hx, b * hy, c * hz), color, Ball, material)
				end
			end
		end
	else
		main = piece(ctx, anchor, V(x - d, y, z), offset, color, nil, material)
		piece(ctx, anchor, V(x, y, z - d), offset, color, nil, material)
		for _, a in { -1, 1 } do
			for _, b in { -1, 1 } do
				piece(ctx, anchor, V(y, d, d), offset * CF(a * hx, 0, b * hz) * Angles(0, 0, rad(90)), color, Cyl, material)
			end
		end
	end
	return main
end

-- Simple face on the head's front (-Z): dot eyes with a glint, brows, a small grin,
-- blush. `o` tweaks: EyeY, Spread, Brows, BrowColor, Mouth, MouthY, Cheeks.
local function face(ctx: Ctx, head: BasePart, HO: CFrame, size: Vector3, skin: Color3, o: any)
	local fz = -size.Z / 2
	local ey = o.EyeY or 0.08
	local spread = o.Spread or 0.42
	for _, sx in { -1, 1 } do
		piece(ctx, head, V(0.26, 0.4, 0.08), HO * CF(sx * spread, ey, fz - 0.02), INK, Ball)
		piece(ctx, head, V(0.09, 0.11, 0.04), HO * CF(sx * spread + 0.04, ey + 0.09, fz - 0.06), Color3.new(1, 1, 1), Ball)
		if o.Brows ~= false then
			piece(ctx, head, V(0.34, 0.08, 0.05), HO * CF(sx * spread, ey + 0.38, fz - 0.01) * Angles(0, 0, rad(-sx * 8)), o.BrowColor or INK)
		end
		if o.Cheeks ~= false then
			piece(ctx, head, V(0.32, 0.17, 0.05), HO * CF(sx * (spread + 0.34), ey - 0.3, fz - 0.01), skin:Lerp(rgb(255, 110, 120), 0.4), Ball)
		end
	end
	if o.Mouth ~= false then
		local my = ey - 0.42 + (o.MouthY or 0)
		piece(ctx, head, V(0.5, 0.26, 0.06), HO * CF(0, my, fz - 0.01), rgb(130, 40, 46), Ball)
		piece(ctx, head, V(0.24, 0.1, 0.06), HO * CF(0, my - 0.06, fz - 0.025), rgb(240, 110, 120), Ball)
		-- covers the top half of the oval so it reads as a grin
		piece(ctx, head, V(0.58, 0.14, 0.07), HO * CF(0, my + 0.08, fz - 0.015), skin)
	end
end

local function buildHead(ctx: Ctx, head: BasePart, style: any)
	local HO = CF(0, 0.74, 0)
	local s = style.Size :: Vector3
	local x, y, z = s.X, s.Y, s.Z
	local col = style.Color :: Color3
	local fz = -z / 2
	local kind = style.Head
	local radius = kind == "Box" and 0.07 or (kind == "Pumpkin" and 0.5 or 0.36)
	local material = kind == "Box" and Enum.Material.Cardboard or nil
	local h = roundBox(ctx, head, s, HO, col, radius, material, true)
	h.Name = "BigHead"

	if kind == "Box" then
		local tape = rgb(236, 206, 150)
		piece(ctx, head, V(0.46, 0.04, z + 0.02), HO * CF(0, y / 2 + 0.005, 0), tape)
		piece(ctx, head, V(0.46, 0.34, 0.04), HO * CF(0, y / 2 - 0.17, fz - 0.005), tape)
		piece(ctx, head, V(0.46, 0.34, 0.04), HO * CF(0, y / 2 - 0.17, -fz + 0.005), tape)
		for _, sz in { -1, 1 } do
			piece(ctx, head, V(x * 0.94, 0.05, z * 0.42), HO * CF(0, y / 2, sz * z / 2) * Angles(rad(sz * -40), 0, 0) * CF(0, 0, sz * z * 0.21), col:Lerp(rgb(120, 80, 40), 0.15), nil, Enum.Material.Cardboard)
		end
		-- a printed "this way up" arrow on one side
		piece(ctx, head, V(0.05, 0.5, 0.14), HO * CF(x / 2 + 0.01, 0, 0), rgb(120, 70, 40))
		piece(ctx, head, V(0.05, 0.22, 0.22), HO * CF(x / 2 + 0.01, 0.28, 0) * Angles(rad(45), 0, 0), rgb(120, 70, 40))
		face(ctx, head, HO, s, col, {})
	elseif kind == "Cap" then
		local cap = style.Accent :: Color3
		roundBox(ctx, head, V(x + 0.12, 0.62, z + 0.12), HO * CF(0, y / 2 - 0.12, 0.02), cap, 0.3, Enum.Material.Fabric, true)
		piece(ctx, head, V(x * 0.78, 0.1, 0.8), HO * CF(0, y / 2 - 0.4, fz - 0.32) * Angles(rad(-6), 0, 0), cap:Lerp(Color3.new(0, 0, 0), 0.12), nil, Enum.Material.Fabric)
		piece(ctx, head, V(0.3, 0.3, 0.3), HO * CF(0, y / 2 + 0.22, 0), cap:Lerp(Color3.new(1, 1, 1), 0.3), Ball)
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.08, 0.55, 0.7), HO * CF(sx * (x / 2 + 0.02), 0.25, 0.2), style.Hair)
		end
		piece(ctx, head, V(x * 0.86, 0.75, 0.08), HO * CF(0, 0.2, -fz + 0.02), style.Hair)
		face(ctx, head, HO, s, col, { EyeY = 0.02 })
	elseif kind == "Bear" then
		local light = style.Accent :: Color3
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.78, 0.78, 0.42), HO * CF(sx * 0.78, y / 2 + 0.12, 0.25), col, Ball)
			piece(ctx, head, V(0.44, 0.44, 0.1), HO * CF(sx * 0.78, y / 2 + 0.1, 0.03), light, Ball)
		end
		piece(ctx, head, V(1.1, 0.72, 0.4), HO * CF(0, -0.4, fz - 0.06), light, Ball)
		piece(ctx, head, V(0.38, 0.24, 0.16), HO * CF(0, -0.22, fz - 0.24), INK, Ball)
		piece(ctx, head, V(0.06, 0.18, 0.04), HO * CF(0, -0.4, fz - 0.26), INK)
		face(ctx, head, HO, s, col, { EyeY = 0.25, Mouth = false, Cheeks = false, BrowColor = rgb(80, 50, 30) })
	elseif kind == "Robot" then
		local glow = style.Accent :: Color3
		roundBox(ctx, head, V(x * 0.82, 0.86, 0.14), HO * CF(0, 0.12, fz), rgb(36, 44, 64), 0.12, nil, false)
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.34, 0.34, 0.06), HO * CF(sx * 0.42, 0.2, fz - 0.08), glow, nil, Enum.Material.Neon)
			piece(ctx, head, V(0.22, 0.6, 0.6), HO * CF(sx * (x / 2 + 0.08), 0, 0), col:Lerp(INK, 0.35), Cyl)
		end
		piece(ctx, head, V(0.52, 0.09, 0.05), HO * CF(0, -0.12, fz - 0.08), glow, nil, Enum.Material.Neon)
		for i = -1, 1 do
			piece(ctx, head, V(0.42, 0.06, 0.04), HO * CF(0, -0.55 + i * 0.13, fz - 0.01), col:Lerp(INK, 0.4))
		end
		piece(ctx, head, V(0.55, 0.1, 0.1), HO * CF(0, y / 2 + 0.27, 0) * Angles(0, 0, rad(90)), col:Lerp(INK, 0.3), Cyl)
		piece(ctx, head, V(0.3, 0.3, 0.3), HO * CF(0, y / 2 + 0.6, 0), rgb(255, 80, 70), Ball, Enum.Material.Neon)
	elseif kind == "Frog" then
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.82, 0.82, 0.82), HO * CF(sx * 0.62, y / 2 + 0.12, fz + 0.45), col, Ball)
			piece(ctx, head, V(0.56, 0.56, 0.2), HO * CF(sx * 0.62, y / 2 + 0.16, fz + 0.06), Color3.new(1, 1, 1), Ball)
			piece(ctx, head, V(0.24, 0.32, 0.08), HO * CF(sx * 0.6, y / 2 + 0.14, fz - 0.05), INK, Ball)
			piece(ctx, head, V(0.34, 0.17, 0.05), HO * CF(sx * 0.85, -0.18, fz - 0.01), rgb(250, 140, 140), Ball)
		end
		piece(ctx, head, V(1.3, 0.08, 0.05), HO * CF(0, -0.28, fz - 0.01), INK)
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.2, 0.08, 0.05), HO * CF(sx * 0.7, -0.22, fz - 0.01) * Angles(0, 0, rad(sx * 35)), INK)
		end
	elseif kind == "Bunny" then
		local pink = style.Accent :: Color3
		for _, sx in { -1, 1 } do
			local ear = HO * CF(sx * 0.5, y / 2 + 0.68, 0.15) * Angles(0, 0, rad(-sx * 9))
			roundBox(ctx, head, V(0.48, 1.55, 0.32), ear, col, 0.2, nil, false)
			piece(ctx, head, V(0.26, 1.1, 0.05), ear * CF(0, -0.05, -0.17), pink)
		end
		piece(ctx, head, V(0.3, 0.2, 0.12), HO * CF(0, -0.15, fz - 0.05), pink, Ball)
		piece(ctx, head, V(0.24, 0.18, 0.05), HO * CF(0, -0.5, fz - 0.03), Color3.new(1, 1, 1))
		face(ctx, head, HO, s, col, { EyeY = 0.18, MouthY = 0.03 })
	elseif kind == "Pumpkin" then
		local groove = col:Lerp(rgb(160, 70, 20), 0.5)
		for _, gx in { -0.62, 0, 0.62 } do
			piece(ctx, head, V(0.09, 0.04, z * 0.8), HO * CF(gx, y / 2 + 0.005, 0), groove)
			piece(ctx, head, V(0.09, y * 0.7, 0.04), HO * CF(gx, 0, -fz + 0.005), groove)
		end
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.04, y * 0.7, 0.09), HO * CF(sx * (x / 2 + 0.005), 0, 0), groove)
		end
		piece(ctx, head, V(0.5, 0.3, 0.3), HO * CF(0.05, y / 2 + 0.2, 0) * Angles(0, 0, rad(80)), rgb(96, 120, 50), Cyl)
		piece(ctx, head, V(0.55, 0.05, 0.32), HO * CF(0.38, y / 2 + 0.06, 0.1) * Angles(0, rad(20), rad(-12)), rgb(90, 170, 70))
		local carve = rgb(70, 30, 10)
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.34, 0.34, 0.05), HO * CF(sx * 0.48, 0.18, fz - 0.01) * Angles(0, 0, rad(45)), carve)
		end
		piece(ctx, head, V(1.15, 0.28, 0.05), HO * CF(0, -0.42, fz - 0.01), carve)
		for _, tx in { -0.22, 0.22 } do
			piece(ctx, head, V(0.18, 0.13, 0.05), HO * CF(tx, -0.35, fz - 0.03), col)
		end
	elseif kind == "Sock" then
		local a = style.Accent :: Color3
		local b = rgb(250, 244, 230)
		roundBox(ctx, head, V(x + 0.14, 0.45, z + 0.14), HO * CF(0, y / 2 - 0.2, 0), b, 0.22, Enum.Material.Fabric, true)
		roundBox(ctx, head, V(x * 0.86, 0.5, z * 0.86), HO * CF(0, y / 2 + 0.22, 0.08), a, 0.3, Enum.Material.Fabric, true)
		roundBox(ctx, head, V(x * 0.62, 0.42, z * 0.62), HO * CF(0, y / 2 + 0.52, 0.42) * Angles(rad(-25), 0, 0), b, 0.2, Enum.Material.Fabric, false)
		roundBox(ctx, head, V(x * 0.42, 0.38, z * 0.42), HO * CF(0, y / 2 + 0.66, 0.88) * Angles(rad(-55), 0, 0), a, 0.14, Enum.Material.Fabric, false)
		piece(ctx, head, V(0.55, 0.55, 0.55), HO * CF(0, y / 2 + 0.7, 1.28), b, Ball, Enum.Material.Fabric)
		for _, sx in { -1, 1 } do
			piece(ctx, head, V(0.08, 0.4, 0.6), HO * CF(sx * (x / 2 + 0.02), 0.2, 0.25), style.Hair)
		end
		face(ctx, head, HO, s, col, { EyeY = 0.0, BrowColor = style.Hair })
	end
	-- neck
	local neck = (kind == "Robot" and col:Lerp(INK, 0.4)) or ((kind == "Box" or kind == "Pumpkin") and rgb(236, 190, 150)) or col
	piece(ctx, head, V(0.5, 0.75, 0.75), CF(0, -0.45, 0) * Angles(0, 0, rad(90)), neck, Cyl)
end

local function numberBadge(ctx: Ctx, torso: BasePart, offset: CFrame, faceId: Enum.NormalId, slot: number)
	local badge = piece(ctx, torso, V(0.66, 0.66, 0.06), offset, Color3.new(1, 1, 1))
	badge.Name = "Badge"
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BadgeGui"
	gui.Face = faceId
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 80
	gui.Parent = badge
	local label = Instance.new("TextLabel")
	label.Name = "Number"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(40, 40, 50)
	label.Text = slot > 0 and tostring(slot) or ""
	label.Parent = gui
end

-- Dresses the anchors (R15 part names -> parts) in style `styleIndex`. With `weld` the
-- pieces are welded to the anchors (a live character); otherwise they're anchored.
function Movers.Build(parent: Instance, parts: { [string]: BasePart }, styleIndex: number, shirt: Color3, slot: number, weld: boolean)
	local ctx: Ctx = { Parent = parent, Weld = weld }
	local style = Movers.Get(styleIndex)
	local pants = style.Pants or PANTS
	local head = parts.Head
	local upper = parts.UpperTorso
	local lower = parts.LowerTorso
	if head then
		buildHead(ctx, head, style)
	end
	if upper then
		roundBox(ctx, upper, V(1.85, 1.42, 1.35), CF(0, -0.1, 0), shirt, 0.36, nil, true)
		roundBox(ctx, upper, V(1.2, 0.18, 1.0), CF(0, 0.64, 0), shirt:Lerp(Color3.new(1, 1, 1), 0.3), 0.1, nil, false) -- collar
		if slot > 0 and weld then -- SurfaceGuis don't draw inside ViewportFrames
			numberBadge(ctx, upper, CF(0, -0.05, -0.68), Enum.NormalId.Front, slot)
			numberBadge(ctx, upper, CF(0, -0.05, 0.68), Enum.NormalId.Back, slot)
		end
	end
	if lower then
		roundBox(ctx, lower, V(1.72, 0.9, 1.28), CF(0, -0.12, 0), pants, 0.28, nil, false)
		piece(ctx, lower, V(1.76, 0.14, 1.32), CF(0, 0.26, 0), pants:Lerp(INK, 0.35))
	end
	for _, side in { "Left", "Right" } do
		local ua = parts[side .. "UpperArm"]
		local la = parts[side .. "LowerArm"]
		local hand = parts[side .. "Hand"]
		local ul = parts[side .. "UpperLeg"]
		local ll = parts[side .. "LowerLeg"]
		local foot = parts[side .. "Foot"]
		local sx = side == "Left" and 1 or -1 -- towards the body centre
		if ua then
			roundBox(ctx, ua, V(0.7, 0.72, 0.7), CF(sx * 0.12, 0.1, 0), shirt, 0.22, nil, false)
			piece(ctx, ua, V(0.78, 0.78, 0.78), CF(sx * 0.12, 0.32, 0), shirt, Ball)
		end
		if la then
			roundBox(ctx, la, V(0.64, 0.66, 0.64), CF(sx * 0.12, 0.1, 0), GLOVE, 0.2, nil, false)
			roundBox(ctx, la, V(0.8, 0.24, 0.8), CF(sx * 0.12, 0.36, 0), CUFF, 0.24, nil, false)
		end
		if hand then
			local mitt = piece(ctx, hand, V(1.0, 1.0, 0.92), CF(sx * 0.12, 0.12, 0), GLOVE, Ball)
			mitt.Name = side .. "Mitt"
			piece(ctx, hand, V(0.36, 0.52, 0.36), CF(sx * 0.02, 0.3, -0.42) * Angles(rad(25), 0, 0), GLOVE, Ball)
		end
		if ul then
			piece(ctx, ul, V(0.62, ul.Size.Y + 0.15, 0.62), CF(sx * 0.05, 0, 0), pants)
		end
		if ll then
			piece(ctx, ll, V(0.54, ll.Size.Y + 0.1, 0.54), CF(sx * 0.05, 0, 0), pants:Lerp(INK, 0.2))
		end
		if foot then
			roundBox(ctx, foot, V(0.78, 0.5, 1.05), CF(sx * 0.05, 0.12, -0.14), SHOE, 0.2, nil, true)
			piece(ctx, foot, V(0.82, 0.12, 1.08), CF(sx * 0.05, -0.1, -0.14), SOLE)
		end
	end
end

----------------------------------------------------------------------------------------
-- Static preview model (for ViewportFrames): blocky R15 proportions at the movers' scale.

local RIG = {
	{ "LowerTorso", V(2, 0.4, 1), 2.2, 0 },
	{ "UpperTorso", V(2, 1.6, 1), 3.2, 0 },
	{ "LeftUpperArm", V(1, 1, 1), 3.5, -1.5 },
	{ "LeftLowerArm", V(1, 0.9, 1), 2.55, -1.5 },
	{ "LeftHand", V(1, 0.3, 1), 1.95, -1.5 },
	{ "RightUpperArm", V(1, 1, 1), 3.5, 1.5 },
	{ "RightLowerArm", V(1, 0.9, 1), 2.55, 1.5 },
	{ "RightHand", V(1, 0.3, 1), 1.95, 1.5 },
	{ "LeftUpperLeg", V(1, 0.85, 1), 1.575, -0.5 },
	{ "LeftLowerLeg", V(1, 0.85, 1), 0.725, -0.5 },
	{ "LeftFoot", V(1, 0.3, 1), 0.15, -0.5 },
	{ "RightUpperLeg", V(1, 0.85, 1), 1.575, 0.5 },
	{ "RightLowerLeg", V(1, 0.85, 1), 0.725, 0.5 },
	{ "RightFoot", V(1, 0.3, 1), 0.15, 0.5 },
}

-- A dressed, anchored mover standing on the origin and facing -Z.
function Movers.PreviewModel(styleIndex: number, shirt: Color3, slot: number, heightScale: number): Model
	local hs = heightScale
	local model = Instance.new("Model")
	model.Name = "MoverPreview"
	local parts: { [string]: BasePart } = {}
	local function anchor(name: string, size: Vector3, cf: CFrame)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Anchored = true
		p.Transparency = 1
		parts[name] = p
	end
	for _, def in RIG do
		local size = def[2] :: Vector3
		anchor(def[1] :: string, V(size.X, size.Y * hs, size.Z), CF(def[4] :: number, (def[3] :: number) * hs, 0))
	end
	anchor("Head", V(1.2, 1.2, 1.2), CF(0, 4.0 * hs + 0.6, 0))
	Movers.Build(model, parts, styleIndex, shirt, slot, false)
	return model
end

return Movers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net.luau
	The three remotes. The server creates them; clients wait for them.
	  Action  (client -> server)  Action:FireServer(name, a?, b?)
	  Fx      (server -> clients) Fx:FireAllClients(kind, data) / FireClient
	  Profile (client -> server)  Profile:InvokeServer() -> the player's saved profile
	Shared game state lives in attributes on ReplicatedStorage.GameState.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local function get(className: string, name: string): Instance
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if RunService:IsServer() then
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		local r = (folder :: Folder):FindFirstChild(name)
		if not r then
			r = Instance.new(className)
			r.Name = name
			r.Parent = folder
		end
		return r :: Instance
	end
	folder = ReplicatedStorage:WaitForChild("Remotes")
	return (folder :: Folder):WaitForChild(name)
end

Net.Action = get("RemoteEvent", "Action") :: RemoteEvent
Net.Fx = get("RemoteEvent", "Fx") :: RemoteEvent
Net.Profile = get("RemoteFunction", "Profile") :: RemoteFunction

function Net.State(): Folder
	if RunService:IsServer() then
		local s = ReplicatedStorage:FindFirstChild("GameState")
		if not s then
			s = Instance.new("Folder")
			s.Name = "GameState"
			s.Parent = ReplicatedStorage
		end
		return s :: Folder
	end
	return ReplicatedStorage:WaitForChild("GameState") :: Folder
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Shapes</string>
          <string name="Source"><![CDATA[--[[
	Shapes.luau
	Roblox draws a Ball part as a perfect sphere sized by its smallest side. For the
	oval shapes the art needs (heads, eyes, cushions, tree crowns), a non-uniform ball is
	turned into a block with a Sphere SpecialMesh, which stretches to the full size.
	Only use it on parts whose collision shape doesn't matter (or where a box is fine).
]]

local Shapes = {}

function Shapes.Ball(p: BasePart)
	local s = p.Size
	if math.abs(s.X - s.Y) < 0.01 and math.abs(s.Y - s.Z) < 0.01 then
		(p :: Part).Shape = Enum.PartType.Ball
		return
	end
	(p :: Part).Shape = Enum.PartType.Block
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
end

return Shapes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Server entry point: registers the systems, routes client actions, starts the lobby.
	Every client request is validated here or in the system it reaches; the client only
	ever asks, the server decides.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local S = require(script.Services)

S.Fx = require(script.FxService)
S.Data = require(script.DataService)
S.Players = require(script.PlayerService)
S.Items = require(script.ItemService)
S.Carry = require(script.CarrySystem)
S.Truck = require(script.TruckService)
S.Breakables = require(script.Breakables)
S.Hazards = require(script.Hazards)
S.Jobs = require(script.JobManager)

Net.State():SetAttribute("Phase", "Lobby")
Net.State():SetAttribute("Version", Config.Version)

S.Data.Init()
S.Players.Init()
S.Jobs.Init()

-- simple flood protection: at most 25 actions per second per player
local budget: { [Player]: { number } } = {}
local function allowed(player: Player): boolean
	local b = budget[player]
	local t = os.clock()
	if not b or t - b[1] > 1 then
		budget[player] = { t, 1 }
		return true
	end
	b[2] += 1
	return b[2] <= 25
end
Players.PlayerRemoving:Connect(function(player)
	budget[player] = nil
end)

local function isMover(player: Player): boolean
	return S.Players.Slot(player) > 0
end

local function isLeader(player: Player): boolean
	return S.Players.IsLeader(player)
end

local handlers: { [string]: (Player, any, any) -> () } = {
	Play = function(player)
		S.Players.Join(player)
	end,
	Grab = function(player, id)
		if isMover(player) then
			S.Carry.Grab(player, id)
		end
	end,
	Release = function(player)
		if isMover(player) then
			S.Carry.ReleasePlayer(player, "release")
		end
	end,
	Throw = function(player)
		if isMover(player) then
			S.Carry.Throw(player)
		end
	end,
	Slap = function(player)
		if isMover(player) then
			S.Carry.Slap(player)
		end
	end,
	SetStyle = function(player, style)
		S.Players.SetStyle(player, style)
	end,
	SelectJob = function(player, id, assists)
		if isLeader(player) and S.Jobs.Phase() == "Lobby" then
			S.Jobs.SelectJob(id, assists)
		end
	end,
	StartJob = function(player)
		if isLeader(player) and S.Jobs.Phase() == "Briefing" then
			S.Jobs.StartCountdown()
		end
	end,
	Board = function(player)
		local phase = S.Jobs.Phase()
		if isLeader(player) and (phase == "Briefing" or phase == "Results" or phase == "Playing") then
			S.Jobs.GoLobby()
		end
	end,
	Pause = function(player)
		if isMover(player) then
			S.Jobs.SetPaused(true, player)
		end
	end,
	Resume = function(player)
		if isMover(player) then
			S.Jobs.SetPaused(false, player)
		end
	end,
	Restart = function(player)
		local phase = S.Jobs.Phase()
		if isLeader(player) and (phase == "Playing" or phase == "Results") then
			S.Jobs.Restart()
		end
	end,
	Replay = function(player)
		if isLeader(player) and S.Jobs.Phase() == "Results" then
			S.Jobs.StartCountdown()
		end
	end,
	NextJob = function(player)
		if isLeader(player) then
			S.Jobs.NextJob()
		end
	end,
	SaveSettings = function(player, settings)
		local profile = S.Data.Get(player)
		if profile and type(settings) == "table" then
			local clean = S.Data.Sanitize({ Version = profile.Version, Settings = settings }).Settings
			profile.Settings = clean
			S.Data.MarkDirty(player)
		end
	end,
	SaveBindings = function(player, bindings)
		local profile = S.Data.Get(player)
		if profile and type(bindings) == "table" then
			profile.Bindings = S.Data.Sanitize({ Version = profile.Version, Bindings = bindings }).Bindings
			S.Data.MarkDirty(player)
		end
	end,
	TutorialDone = function(player)
		local profile = S.Data.Get(player)
		if profile then
			profile.TutorialSeen = true
			S.Data.MarkDirty(player)
		end
	end,
}

Net.Action.OnServerEvent:Connect(function(player, name, a, b)
	if type(name) ~= "string" or not allowed(player) then
		return
	end
	local h = handlers[name]
	if h then
		h(player, a, b)
	end
end)

Net.Profile.OnServerInvoke = function(player)
	local t0 = os.clock()
	while not S.Data.Get(player) and os.clock() - t0 < 10 do
		task.wait(0.1)
	end
	return S.Data.Get(player), S.Data.Status(player)
end

Workspace:SetAttribute("ServerStarted", true)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Breakables</string>
          <string name="Source"><![CDATA[--[[
	Breakables.luau
	Designated shortcuts: breakable glass (a hard furniture hit or a slap) and boarded
	doors (several slaps or a very hard hit). Breaking removes the blocking collider and
	hides the linked decoration; clients play shards / splinters locally (short-lived, never
	physical debris, so nothing can block a route). A level rebuild restores them.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local S = require(script.Parent.Services)

local Breakables = {}

local function hideLinked(part: BasePart)
	for _, v in part:GetChildren() do
		if v:IsA("ObjectValue") and v.Name == "Linked" and v.Value and v.Value:IsA("BasePart") then
			(v.Value :: BasePart).Transparency = 1
		end
	end
end

function Breakables.Break(part: BasePart, from: Vector3?)
	if part:GetAttribute("Broken") then
		return
	end
	part:SetAttribute("Broken", true)
	local kind = part:GetAttribute("Breakable")
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	hideLinked(part)
	S.Fx.All("Break", { Kind = kind, CFrame = part.CFrame, Size = part.Size, From = from })
end

-- A hit on a breakable part: "Slap" from a mover, or "Impact" from furniture at speed.
function Breakables.Hit(part: BasePart, how: string, from: Vector3?, speed: number?)
	if part:GetAttribute("Broken") or not S.World.Active or S.World.Paused then
		return
	end
	local kind = part:GetAttribute("Breakable")
	if kind == "Glass" then
		if how == "Slap" or (speed or 0) >= Config.Breakable.ImpactSpeed then
			Breakables.Break(part, from)
		end
	elseif kind == "Boards" then
		if how == "Impact" then
			if (speed or 0) >= Config.Breakable.DoorImpactSpeed then
				Breakables.Break(part, from)
			end
			return
		end
		local hits = ((part:GetAttribute("Hits") :: number?) or 0) + 1
		part:SetAttribute("Hits", hits)
		if hits >= Config.Breakable.DoorSlaps then
			Breakables.Break(part, from)
		else
			S.Fx.All("Crack", { CFrame = part.CFrame, Size = part.Size, Hits = hits })
		end
	end
end

return Breakables
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CarrySystem</string>
          <string name="Source"><![CDATA[--[[
	CarrySystem.luau
	Physical grabbing, carrying, cooperative handling, throwing and slapping.

	Carrying is made of real constraints, never teleporting:
	  * per holder: a Grip attachment on the item at the point the mover grabbed (the
	    nearest point of the item's box, so a sofa can be grabbed by its near end), a Carry
	    attachment in front of the mover, an AlignPosition pulling grip -> carry with a
	    limited force, and (once the item is in the hands) a RopeConstraint so a stuck item
	    holds its mover back instead of the mover walking away from it.
	  * per held item: an AlignOrientation that only keeps the item upright (yaw is free,
	    so it swings and catches on door frames) and a weak AngularVelocity damper.
	Lift force per holder is a fraction of the item's weight (Config.Carry.LiftPerHolder):
	one mover can't fully lift a heavy item (it drags), two can. Positions of the two grips
	decide the orientation, so walking around each other turns a sofa.
	In solo play (one mover in the job) heavy items get extra lift so every job can be
	finished alone; they stay big, slow and awkward.

	The first holder simulates the item (network owner) so carrying feels responsive.
	Throws switch the item to server simulation and apply a launch velocity.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local S = require(script.Parent.Services)

local CarrySystem = {}

type Hold = {
	Player: Player,
	Grip: Attachment,
	Carry: Attachment,
	Align: AlignPosition,
	Rope: RopeConstraint?,
	NoCollide: { NoCollisionConstraint },
	Since: number,
}

type ItemHold = {
	Model: Model,
	Body: BasePart,
	Holds: { [Player]: Hold },
	Upright: AlignOrientation?,
	Spin: AngularVelocity?,
	UpAttachment: Attachment?,
	Primed: { [Player]: number },
}

local held: { [Model]: ItemHold } = {}
local holding: { [Player]: Model } = {}
local lastThrow: { [Player]: number } = {}
local lastSlap: { [Player]: number } = {}
local lastRelease: { [Player]: number } = {}
local busy: { [Player]: boolean } = {} -- in a throw wind-up

local function simNow(): number
	return S.World.SimTime
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function bodyOf(model: Model): BasePart?
	return model.PrimaryPart
end

local function countHolders(h: ItemHold): number
	local n = 0
	for _ in h.Holds do
		n += 1
	end
	return n
end

local function classOf(model: Model): string
	return (model:GetAttribute("Class") :: string?) or "Light"
end

local function isSolo(): boolean
	return S.Players.MoverCount() <= 1
end

-- Closest point of an item's collider box to a world position.
function CarrySystem.ClosestPoint(body: BasePart, pos: Vector3): (Vector3, Vector3)
	local half = body.Size / 2
	local lp = body.CFrame:PointToObjectSpace(pos)
	local c = Vector3.new(math.clamp(lp.X, -half.X, half.X), math.clamp(lp.Y, -half.Y, half.Y), math.clamp(lp.Z, -half.Z, half.Z))
	return body.CFrame:PointToWorldSpace(c), c
end

-- How much carrying slows a mover (1 = full speed). Resistance from shared load.
function CarrySystem.SpeedFactor(player: Player): number
	local model = holding[player]
	local h = model and held[model]
	if not h then
		return 1
	end
	local class = classOf(model)
	local supplied = 0
	local solo = isSolo()
	for _ in h.Holds do
		supplied += 1 + (solo and (Config.Carry.SoloBonus[class] or 0) or 0)
	end
	if S.World.Assists.EasyHeavy and class == "Heavy" then
		supplied += 0.6
	end
	local need = Config.Carry.Strength[class] or 1
	local t = math.clamp(supplied / need, 0, 1)
	local m = Config.Movement
	return m.CarrySpeedMin + (m.CarrySpeedMax - m.CarrySpeedMin) * t
end

-- Recomputes every holder's force on an item (depends on holder count, solo, assists).
local function refreshForces(h: ItemHold)
	local class = classOf(h.Model)
	local weight = h.Body.AssemblyMass * Workspace.Gravity
	local lift = Config.Carry.LiftPerHolder[class] or 1
	if isSolo() then
		lift += Config.Carry.SoloBonus[class] or 0
	end
	if S.World.Assists.EasyHeavy and class == "Heavy" then
		lift += 0.5
	end
	for player, hold in h.Holds do
		hold.Align.MaxForce = weight * lift
		S.Players.UpdateSpeed(player)
	end
	h.Model:SetAttribute("Holders", countHolders(h))
end

local function setOwner(body: BasePart, player: Player?)
	if body.Anchored then
		return
	end
	pcall(function()
		if player then
			body:SetNetworkOwner(player)
		else
			body:SetNetworkOwnershipAuto()
		end
	end)
end

local function addUpright(h: ItemHold)
	local body = h.Body
	local mass = body.AssemblyMass
	local up = Instance.new("Attachment")
	up.Name = "UprightAttachment"
	up.Parent = body
	local ao = Instance.new("AlignOrientation")
	ao.Name = "Upright"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = up
	ao.AlignType = Enum.AlignType.PrimaryAxisParallel
	ao.PrimaryAxis = Vector3.yAxis
	up.Axis = Vector3.yAxis
	up.SecondaryAxis = Vector3.xAxis
	ao.MaxTorque = mass * Config.Carry.UprightTorque
	ao.Responsiveness = Config.Carry.UprightResponsiveness
	ao.Parent = body
	local av = Instance.new("AngularVelocity")
	av.Name = "SpinDamper"
	av.Attachment0 = up
	av.AngularVelocity = Vector3.zero
	av.MaxTorque = mass * Config.Carry.SpinDamping
	av.RelativeTo = Enum.ActuatorRelativeTo.World
	av.Parent = body
	h.Upright = ao
	h.Spin = av
	h.UpAttachment = up
end

local function removeUpright(h: ItemHold)
	if h.Upright then
		h.Upright:Destroy()
	end
	if h.Spin then
		h.Spin:Destroy()
	end
	if h.UpAttachment then
		h.UpAttachment:Destroy()
	end
	h.Upright = nil
	h.Spin = nil
	h.UpAttachment = nil
end

local function destroyHold(hold: Hold, keepNoCollide: number?)
	hold.Align:Destroy()
	if hold.Rope then
		hold.Rope:Destroy()
	end
	hold.Grip:Destroy()
	hold.Carry:Destroy()
	if keepNoCollide and keepNoCollide > 0 then
		local list = hold.NoCollide
		task.delay(keepNoCollide, function()
			for _, nc in list do
				nc:Destroy()
			end
		end)
	else
		for _, nc in hold.NoCollide do
			nc:Destroy()
		end
	end
end

-- Detaches one player from whatever they hold. Safe to call any time.
function CarrySystem.ReleasePlayer(player: Player, reason: string?)
	local model = holding[player]
	holding[player] = nil
	busy[player] = nil
	player:SetAttribute("Holding", nil)
	player:SetAttribute("HoldingClass", nil)
	player:SetAttribute("Windup", nil)
	lastRelease[player] = simNow()
	if not model then
		S.Players.UpdateSpeed(player)
		return
	end
	local h = held[model]
	if not h then
		S.Players.UpdateSpeed(player)
		return
	end
	local hold = h.Holds[player]
	if hold then
		h.Holds[player] = nil
		destroyHold(hold, reason == "throw" and 0.3 or 0)
	end
	h.Primed[player] = nil
	model:SetAttribute("Primed", 0)
	local remaining = countHolders(h)
	if remaining == 0 then
		removeUpright(h)
		held[model] = nil
		model:SetAttribute("Holders", 0)
		if reason ~= "throw" then
			setOwner(h.Body, nil)
		end
	else
		-- hand simulation to a remaining holder
		for other in h.Holds do
			setOwner(h.Body, other)
			break
		end
		refreshForces(h)
	end
	S.Players.UpdateSpeed(player)
	if reason == "release" then
		S.Fx.All("Sound", { Name = "Release", Pos = h.Body.Position })
	end
end

-- Detaches every holder from an item (recovery, vanish, throw, level end).
function CarrySystem.ReleaseItem(model: Model, reason: string?)
	local h = held[model]
	if not h then
		return
	end
	local players = {}
	for p in h.Holds do
		table.insert(players, p)
	end
	for _, p in players do
		CarrySystem.ReleasePlayer(p, reason)
	end
end

function CarrySystem.ReleaseAll()
	for player in holding do
		CarrySystem.ReleasePlayer(player, "reset")
	end
	for model, h in held do
		removeUpright(h)
		held[model] = nil
	end
end

-- After a pause (anchoring drops network ownership) give held items back to a holder.
function CarrySystem.RefreshOwners()
	for _, h in held do
		for p in h.Holds do
			setOwner(h.Body, p)
			break
		end
	end
end

-- Mover count changed (solo <-> group): recompute every held item's forces.
function CarrySystem.RefreshAll()
	for _, h in held do
		refreshForces(h)
	end
end

function CarrySystem.Holding(player: Player): Model?
	return holding[player]
end

function CarrySystem.IsHeld(model: Model): boolean
	local h = held[model]
	return h ~= nil and next(h.Holds) ~= nil
end

local function canAct(player: Player): boolean
	if S.World.Paused or not S.World.Active then
		return false
	end
	if S.Jobs.Phase() ~= "Playing" and S.Jobs.Phase() ~= "Lobby" then
		return false
	end
	if S.Players.IsStunned(player) or player:GetAttribute("Recovering") then
		return false
	end
	return S.Players.Root(player) ~= nil
end

local function itemFromId(id: any): Model?
	local level = S.World.Level
	if type(id) ~= "string" or not level then
		return nil
	end
	local m = level.Items[id]
	if m and m.Parent and not m:GetAttribute("Recovering") and not m:GetAttribute("Vanished") then
		return m
	end
	return nil
end

-- Grab request from a client: validates reach, line of sight and free grip space.
function CarrySystem.Grab(player: Player, itemId: any)
	if holding[player] then
		CarrySystem.ReleasePlayer(player, "release")
		return
	end
	if not canAct(player) then
		return
	end
	if lastRelease[player] and simNow() - lastRelease[player] < Config.Carry.DropProtect then
		return
	end
	local model = itemFromId(itemId)
	local root = S.Players.Root(player)
	if not model or not root then
		return
	end
	local body = bodyOf(model)
	if not body or body.Anchored then
		return
	end
	local h = held[model]
	local max = model:GetAttribute("MaxHolders") or 1
	if h and countHolders(h) >= max then
		S.Fx.Toast(player, "No room to grab that")
		return
	end

	local point, localPoint = CarrySystem.ClosestPoint(body, root.Position)
	local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
	if flat.Magnitude > Config.Carry.Reach + Config.Carry.ServerReachSlack then
		return
	end

	-- line of sight: nothing solid between the mover and the grab point
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { model }
	for _, p in S.Players.Movers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local origin = root.Position
	local toPoint = point - origin
	if toPoint.Magnitude > 0.5 then
		local hit = Workspace:Raycast(origin, toPoint.Unit * (toPoint.Magnitude - 0.3), params)
		if hit and hit.Instance.CanCollide and not hit.Instance:GetAttribute("Ground") then
			S.Fx.Toast(player, "Can't reach - something is in the way")
			return
		end
	end

	-- grip height: around the mover's waist, inside the item's box
	local half = body.Size / 2
	local rootLocalY = body.CFrame:PointToObjectSpace(root.Position).Y
	local gy = math.clamp(rootLocalY, -half.Y + math.min(0.6, half.Y * 0.5), half.Y - math.min(0.3, half.Y * 0.3))
	local gripLocal = Vector3.new(localPoint.X, gy, localPoint.Z)

	-- don't let two movers grab the same spot
	if h then
		for _, other in h.Holds do
			if (other.Grip.Position - gripLocal).Magnitude < Config.Carry.GripSpacing then
				S.Fx.Toast(player, "Spot taken - grab the other end")
				return
			end
		end
	end

	if not h then
		h = { Model = model, Body = body, Holds = {}, Primed = {} } :: ItemHold
		held[model] = h
		addUpright(h :: ItemHold)
	end
	local hh = h :: ItemHold

	local grip = Instance.new("Attachment")
	grip.Name = "Grip_" .. player.UserId
	grip.Position = gripLocal
	grip.Parent = body

	local class = classOf(model)
	local liftHeight = class == "Light" and 1.4 or (class == "Medium" and 0.8 or 0.55)
	local gripWorld = body.CFrame:PointToWorldSpace(gripLocal)
	local carryY = math.clamp(gripWorld.Y - root.Position.Y + liftHeight, -2.4, 1.6)
	local carry = Instance.new("Attachment")
	carry.Name = "Carry_" .. model.Name
	carry.Position = Vector3.new(Config.Carry.HoldOffset.X, carryY, Config.Carry.HoldOffset.Z)
	carry.Parent = root

	local align = Instance.new("AlignPosition")
	align.Name = "CarryAlign"
	align.Mode = Enum.PositionAlignmentMode.TwoAttachment
	align.Attachment0 = grip
	align.Attachment1 = carry
	align.ReactionForceEnabled = false
	align.ApplyAtCenterOfMass = false
	align.Responsiveness = Config.Carry.Responsiveness
	align.MaxVelocity = Config.Carry.MaxVelocity
	align.Parent = body

	local noCollide = {}
	for _, d in (player.Character :: Model):GetDescendants() do
		if d:IsA("BasePart") and d.CanCollide then
			local nc = Instance.new("NoCollisionConstraint")
			nc.Part0 = body
			nc.Part1 = d
			nc.Parent = body
			table.insert(noCollide, nc)
		end
	end

	hh.Holds[player] = {
		Player = player,
		Grip = grip,
		Carry = carry,
		Align = align,
		Rope = nil,
		NoCollide = noCollide,
		Since = simNow(),
	}
	holding[player] = model
	player:SetAttribute("Holding", model.Name)
	player:SetAttribute("HoldingClass", class)
	if countHolders(hh) == 1 then
		setOwner(body, player)
	end
	refreshForces(hh)
	S.Fx.All("Grab", { UserId = player.UserId, Item = model.Name, Pos = gripWorld })
end

-- Per-frame upkeep: ropes engage once the item is in the hands, broken holds release.
function CarrySystem.Step()
	for model, h in held do
		if not model.Parent or model:GetAttribute("Recovering") then
			CarrySystem.ReleaseItem(model, "reset")
			continue
		end
		for player, hold in h.Holds do
			local root = S.Players.Root(player)
			if not root or not player.Parent then
				CarrySystem.ReleasePlayer(player, "lost")
				continue
			end
			local d = (hold.Grip.WorldPosition - hold.Carry.WorldPosition).Magnitude
			if not hold.Rope and d < 3.4 then
				local rope = Instance.new("RopeConstraint")
				rope.Name = "CarryRope"
				rope.Attachment0 = hold.Grip
				rope.Attachment1 = hold.Carry
				rope.Length = 3.6
				rope.Restitution = 0
				rope.Visible = false
				rope.Parent = h.Body
				hold.Rope = rope
			elseif d > 11 then
				CarrySystem.ReleasePlayer(player, "lost")
				S.Fx.Toast(player, "Lost your grip!")
			elseif not hold.Rope and simNow() - hold.Since > 2.5 and d > 6 then
				-- never pulled into the hands (wedged): let go rather than strain forever
				CarrySystem.ReleasePlayer(player, "lost")
				S.Fx.Toast(player, "It's stuck - try another angle")
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- Throwing

local function launch(model: Model, direction: Vector3, class: string, strength: number, throwers: { Player })
	local body = bodyOf(model)
	if not body or not model.Parent then
		return
	end
	for _, p in throwers do
		CarrySystem.ReleasePlayer(p, "throw")
		lastThrow[p] = simNow()
	end
	CarrySystem.ReleaseItem(model, "throw")
	pcall(function()
		body:SetNetworkOwner(nil)
	end)
	local v = Config.Throw.Velocity[class] or Config.Throw.Velocity.Light
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	body.AssemblyLinearVelocity = flat * v.Forward * strength + Vector3.new(0, v.Up * strength, 0)
	if class == "Light" then
		body.AssemblyAngularVelocity = Vector3.new(flat.Z, 0, -flat.X) * 6
	end
	model:SetAttribute("Thrown", serverNow())
	local ids = {}
	for _, p in throwers do
		table.insert(ids, p.UserId)
	end
	S.Fx.All("Throw", { Item = model.Name, Pos = body.Position, Coop = #throwers > 1, Throwers = ids })
	task.delay(Config.Throw.ServerOwnSeconds, function()
		if model.Parent and not CarrySystem.IsHeld(model) and not body.Anchored then
			pcall(function()
				body:SetNetworkOwnershipAuto()
			end)
		end
	end)
end

function CarrySystem.Throw(player: Player)
	local model = holding[player]
	if not model or busy[player] or not canAct(player) then
		return
	end
	if lastThrow[player] and simNow() - lastThrow[player] < Config.Throw.Cooldown then
		return
	end
	local h = held[model]
	local root = S.Players.Root(player)
	if not h or not root then
		return
	end
	local class = classOf(model)
	local n = countHolders(h)

	if n == 1 then
		if class == "Heavy" then
			S.Fx.Toast(player, "Too heavy to throw alone - get a partner on the other end!")
			S.Fx.To(player, "Sound", { Name = "Error" })
			return
		end
		busy[player] = true
		player:SetAttribute("Windup", serverNow())
		S.Fx.All("Windup", { UserId = player.UserId, Pos = root.Position })
		task.delay(Config.Throw.Windup, function()
			busy[player] = nil
			player:SetAttribute("Windup", nil)
			if holding[player] ~= model or S.World.Paused then
				return
			end
			local r = S.Players.Root(player)
			if r then
				launch(model, r.CFrame.LookVector, class, 1, { player })
			end
		end)
		return
	end

	-- cooperative throw: every holder presses within the window
	h.Primed[player] = simNow()
	local primed = 0
	for p, t in h.Primed do
		if h.Holds[p] and simNow() - t <= Config.Throw.CoopWindow then
			primed += 1
		end
	end
	model:SetAttribute("Primed", primed)
	model:SetAttribute("PrimedAt", serverNow())
	S.Fx.All("Windup", { UserId = player.UserId, Pos = root.Position, Coop = true })
	if primed >= n then
		local throwers = {}
		local dir = Vector3.zero
		for p in h.Holds do
			table.insert(throwers, p)
			local r = S.Players.Root(p)
			if r then
				dir += r.CFrame.LookVector
			end
			busy[p] = true
			p:SetAttribute("Windup", serverNow())
		end
		if Vector3.new(dir.X, 0, dir.Z).Magnitude < 0.3 then
			dir = root.CFrame.LookVector -- facing each other: the last presser decides
		end
		local strength = class == "Heavy" and 1 or 1.15
		task.delay(Config.Throw.CoopWindup, function()
			for _, p in throwers do
				busy[p] = nil
				p:SetAttribute("Windup", nil)
			end
			if S.World.Paused or not held[model] then
				return
			end
			launch(model, dir, class, strength, throwers)
		end)
	else
		local stamp = h.Primed[player]
		task.delay(Config.Throw.CoopWindow + 0.05, function()
			local hh = held[model]
			if hh and hh.Primed[player] == stamp then
				hh.Primed[player] = nil
				model:SetAttribute("Primed", 0)
				for p in hh.Holds do
					S.Fx.Toast(p, "Throw together! Both press throw at the same time.")
				end
			end
		end)
	end
end

----------------------------------------------------------------------------------------
-- Slapping

function CarrySystem.Slap(player: Player)
	if not canAct(player) or busy[player] then
		return
	end
	if lastSlap[player] and simNow() - lastSlap[player] < Config.Slap.Cooldown then
		return
	end
	lastSlap[player] = simNow()
	local root = S.Players.Root(player)
	if not root then
		return
	end
	player:SetAttribute("SlapAt", serverNow())
	S.Fx.All("Slap", { UserId = player.UserId, Pos = root.Position })
	task.delay(0.1, function()
		local r = S.Players.Root(player)
		if not r or S.World.Paused then
			return
		end
		local cf = r.CFrame * CFrame.new(0, 0, -Config.Slap.Range / 2)
		local size = Vector3.new(Config.Slap.Radius * 2, 6, Config.Slap.Range)
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character :: Model }
		local parts = Workspace:GetPartBoundsInBox(cf, size, params)
		local hitPlayers: { [Player]: boolean } = {}
		local hitItems: { [Model]: boolean } = {}
		local landed = false
		for _, part in parts do
			local char = part:FindFirstAncestorOfClass("Model")
			local other = char and game:GetService("Players"):GetPlayerFromCharacter(char)
			if other and other ~= player and not hitPlayers[other] then
				hitPlayers[other] = true
				local away = (part.Position - r.Position) * Vector3.new(1, 0, 1)
				away = away.Magnitude > 0.01 and away.Unit or r.CFrame.LookVector
				S.Players.Knock(other, away * Config.Slap.PlayerKnock + Vector3.new(0, 12, 0))
				S.Players.Stun(other, Config.Slap.PlayerStun, false)
				landed = true
			elseif part:GetAttribute("Ghost") or (part.Parent and part.Parent:GetAttribute("Ghost")) then
				S.Hazards.StunGhost(part.Parent :: Instance)
				landed = true
			elseif part:GetAttribute("Breakable") then
				S.Breakables.Hit(part, "Slap", r.Position)
				landed = true
			elseif part.Name == "Body" and part.Parent and part.Parent:GetAttribute("ItemId") then
				local m = part.Parent :: Model
				if not hitItems[m] and not CarrySystem.IsHeld(m) and not part.Anchored then
					hitItems[m] = true
					pcall(function()
						part:SetNetworkOwner(nil)
					end)
					local push = Config.Slap.ItemPush / math.max(1, part.AssemblyMass / 8)
					part.AssemblyLinearVelocity += r.CFrame.LookVector * push + Vector3.new(0, push * 0.3, 0)
					task.delay(1, function()
						if part.Parent and not CarrySystem.IsHeld(m) and not part.Anchored then
							pcall(function()
								part:SetNetworkOwnershipAuto()
							end)
						end
					end)
					landed = true
				end
			end
		end
		if landed then
			S.Fx.All("Sound", { Name = "SlapHit", Pos = r.Position + r.CFrame.LookVector * 2 })
		end
	end)
end

return CarrySystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService.luau
	Versioned player profiles in a DataStore: settings, key bindings, unlocked jobs, best
	times and medals. Studio uses a separate store so tests never touch real saves.

	Every loaded value is validated; anything malformed falls back to safe defaults, so a
	bad save can never stop the game from starting. A slower time never overwrites a
	better one. If DataStores are unavailable (e.g. Studio API access off) profiles live in
	memory for the session and the client is told progress isn't being saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Jobs = require(ReplicatedStorage.Shared.Jobs)

local DataService = {}

local VERSION = 1
local STORE_NAME = "MovingOut_Profiles_v1" .. (RunService:IsStudio() and "_Studio" or "")

local store: DataStore? = nil
local profiles: { [Player]: any } = {}
local saving: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local status: { [Player]: string } = {}

local function defaults(): any
	local settings = table.clone(Config.SettingsDefaults)
	return {
		Version = VERSION,
		Settings = settings,
		Bindings = {},
		Style = 1,
		Unlocked = { [Jobs.List[1].Id] = true },
		Best = {},
		Medals = {},
		TutorialSeen = false,
	}
end

local function validNumber(v: any, lo: number, hi: number): boolean
	return type(v) == "number" and v == v and v >= lo and v <= hi
end

-- Returns a clean profile built from defaults plus every valid saved field.
function DataService.Sanitize(raw: any): any
	local p = defaults()
	if type(raw) ~= "table" or raw.Version ~= VERSION then
		return p
	end
	if type(raw.Settings) == "table" then
		for key, default in Config.SettingsDefaults do
			local v = raw.Settings[key]
			if type(v) == type(default) then
				if type(v) == "number" then
					if validNumber(v, 0, 2) then
						p.Settings[key] = v
					end
				elseif type(v) == "string" then
					if key == "Quality" and (v == "High" or v == "Low") then
						p.Settings[key] = v
					end
				else
					p.Settings[key] = v
				end
			end
		end
	end
	if type(raw.Bindings) == "table" then
		for _, action in Config.Bindings.Remappable do
			local b = raw.Bindings[action]
			local valid = type(b) == "string" and #b <= 32 and pcall(function()
				return (Enum.KeyCode :: any)[b]
			end)
			if valid then
				p.Bindings[action] = b
			end
		end
	end
	if validNumber(raw.Style, 1, 64) then
		p.Style = math.floor(raw.Style)
	end
	for id in Jobs.ById do
		if type(raw.Unlocked) == "table" and raw.Unlocked[id] == true then
			p.Unlocked[id] = true
		end
		if type(raw.Best) == "table" and validNumber(raw.Best[id], 1, 36000) then
			p.Best[id] = raw.Best[id]
		end
		if type(raw.Medals) == "table" and Jobs.MedalRank[raw.Medals[id]] then
			p.Medals[id] = raw.Medals[id]
		end
	end
	p.TutorialSeen = raw.TutorialSeen == true
	return p
end

local function keyFor(player: Player): string
	return "u" .. player.UserId
end

function DataService.Load(player: Player): any
	local profile = defaults()
	status[player] = "memory"
	if store then
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync(keyFor(player))
		end)
		if ok then
			profile = DataService.Sanitize(result)
			status[player] = "ok"
		else
			warn("DataService: load failed for " .. player.Name .. ": " .. tostring(result))
			status[player] = "failing"
		end
	end
	profiles[player] = profile
	return profile
end

function DataService.Get(player: Player): any
	return profiles[player]
end

function DataService.Status(player: Player): string
	return status[player] or "memory"
end

function DataService.Save(player: Player)
	local profile = profiles[player]
	if not profile or not store or saving[player] or status[player] == "failing" then
		return
	end
	saving[player] = true
	dirty[player] = false
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old: any)
			-- merge so a stale server can never lower a best time or relock a job
			local base = DataService.Sanitize(old)
			for id, t in profile.Best do
				if base.Best[id] == nil or t < base.Best[id] then
					base.Best[id] = t
				end
			end
			for id, m in profile.Medals do
				if (Jobs.MedalRank[base.Medals[id]] or 0) < Jobs.MedalRank[m] then
					base.Medals[id] = m
				end
			end
			for id in profile.Unlocked do
				base.Unlocked[id] = true
			end
			base.Settings = profile.Settings
			base.Bindings = profile.Bindings
			base.Style = profile.Style
			base.TutorialSeen = profile.TutorialSeen
			return base
		end)
	end)
	saving[player] = false
	if not ok then
		warn("DataService: save failed for " .. player.Name .. ": " .. tostring(err))
		dirty[player] = true
	end
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

-- Records a finished job. Returns the previous best and whether this is a new best.
function DataService.RecordJob(player: Player, jobId: string, seconds: number, medal: string): (number?, boolean, string?)
	local p = profiles[player]
	if not p then
		return nil, false, nil
	end
	local prev = p.Best[jobId]
	local isBest = prev == nil or seconds < prev
	if isBest then
		p.Best[jobId] = seconds
	end
	if (Jobs.MedalRank[p.Medals[jobId]] or 0) < Jobs.MedalRank[medal] then
		p.Medals[jobId] = medal
	end
	local nextJob = Jobs.Next(jobId)
	local unlocked: string? = nil
	if nextJob and not p.Unlocked[nextJob.Id] then
		p.Unlocked[nextJob.Id] = true
		unlocked = nextJob.Id
	end
	dirty[player] = true
	task.spawn(DataService.Save, player)
	return prev, isBest, unlocked
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("DataService: DataStores unavailable, progress kept in memory only: " .. tostring(result))
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
		status[player] = nil
		dirty[player] = nil
	end)

	-- periodic save of changed settings
	task.spawn(function()
		while true do
			task.wait(30)
			for player, isDirty in dirty do
				if isDirty and player.Parent then
					task.spawn(DataService.Save, player)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 20 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">FurnitureModels</string>
          <string name="Source"><![CDATA[--[[
	FurnitureModels.luau
	Builds the look of every furniture kind out of primitive parts: chunky, bevelled,
	soft-cushioned cartoon furniture with contrasting trims, clean smooth colours (no
	textured materials) and silhouettes that read from the steep overhead camera.

	Each builder gets add(size, cframe, colour, material?, shape?) where cframe is relative
	to the item's collider centre (the collider is FurnitureData Size, bottom at -Size.Y/2).
	Visual parts are welded to the collider, massless, never collide and never block queries.

	Shape helpers:
	  bevel     a box with a chamfered, lighter top (5-6 parts)
	  softX/Z   a cushion slab whose ends are rounded by cylinders (3 parts)
	  roundTop  a box whose top is a half-cylinder (2 parts): sofa arms and backs
	  arrow     a printed "this way up" arrow on a face (3 parts)
]]

local FurnitureData = require(game:GetService("ReplicatedStorage").Shared.FurnitureData)
local Shapes = require(game:GetService("ReplicatedStorage").Shared.Shapes)

local FurnitureModels = {}

type Add = (size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?) -> BasePart

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local C = {
	wood = rgb(214, 152, 94),
	darkWood = rgb(136, 88, 58),
	lightWood = rgb(238, 198, 138),
	cardboard = rgb(224, 172, 112),
	cardboardDark = rgb(190, 136, 82),
	tape = rgb(204, 148, 88),
	print = rgb(46, 40, 44),
	white = rgb(246, 244, 238),
	cream = rgb(252, 238, 208),
	grey = rgb(160, 166, 178),
	dark = rgb(56, 58, 70),
	screen = rgb(46, 66, 96),
	glare = rgb(150, 196, 236),
	red = rgb(232, 86, 76),
	teal = rgb(62, 176, 172),
	blue = rgb(80, 138, 232),
	navy = rgb(52, 76, 150),
	yellow = rgb(248, 198, 80),
	orange = rgb(244, 140, 70),
	green = rgb(96, 184, 92),
	leaf = rgb(70, 160, 86),
	mint = rgb(150, 220, 178),
	pink = rgb(244, 132, 170),
	purple = rgb(136, 104, 190),
	gold = rgb(236, 190, 76),
	pot = rgb(214, 112, 76),
	metal = rgb(190, 196, 206),
	glow = rgb(255, 240, 190),
}
FurnitureModels.Colors = C

local V = Vector3.new
local CF = CFrame.new
local rad = math.rad
local SP = Enum.PartType.Ball
local CY = Enum.PartType.Cylinder
local WG = Enum.PartType.Wedge
local smooth = Enum.Material.SmoothPlastic
local metalM = Enum.Material.Metal
local glassM = Enum.Material.Glass
local neon = Enum.Material.Neon
local upright = CFrame.Angles(0, 0, rad(90)) -- cylinder axis X -> Y
local alongZ = CFrame.Angles(0, rad(90), 0) -- cylinder axis X -> Z
local faceX = CFrame.Angles(0, rad(90), 0) -- local +Z (face normal) -> +X
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local function light(c: Color3, t: number?): Color3
	return c:Lerp(WHITE, t or 0.18)
end
local function shade(c: Color3, t: number?): Color3
	return c:Lerp(BLACK, t or 0.15)
end

-- A box with a lighter top and chamfered top edges, so it reads as bevelled from above.
local function bevel(add: Add, size: Vector3, cf: CFrame, color: Color3, top: Color3?, b: number?)
	local e = b or 0.14
	local topC = top or light(color, 0.14)
	add(V(size.X, size.Y - e, size.Z), cf * CF(0, -e / 2, 0), color)
	local y = size.Y / 2 - e / 2
	add(V(size.X - 2 * e, e, size.Z - 2 * e), cf * CF(0, y, 0), topC)
	add(V(size.X - 2 * e, e, e), cf * CF(0, y, -size.Z / 2 + e / 2), color, smooth, WG)
	add(V(size.X - 2 * e, e, e), cf * CF(0, y, size.Z / 2 - e / 2) * CFrame.Angles(0, math.pi, 0), color, smooth, WG)
	add(V(size.Z - 2 * e, e, e), cf * CF(-size.X / 2 + e / 2, y, 0) * CFrame.Angles(0, rad(90), 0), color, smooth, WG)
	add(V(size.Z - 2 * e, e, e), cf * CF(size.X / 2 - e / 2, y, 0) * CFrame.Angles(0, rad(-90), 0), color, smooth, WG)
end

-- A cushion slab with its front and back (±Z) edges rounded.
local function softX(add: Add, size: Vector3, cf: CFrame, color: Color3)
	if size.Z <= size.Y then
		add(size, cf, color)
		return
	end
	add(V(size.X, size.Y, size.Z - size.Y), cf, color)
	for _, sz in { -1, 1 } do
		add(V(size.X, size.Y, size.Y), cf * CF(0, 0, sz * (size.Z - size.Y) / 2), color, smooth, CY)
	end
end

-- A cushion slab with its left and right (±X) edges rounded.
local function softZ(add: Add, size: Vector3, cf: CFrame, color: Color3)
	if size.X <= size.Y then
		add(size, cf, color)
		return
	end
	add(V(size.X - size.Y, size.Y, size.Z), cf, color)
	for _, sx in { -1, 1 } do
		add(V(size.Z, size.Y, size.Y), cf * CF(sx * (size.X - size.Y) / 2, 0, 0) * alongZ, color, smooth, CY)
	end
end

-- A box whose top is a half-cylinder running along its longer horizontal side.
local function roundTop(add: Add, size: Vector3, cf: CFrame, color: Color3)
	if size.X <= size.Z then
		local r = size.X / 2
		add(V(size.X, size.Y - r, size.Z), cf * CF(0, -r / 2, 0), color)
		add(V(size.Z, size.X, size.X), cf * CF(0, size.Y / 2 - r, 0) * alongZ, color, smooth, CY)
	else
		local r = size.Z / 2
		add(V(size.X, size.Y - r, size.Z), cf * CF(0, -r / 2, 0), color)
		add(V(size.X, size.Z, size.Z), cf * CF(0, size.Y / 2 - r, 0), color, smooth, CY)
	end
end

-- A printed upward arrow centred on a face. cf: face point, local +Z out of the face.
local function arrow(add: Add, cf: CFrame, k: number, color: Color3)
	add(V(0.16 * k, 0.32 * k, 0.03), cf * CF(0, -0.14 * k, 0), color)
	local hw, hh = 0.42 * k, 0.26 * k
	local right = CFrame.fromMatrix(Vector3.zero, V(0, 0, 1), V(0, 1, 0))
	local left = CFrame.fromMatrix(Vector3.zero, V(0, 0, -1), V(0, 1, 0))
	add(V(0.03, hh, hw / 2), cf * CF(hw / 4, 0.15 * k, 0) * right, color, smooth, WG)
	add(V(0.03, hh, hw / 2), cf * CF(-hw / 4, 0.15 * k, 0) * left, color, smooth, WG)
end

local function legs(add: Add, s: Vector3, h: number, inset: number, thick: number, color: Color3, round: boolean?)
	local y = -s.Y / 2 + h / 2
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			if round then
				add(V(h, thick, thick), CF(sx * (s.X / 2 - inset), y, sz * (s.Z / 2 - inset)) * upright, color, smooth, CY)
			else
				add(V(thick, h, thick), CF(sx * (s.X / 2 - inset), y, sz * (s.Z / 2 - inset)), color)
			end
		end
	end
end

local B: { [string]: (add: Add, s: Vector3, tint: Color3?) -> () } = {}

----------------------------------------------------------------------------------------
-- boxes

-- Tan cardboard box: bevelled body, darker tape cross over the top running down two
-- sides, and a black "this way up" arrow printed on two faces.
B.Box = function(add, s, tint)
	local body = tint or C.cardboard
	local tape = shade(body, 0.14)
	bevel(add, s, CF(), body, light(body, 0.06), 0.1)
	local tw = math.min(s.X, s.Z) * 0.26
	add(V(tw, 0.04, s.Z + 0.02), CF(0, s.Y / 2 + 0.01, 0), tape)
	add(V(s.X + 0.02, 0.04, tw * 0.55), CF(0, s.Y / 2 + 0.015, 0), tape)
	for _, sz in { -1, 1 } do
		add(V(tw, s.Y * 0.36, 0.04), CF(0, s.Y * 0.32, sz * (s.Z / 2 + 0.01)), tape)
	end
	local k = math.min(s.Y, s.X, s.Z) * 0.5
	arrow(add, CF(s.X * 0.27, -s.Y * 0.08, s.Z / 2 + 0.02), k, C.print)
	arrow(add, CF(s.X / 2 + 0.02, -s.Y * 0.08, -s.Z * 0.25) * faceX, k, C.print)
end
B.BoxTall = B.Box
B.BoxSmall = function(add, s, tint)
	B.Box(add, s, tint or rgb(214, 160, 100))
end
B.BoxFlat = function(add, s, tint)
	B.Box(add, s, tint or rgb(232, 186, 128))
end
B.Parcel = function(add, s, tint)
	B.Box(add, s, tint or rgb(206, 156, 104))
	add(V(s.X * 0.3, 0.05, s.Z * 0.28), CF(-s.X * 0.24, s.Y / 2 + 0.03, s.Z * 0.22), C.white) -- address label
	add(V(s.X * 0.2, 0.06, 0.06), CF(-s.X * 0.24, s.Y / 2 + 0.05, s.Z * 0.2), C.print)
	add(V(s.X * 0.32, s.Y * 0.2, 0.04), CF(-s.X * 0.18, s.Y * 0.1, -s.Z / 2 - 0.02), C.red) -- fragile sticker
end

----------------------------------------------------------------------------------------
-- light items

B.Lamp = function(add, s, tint)
	local col = tint or C.yellow
	add(V(0.3, s.X * 0.85, s.X * 0.85), CF(0, -s.Y / 2 + 0.15, 0) * upright, C.dark, smooth, CY)
	add(V(0.08, s.X * 0.6, s.X * 0.6), CF(0, -s.Y / 2 + 0.33, 0) * upright, C.grey, smooth, CY)
	add(V(s.Y * 0.62, 0.22, 0.22), CF(0, -s.Y / 2 + s.Y * 0.33, 0) * upright, C.metal, metalM, CY)
	add(V(0.8, s.X, s.X), CF(0, s.Y / 2 - 1.1, 0) * upright, col, smooth, CY)
	add(V(0.8, s.X * 0.82, s.X * 0.82), CF(0, s.Y / 2 - 0.4, 0) * upright, col, smooth, CY)
	add(V(0.06, s.X * 0.6, s.X * 0.6), CF(0, s.Y / 2 - 0.02, 0) * upright, light(col, 0.5), smooth, CY)
	add(V(0.07, s.X * 0.86, s.X * 0.86), CF(0, s.Y / 2 - 0.82, 0) * upright, light(col, 0.35), smooth, CY)
	add(V(0.5, 0.5, 0.5), CF(0, s.Y / 2 - 1.45, 0), C.glow, neon, SP)
end

B.Stool = function(add, s, tint)
	local col = tint or C.red
	add(V(0.3, s.X, s.X), CF(0, s.Y / 2 - 0.25, 0) * upright, shade(col, 0.1), smooth, CY)
	add(V(0.2, s.X * 0.86, s.X * 0.86), CF(0, s.Y / 2 - 0.1, 0) * upright, light(col, 0.12), smooth, CY)
	for _, a in { 45, 135, 225, 315 } do
		local d = s.X * 0.3
		local x, z = math.cos(rad(a)) * d, math.sin(rad(a)) * d
		add(V(0.24, s.Y - 0.4, 0.24), CF(x, -0.2, z) * CFrame.Angles(math.sin(rad(a)) * rad(-6), 0, math.cos(rad(a)) * rad(6)), C.darkWood)
	end
	add(V(s.X * 0.6, 0.12, 0.12), CF(0, -s.Y * 0.18, 0), C.darkWood)
	add(V(0.12, 0.12, s.X * 0.6), CF(0, -s.Y * 0.18, 0), C.darkWood)
end

B.SideTable = function(add, s, tint)
	local col = tint or C.wood
	bevel(add, V(s.X, 0.32, s.Z), CF(0, s.Y / 2 - 0.16, 0), col, light(col, 0.2), 0.1)
	add(V(s.X - 0.4, 0.8, s.Z - 0.4), CF(0, s.Y / 2 - 0.72, 0), shade(col, 0.08))
	add(V(s.X - 0.7, 0.55, 0.06), CF(0, s.Y / 2 - 0.72, s.Z / 2 - 0.18), light(col, 0.25))
	add(V(0.26, 0.26, 0.26), CF(0, s.Y / 2 - 0.72, s.Z / 2 - 0.12), C.gold, smooth, SP)
	legs(add, s, s.Y - 0.32, 0.28, 0.26, C.darkWood)
	add(V(s.X - 0.5, 0.14, s.Z - 0.5), CF(0, -s.Y / 2 + 0.55, 0), shade(col, 0.1))
end

local function leaves(add: Add, y: number, count: number, len: number, col: Color3, lift: number)
	for i = 1, count do
		local a = (i / count) * 360 + 20
		local cf = CF(0, y, 0) * CFrame.Angles(0, rad(a), 0) * CF(0, 0, -len * 0.38) * CFrame.Angles(rad(lift), 0, 0)
		add(V(len * 0.42, 0.18, len), cf, i % 2 == 0 and col or light(col, 0.15), smooth, SP)
	end
end

B.Plant = function(add, s, tint)
	local col = tint or C.leaf
	local potH = 1.3
	add(V(potH, s.X * 0.72, s.X * 0.72), CF(0, -s.Y / 2 + potH / 2, 0) * upright, C.pot, smooth, CY)
	add(V(0.3, s.X * 0.82, s.X * 0.82), CF(0, -s.Y / 2 + potH - 0.1, 0) * upright, light(C.pot, 0.12), smooth, CY)
	add(V(0.06, s.X * 0.66, s.X * 0.66), CF(0, -s.Y / 2 + potH + 0.03, 0) * upright, C.darkWood, smooth, CY)
	add(V(1.2, 0.2, 0.2), CF(0, -s.Y / 2 + potH + 0.5, 0) * upright, shade(col, 0.2), smooth, CY)
	leaves(add, -s.Y / 2 + potH + 0.75, 5, 2, col, 35)
	leaves(add, -s.Y / 2 + potH + 1.25, 3, 1.5, light(col, 0.08), 60)
	add(V(0.7, 0.9, 0.7), CF(0, s.Y / 2 - 0.6, 0), light(col, 0.2), smooth, SP)
end

-- Small potted cactus with a pink flower.
B.PlantSmall = function(add, s, tint)
	local col = tint or C.green
	local potH = 0.9
	add(V(potH, s.X * 0.8, s.X * 0.8), CF(0, -s.Y / 2 + potH / 2, 0) * upright, rgb(110, 170, 220), smooth, CY)
	add(V(0.22, s.X * 0.92, s.X * 0.92), CF(0, -s.Y / 2 + potH - 0.05, 0) * upright, light(rgb(110, 170, 220), 0.3), smooth, CY)
	add(V(0.05, s.X * 0.7, s.X * 0.7), CF(0, -s.Y / 2 + potH + 0.07, 0) * upright, rgb(226, 196, 140), smooth, CY)
	local bodyH = s.Y - potH - 0.2
	add(V(0.75, bodyH, 0.75), CF(0, -s.Y / 2 + potH + bodyH / 2, 0), col, smooth, SP)
	for _, sx in { -1, 1 } do
		add(V(0.36, 0.7, 0.36), CF(sx * 0.42, -s.Y / 2 + potH + bodyH * 0.6, 0) * CFrame.Angles(0, 0, sx * rad(-20)), light(col, 0.08), smooth, SP)
	end
	add(V(0.32, 0.22, 0.32), CF(0, s.Y / 2 - 0.2, 0), C.pink, smooth, SP)
end

-- Beach ball: four overlapping spheres nudged into quadrants make alternating panels.
B.BeachBall = function(add, s, tint)
	local d = 0.07
	local r = math.min(s.X, s.Y, s.Z) - 2 * d * 1.42
	local panels = { tint or C.red, C.white, C.blue, C.white }
	for i, c in panels do
		local a = rad(45 + i * 90)
		add(V(r, r, r), CF(math.cos(a) * d * 1.42, 0, math.sin(a) * d * 1.42), c, smooth, SP)
	end
	add(V(0.06, r * 0.26, r * 0.26), CF(0, r / 2 + 0.02, 0) * upright, C.yellow, smooth, CY)
	add(V(0.06, r * 0.26, r * 0.26), CF(0, -r / 2 - 0.02, 0) * upright, C.yellow, smooth, CY)
end

-- Pool flamingo float.
B.Flamingo = function(add, s, tint)
	local pink = tint or C.pink
	add(V(s.X * 0.86, 1.1, s.Z), CF(-s.X * 0.06, -s.Y / 2 + 0.55, 0), pink, smooth, SP)
	add(V(s.X * 0.5, 0.4, s.Z * 0.6), CF(-s.X * 0.12, -s.Y / 2 + 1.05, 0), light(pink, 0.25), smooth, SP)
	add(V(s.X * 0.25, 0.8, s.Z * 0.5), CF(-s.X * 0.42, -s.Y / 2 + 1.0, 0) * CFrame.Angles(0, 0, rad(30)), shade(pink, 0.06), smooth, SP)
	add(V(0.55, 2.0, 0.55), CF(s.X * 0.24, -s.Y / 2 + 1.9, 0) * CFrame.Angles(0, 0, rad(-14)), pink, smooth, SP)
	add(V(0.9, 0.85, 0.8), CF(s.X * 0.33, s.Y / 2 - 0.45, 0), pink, smooth, SP)
	add(V(0.5, 0.26, 0.3), CF(s.X * 0.33 + 0.55, s.Y / 2 - 0.55, 0) * CFrame.Angles(0, 0, rad(-25)), C.white, smooth, SP)
	add(V(0.22, 0.2, 0.24), CF(s.X / 2 - 0.12, s.Y / 2 - 0.72, 0), C.print, smooth, SP)
	for _, sz in { -1, 1 } do
		add(V(0.14, 0.14, 0.06), CF(s.X * 0.38, s.Y / 2 - 0.35, sz * 0.38), C.print, smooth, SP)
	end
end

B.Microwave = function(add, s, tint)
	local col = tint or C.white
	bevel(add, s, CF(), col, nil, 0.14)
	add(V(s.X * 0.6, s.Y * 0.62, 0.06), CF(-s.X * 0.12, -0.05, s.Z / 2 + 0.01), C.dark)
	add(V(s.X * 0.48, s.Y * 0.44, 0.06), CF(-s.X * 0.12, -0.05, s.Z / 2 + 0.03), C.screen, glassM)
	add(V(s.X * 0.18, s.Y * 0.1, 0.06), CF(-s.X * 0.22, s.Y * 0.08, s.Z / 2 + 0.05), C.glare)
	add(V(s.X * 0.22, s.Y * 0.62, 0.06), CF(s.X * 0.33, -0.05, s.Z / 2 + 0.01), C.grey)
	add(V(0.07, 0.24, 0.24), CF(s.X * 0.33, s.Y * 0.12, s.Z / 2 + 0.06) * alongZ * upright, C.dark, smooth, CY)
	add(V(s.X * 0.12, s.Y * 0.08, 0.06), CF(s.X * 0.33, -s.Y * 0.18, s.Z / 2 + 0.05), C.teal, neon)
end

-- Two-slot toaster.
B.Toaster = function(add, s, tint)
	local col = tint or rgb(120, 200, 208)
	bevel(add, V(s.X, s.Y - 0.12, s.Z), CF(0, 0.06, 0), col, light(col, 0.22), 0.18)
	add(V(s.X + 0.06, 0.12, s.Z + 0.06), CF(0, -s.Y / 2 + 0.06, 0), C.dark)
	for _, sx in { -1, 1 } do
		add(V(s.X * 0.32, 0.03, s.Z * 0.22), CF(sx * s.X * 0.2, s.Y / 2 + 0.005, 0), C.dark)
		add(V(s.X * 0.26, 0.08, s.Z * 0.12), CF(sx * s.X * 0.2, s.Y / 2 + 0.03, 0), rgb(232, 182, 110)) -- toast
	end
	add(V(0.18, 0.3, 0.12), CF(s.X / 2 + 0.06, s.Y * 0.15, 0), C.dark)
	add(V(s.X * 0.6, 0.06, 0.04), CF(0, -s.Y * 0.05, s.Z / 2 + 0.02), C.white)
end

B.Vase = function(add, s, tint)
	local col = tint or C.teal
	add(V(s.X, s.Y * 0.68, s.Z), CF(0, -s.Y * 0.15, 0), col, smooth, SP)
	add(V(s.X * 1.02, s.Y * 0.1, s.Z * 1.02), CF(0, -s.Y * 0.15, 0), light(col, 0.45), smooth, SP)
	add(V(s.Y * 0.34, s.X * 0.42, s.X * 0.42), CF(0, s.Y * 0.2, 0) * upright, col, smooth, CY)
	add(V(0.14, s.X * 0.6, s.X * 0.6), CF(0, s.Y * 0.36, 0) * upright, light(col, 0.2), smooth, CY)
	for i, c in { C.red, C.yellow, C.pink } do
		local a = rad(i * 120)
		add(V(0.42, 0.34, 0.42), CF(math.cos(a) * 0.24, s.Y / 2 - 0.12, math.sin(a) * 0.24), c, smooth, SP)
	end
end

B.Candelabra = function(add, s, tint)
	local gold = tint or C.gold
	add(V(0.3, 1.2, 1.2), CF(0, -s.Y / 2 + 0.15, 0) * upright, gold, metalM, CY)
	add(V(s.Y * 0.6, 0.25, 0.25), CF(0, -s.Y * 0.1, 0) * upright, gold, metalM, CY)
	add(V(s.X, 0.22, 0.22), CF(0, s.Y * 0.18, 0), gold, metalM, CY)
	for _, x in { -s.X / 2 + 0.15, 0, s.X / 2 - 0.15 } do
		add(V(0.12, 0.42, 0.42), CF(x, s.Y * 0.18 + 0.18, 0) * upright, shade(gold, 0.1), metalM, CY)
		add(V(0.25, 0.7, 0.25), CF(x, s.Y * 0.18 + 0.55, 0), C.cream)
		add(V(0.2, 0.32, 0.2), CF(x, s.Y * 0.18 + 1.05, 0), rgb(255, 196, 90), neon, SP)
	end
end

-- Acoustic guitar lying on its back.
B.Guitar = function(add, s, tint)
	local col = tint or rgb(232, 150, 70)
	local bodyY = -s.Y / 2 + 0.25
	add(V(s.X, 0.5, s.X * 1.05), CF(0, bodyY, s.Z / 2 - s.X * 0.52), col, smooth, SP)
	add(V(s.X * 0.8, 0.5, s.X * 0.8), CF(0, bodyY, s.Z / 2 - s.X * 1.25), col, smooth, SP)
	add(V(s.X * 0.62, 0.52, s.X * 0.62), CF(0, bodyY, s.Z / 2 - s.X * 0.52), light(col, 0.25), smooth, SP)
	add(V(0.06, s.X * 0.32, s.X * 0.32), CF(0, bodyY + 0.26, s.Z / 2 - s.X * 0.95) * upright, C.print, smooth, CY)
	add(V(0.34, 0.16, s.Z * 0.5), CF(0, bodyY + 0.12, -s.Z * 0.17), C.darkWood)
	add(V(0.5, 0.18, 0.55), CF(0, bodyY + 0.12, -s.Z / 2 + 0.28), shade(C.darkWood, 0.2))
	add(V(0.4, 0.05, 0.14), CF(0, bodyY + 0.27, s.Z / 2 - s.X * 0.32), C.darkWood)
	add(V(0.12, 0.03, s.Z * 0.62), CF(0, bodyY + 0.21, -s.Z * 0.02), C.cream)
end

-- Kitchen pedal bin.
B.Bin = function(add, s, tint)
	local col = tint or rgb(96, 186, 120)
	add(V(s.Y - 0.3, s.X * 0.9, s.X * 0.9), CF(0, -0.15, 0) * upright, col, smooth, CY)
	add(V(0.3, s.X, s.X), CF(0, s.Y / 2 - 0.15, 0) * upright, light(col, 0.15), smooth, CY)
	add(V(0.06, s.X * 0.7, s.X * 0.7), CF(0, s.Y / 2 + 0.01, 0) * upright, light(col, 0.3), smooth, CY)
	add(V(s.X * 0.4, 0.12, 0.16), CF(0, s.Y / 2 + 0.06, 0), C.dark)
	add(V(0.2, s.X * 0.92, s.X * 0.92), CF(0, -s.Y / 2 + 0.1, 0) * upright, C.dark, smooth, CY)
	add(V(0.4, 0.12, 0.3), CF(0, -s.Y / 2 + 0.12, s.X / 2), C.metal, metalM)
end

-- Rolled-up striped rug.
B.RugRoll = function(add, s, tint)
	local col = tint or rgb(228, 92, 96)
	add(V(s.X, s.Y, s.Z), CF(), col, smooth, CY)
	for _, x in { -s.X * 0.3, 0, s.X * 0.3 } do
		add(V(0.3, s.Y * 1.02, s.Z * 1.02), CF(x, 0, 0), C.cream, smooth, CY)
	end
	for _, sx in { -1, 1 } do
		add(V(0.04, s.Y * 0.7, s.Z * 0.7), CF(sx * s.X / 2, 0, 0), shade(col, 0.25), smooth, CY)
		add(V(0.05, s.Y * 0.3, s.Z * 0.3), CF(sx * s.X / 2, 0, 0), C.cream, smooth, CY)
	end
end

-- Standing electric fan.
B.Fan = function(add, s, tint)
	local col = tint or rgb(120, 190, 230)
	add(V(0.25, s.X * 0.9, s.X * 0.9), CF(0, -s.Y / 2 + 0.13, 0) * upright, col, smooth, CY)
	add(V(s.Y * 0.55, 0.2, 0.2), CF(0, -s.Y / 2 + s.Y * 0.3, 0) * upright, C.metal, metalM, CY)
	local headY = s.Y / 2 - s.X / 2
	add(V(0.5, 0.5, 0.7), CF(0, headY, -s.Z / 2 + 0.35), col, smooth, SP)
	add(V(0.3, s.X, s.X), CF(0, headY, s.Z / 2 - 0.2) * CFrame.Angles(0, rad(90), 0), C.white, smooth, CY)
	add(V(0.32, s.X * 0.82, s.X * 0.82), CF(0, headY, s.Z / 2 - 0.2) * CFrame.Angles(0, rad(90), 0), light(col, 0.4), smooth, CY)
	for i = 0, 2 do
		add(V(s.X * 0.36, 0.3, 0.06), CF(0, headY, s.Z / 2 - 0.12) * CFrame.Angles(0, 0, rad(i * 120)) * CF(s.X * 0.18, 0, 0), col)
	end
	add(V(0.12, 0.3, 0.3), CF(0, headY, s.Z / 2 - 0.05) * CFrame.Angles(0, rad(90), 0), C.dark, smooth, CY)
end

-- Suitcase lying flat, with straps and a handle.
B.Suitcase = function(add, s, tint)
	local col = tint or rgb(170, 104, 70)
	bevel(add, s, CF(), col, light(col, 0.1), 0.16)
	add(V(s.X + 0.04, s.Y * 0.18, s.Z + 0.04), CF(0, 0, 0), shade(col, 0.25))
	for _, sx in { -1, 1 } do
		add(V(0.28, 0.04, s.Z + 0.06), CF(sx * s.X * 0.27, s.Y / 2 + 0.01, 0), rgb(236, 210, 150))
		add(V(0.28, s.Y + 0.06, 0.04), CF(sx * s.X * 0.27, 0, s.Z / 2 + 0.02), rgb(236, 210, 150))
	end
	add(V(0.8, 0.16, 0.26), CF(0, 0.05, s.Z / 2 + 0.13), C.dark)
	for _, sx in { -1, 1 } do
		add(V(0.24, 0.24, 0.24), CF(sx * (s.X / 2 - 0.06), s.Y * 0.3, s.Z / 2 - 0.06), C.gold, smooth, SP)
	end
end

----------------------------------------------------------------------------------------
-- medium

B.Chair = function(add, s, tint)
	local col = tint or C.wood
	local seatY = -s.Y / 2 + s.Y * 0.45
	bevel(add, V(s.X, 0.32, s.Z), CF(0, seatY, 0), col, nil, 0.1)
	softX(add, V(s.X - 0.5, 0.3, s.Z - 0.6), CF(0, seatY + 0.28, 0.1), C.red)
	local backH = s.Y / 2 - seatY
	for _, sx in { -1, 1 } do
		add(V(0.28, backH, 0.28), CF(sx * (s.X / 2 - 0.2), seatY + backH / 2, -s.Z / 2 + 0.2), shade(col, 0.1))
	end
	roundTop(add, V(s.X, 0.6, 0.3), CF(0, s.Y / 2 - 0.3, -s.Z / 2 + 0.2), col)
	add(V(s.X - 0.7, 0.18, 0.2), CF(0, seatY + backH * 0.45, -s.Z / 2 + 0.2), col)
	legs(add, s, s.Y * 0.45 - 0.16, 0.2, 0.28, C.darkWood)
end

B.TV = function(add, s, tint)
	local col = tint or C.dark
	local bodyH = s.Y - 0.45
	bevel(add, V(s.X, bodyH, s.Z * 0.62), CF(0, s.Y / 2 - bodyH / 2, -s.Z * 0.12), col, light(col, 0.15), 0.16)
	add(V(s.X - 0.45, bodyH - 0.45, 0.06), CF(0, s.Y / 2 - bodyH / 2, s.Z * 0.19 + 0.01), C.screen, glassM)
	add(V(s.X * 0.32, 0.18, 0.06), CF(-s.X * 0.18, s.Y / 2 - bodyH * 0.3, s.Z * 0.19 + 0.03) * CFrame.Angles(0, 0, rad(18)), C.glare)
	add(V(s.X * 0.14, 0.12, 0.06), CF(-s.X * 0.3, s.Y / 2 - bodyH * 0.38, s.Z * 0.19 + 0.03) * CFrame.Angles(0, 0, rad(18)), C.glare)
	add(V(0.16, 0.16, 0.06), CF(s.X / 2 - 0.4, -s.Y / 2 + 0.6, s.Z * 0.19 + 0.02), C.red, neon)
	add(V(0.4, 0.4, 0.3), CF(0, -s.Y / 2 + 0.3, -s.Z * 0.12), shade(col, 0.1))
	softZ(add, V(s.X * 0.5, 0.22, s.Z), CF(0, -s.Y / 2 + 0.11, 0), shade(col, 0.1))
end

B.CoffeeTable = function(add, s, tint)
	local col = tint or C.lightWood
	bevel(add, V(s.X, 0.42, s.Z), CF(0, s.Y / 2 - 0.21, 0), col, light(col, 0.15), 0.14)
	add(V(s.X - 0.5, 0.3, s.Z - 0.5), CF(0, s.Y / 2 - 0.55, 0), shade(col, 0.15))
	add(V(s.X - 0.8, 0.15, s.Z - 0.8), CF(0, -s.Y / 2 + 0.5, 0), shade(col, 0.1))
	legs(add, s, s.Y - 0.42, 0.35, 0.36, C.darkWood, true)
	add(V(1.2, 0.16, 0.9), CF(-s.X * 0.22, s.Y / 2 + 0.08, 0.2) * CFrame.Angles(0, rad(12), 0), C.blue)
	add(V(1.0, 0.1, 0.75), CF(-s.X * 0.22, s.Y / 2 + 0.2, 0.2) * CFrame.Angles(0, rad(-6), 0), C.yellow)
	add(V(0.4, 0.42, 0.42), CF(s.X * 0.25, s.Y / 2 + 0.2, -0.3) * upright, C.white, smooth, CY)
	add(V(0.42, 0.3, 0.3), CF(s.X * 0.25, s.Y / 2 + 0.22, -0.3) * upright, C.darkWood, smooth, CY)
end

B.Armchair = function(add, s, tint)
	local col = tint or C.teal
	local baseH = s.Y * 0.32
	add(V(s.X, baseH, s.Z - 0.2), CF(0, -s.Y / 2 + 0.25 + baseH / 2, 0.1), shade(col, 0.08))
	roundTop(add, V(s.X, s.Y - 0.25, 0.9), CF(0, 0.125, -s.Z / 2 + 0.45), col)
	for _, sx in { -1, 1 } do
		roundTop(add, V(0.8, s.Y * 0.62, s.Z - 0.2), CF(sx * (s.X / 2 - 0.4), -s.Y / 2 + 0.25 + s.Y * 0.31, 0.1), col)
	end
	softX(add, V(s.X - 1.6, 0.55, s.Z - 1.1), CF(0, -s.Y / 2 + 0.25 + baseH + 0.27, 0.35), light(col, 0.16))
	softX(add, V(s.X - 1.7, 1.2, 0.5), CF(0, s.Y * 0.08, -s.Z / 2 + 1.05) * CFrame.Angles(rad(-90), 0, 0), light(col, 0.1))
	legs(add, s, 0.25, 0.35, 0.3, C.darkWood, true)
end

B.Sofa = function(add, s, tint)
	local col = tint or C.yellow
	local legH = 0.3
	local baseH = s.Y * 0.32
	local armW = 1
	add(V(s.X - 0.2, baseH, s.Z - 0.2), CF(0, -s.Y / 2 + legH + baseH / 2, 0.1), shade(col, 0.1))
	roundTop(add, V(s.X - 0.2, s.Y - legH, 1), CF(0, legH / 2, -s.Z / 2 + 0.5), col)
	for _, sx in { -1, 1 } do
		roundTop(add, V(armW, s.Y * 0.6, s.Z), CF(sx * (s.X / 2 - armW / 2), -s.Y / 2 + legH + s.Y * 0.3, 0), col)
	end
	local inner = s.X - 2 * armW - 0.1
	local seatTop = -s.Y / 2 + legH + baseH
	for i = 0, 1 do
		local w = inner / 2 - 0.08
		local x = -inner / 2 + w / 2 + 0.04 + i * (inner / 2)
		softX(add, V(w, 0.6, s.Z - 1.2), CF(x, seatTop + 0.3, 0.45), light(col, 0.16))
		softX(add, V(w - 0.3, 1.3, 0.55), CF(x, seatTop + 1.0, -s.Z / 2 + 1.25) * CFrame.Angles(rad(-90), 0, 0), light(col, 0.1))
	end
	add(V(1.1, 1.1, 0.45), CF(-inner / 2 + 0.5, seatTop + 1.0, -s.Z / 2 + 1.6) * CFrame.Angles(rad(-12), 0, rad(14)), C.teal, smooth, SP)
	legs(add, s, legH, 0.5, 0.35, C.darkWood, true)
end

B.Bed = function(add, s, tint)
	local col = tint or rgb(112, 204, 140)
	local wood = C.wood
	local frameH = s.Y * 0.4
	add(V(s.X, frameH, s.Z - 0.4), CF(0, -s.Y / 2 + frameH / 2 + 0.2, 0.2), wood)
	legs(add, s, 0.3, 0.3, 0.4, C.darkWood, true)
	roundTop(add, V(s.X, s.Y, 0.55), CF(0, 0, -s.Z / 2 + 0.28), shade(wood, 0.1))
	roundTop(add, V(s.X, s.Y * 0.62, 0.4), CF(0, -s.Y * 0.19, s.Z / 2 - 0.2), shade(wood, 0.1))
	local mattY = -s.Y / 2 + 0.2 + frameH
	add(V(s.X - 0.3, 0.6, s.Z - 1.2), CF(0, mattY + 0.3, -0.05), C.white)
	softX(add, V(s.X - 0.15, 0.7, s.Z * 0.66), CF(0, mattY + 0.4, s.Z * 0.13), col)
	add(V(s.X - 0.1, 0.72, 0.55), CF(0, mattY + 0.41, s.Z * 0.13 - s.Z * 0.33 + 0.45), C.white)
	add(V(s.X - 0.12, 0.74, 0.18), CF(0, mattY + 0.42, s.Z * 0.13 - s.Z * 0.33 + 0.82), light(col, 0.3))
	for _, sx in { -1, 1 } do
		add(V(s.X * 0.4, 0.55, 1.3), CF(sx * s.X * 0.22, mattY + 0.75, -s.Z / 2 + 1.35), C.cream, smooth, SP)
	end
end

B.Fridge = function(add, s, tint)
	local col = tint or rgb(232, 240, 244)
	bevel(add, s - V(0.05, 0, 0.05), CF(), col, light(col, 0.4), 0.2)
	add(V(s.X - 0.2, 0.08, 0.06), CF(0, s.Y * 0.16, s.Z / 2 - 0.01), C.grey)
	for _, y in { s.Y * 0.34, -s.Y * 0.06 } do
		roundTop(add, V(0.22, 1.5, 0.22), CF(s.X / 2 - 0.42, y, s.Z / 2 + 0.1), C.metal)
	end
	add(V(0.55, 0.55, 0.06), CF(-0.6, s.Y * 0.37, s.Z / 2), C.red)
	add(V(0.45, 0.45, 0.06), CF(-0.15, s.Y * 0.28, s.Z / 2), C.yellow)
	add(V(0.8, 1.0, 0.04), CF(-0.5, -s.Y * 0.05, s.Z / 2), C.white)
	add(V(s.X - 0.3, 0.25, s.Z - 0.3), CF(0, -s.Y / 2 + 0.06, 0), C.dark)
end

B.DiningTable = function(add, s, tint)
	local col = tint or C.wood
	bevel(add, V(s.X, 0.5, s.Z), CF(0, s.Y / 2 - 0.25, 0), col, light(col, 0.15), 0.16)
	add(V(s.X - 0.8, 0.4, s.Z - 0.8), CF(0, s.Y / 2 - 0.7, 0), shade(col, 0.15))
	legs(add, s, s.Y - 0.5, 0.55, 0.5, C.darkWood, true)
	add(V(s.X * 0.6, 0.05, s.Z * 0.42), CF(0, s.Y / 2 + 0.02, 0), C.cream)
	add(V(0.3, 1.5, 1.5), CF(0, s.Y / 2 + 0.15, 0) * upright, C.white, smooth, CY)
	for i, c in { C.red, C.orange, C.green } do
		local a = rad(i * 120)
		add(V(0.5, 0.5, 0.5), CF(math.cos(a) * 0.3, s.Y / 2 + 0.45, math.sin(a) * 0.3), c, smooth, SP)
	end
end

B.Piano = function(add, s, tint)
	local col = tint or rgb(58, 46, 44)
	local backZ = -s.Z / 2 + s.Z * 0.28
	bevel(add, V(s.X, s.Y * 0.92, s.Z * 0.56), CF(0, s.Y * 0.04, backZ), col, light(col, 0.12), 0.16)
	local kbY = -s.Y * 0.08
	add(V(s.X - 0.2, 0.4, s.Z * 0.44), CF(0, kbY, s.Z / 2 - s.Z * 0.22), shade(col, 0.05))
	add(V(s.X - 0.7, 0.1, s.Z * 0.3), CF(0, kbY + 0.24, s.Z / 2 - s.Z * 0.2), C.white)
	local n = 8
	for i = 0, n - 1 do
		if i % 4 ~= 2 then
			add(V(0.2, 0.08, s.Z * 0.16), CF(-s.X / 2 + 0.75 + i * (s.X - 1.4) / (n - 1), kbY + 0.32, s.Z / 2 - s.Z * 0.27), C.print)
		end
	end
	add(V(1.4, 1.1, 0.08), CF(0, s.Y * 0.26, backZ + s.Z * 0.28 + 0.02) * CFrame.Angles(rad(-10), 0, 0), C.cream)
	add(V(0.8, 0.06, 0.08), CF(0, s.Y * 0.3, backZ + s.Z * 0.28 + 0.07), C.print)
	for _, sx in { -1, 1 } do
		add(V(0.4, s.Y * 0.45, 0.4), CF(sx * (s.X / 2 - 0.3), -s.Y / 2 + s.Y * 0.225, s.Z / 2 - 0.3), col)
		add(V(0.5, 0.5, 0.5), CF(sx * 1.2, s.Y / 2 + 0.05, backZ), C.gold, smooth, SP)
	end
end

B.Clock = function(add, s, tint)
	local col = tint or C.darkWood
	add(V(s.X + 0.2, 0.5, s.Z + 0.2), CF(0, -s.Y / 2 + 0.25, 0), shade(col, 0.15))
	add(V(s.X - 0.4, s.Y * 0.62, s.Z - 0.2), CF(0, -s.Y * 0.14, 0), col)
	add(V(s.X - 1.1, s.Y * 0.42, 0.06), CF(0, -s.Y * 0.16, s.Z / 2 - 0.08), C.screen, glassM)
	add(V(0.12, s.Y * 0.26, 0.06), CF(0, -s.Y * 0.1, s.Z / 2 - 0.04), C.gold)
	add(V(0.1, 0.6, 0.6), CF(0, -s.Y * 0.23, s.Z / 2 - 0.03) * CFrame.Angles(0, rad(90), 0), C.gold, metalM, CY)
	roundTop(add, V(s.X, s.Y * 0.3, s.Z), CF(0, s.Y * 0.35, 0), light(col, 0.08))
	add(V(0.1, s.X * 0.72, s.X * 0.72), CF(0, s.Y * 0.33, s.Z / 2 + 0.03) * CFrame.Angles(0, rad(90), 0), C.gold, metalM, CY)
	add(V(0.1, s.X * 0.6, s.X * 0.6), CF(0, s.Y * 0.33, s.Z / 2 + 0.06) * CFrame.Angles(0, rad(90), 0), C.cream, smooth, CY)
	add(V(0.1, 0.55, 0.06), CF(0, s.Y * 0.33 + 0.22, s.Z / 2 + 0.12), C.print)
	add(V(0.4, 0.1, 0.06), CF(0.16, s.Y * 0.33, s.Z / 2 + 0.12), C.print)
end

B.Coffin = function(add, s, tint)
	local col = tint or rgb(110, 70, 58)
	add(V(s.X, s.Y * 0.8, s.Z), CF(0, -s.Y * 0.1, 0), col)
	bevel(add, V(s.X + 0.2, s.Y * 0.2, s.Z + 0.2), CF(0, s.Y * 0.4, 0), shade(col, 0.2), light(col, 0.1), 0.12)
	add(V(0.32, 0.08, 2.2), CF(0, s.Y / 2 + 0.03, -0.6), C.gold, metalM)
	add(V(1.4, 0.08, 0.32), CF(0, s.Y / 2 + 0.03, -1.1), C.gold, metalM)
	for _, sx in { -1, 1 } do
		for _, z in { -s.Z * 0.25, s.Z * 0.25 } do
			add(V(0.12, 0.2, 0.9), CF(sx * (s.X / 2 + 0.06), -s.Y * 0.05, z), C.gold, metalM)
		end
	end
end

B.Bookcase = function(add, s, tint)
	local col = tint or C.wood
	add(V(s.X - 0.4, s.Y - 0.3, 0.2), CF(0, 0, -s.Z / 2 + 0.1), shade(col, 0.25))
	for _, sx in { -1, 1 } do
		add(V(0.3, s.Y, s.Z), CF(sx * (s.X / 2 - 0.15), 0, 0), col)
	end
	bevel(add, V(s.X + 0.1, 0.32, s.Z + 0.1), CF(0, s.Y / 2 - 0.16, 0), col, light(col, 0.15), 0.1)
	local books = { C.red, C.blue, C.yellow, C.green, C.purple, C.teal, C.pink }
	local rows = 3
	local rowH = (s.Y - 0.6) / rows
	for row = 0, rows - 1 do
		local y = -s.Y / 2 + 0.15 + row * rowH
		add(V(s.X - 0.4, 0.26, s.Z), CF(0, y, 0), col)
		local x = -s.X / 2 + 0.4
		local i = row * 2
		while x < s.X / 2 - 1.1 do
			local w = 0.55 + (i % 3) * 0.18
			local h = rowH * (0.62 + (i % 4) * 0.07)
			add(V(w, h, s.Z - 0.5), CF(x + w / 2, y + 0.13 + h / 2, 0.1), books[i % #books + 1])
			x += w + 0.04
			i += 1
		end
	end
end

B.Washer = function(add, s, tint)
	local col = tint or C.white
	bevel(add, s - V(0.05, 0, 0.05), CF(), col, light(col, 0.4), 0.18)
	add(V(s.X - 0.1, 0.6, 0.06), CF(0, s.Y / 2 - 0.5, s.Z / 2 - 0.01), C.grey)
	add(V(0.1, 0.36, 0.36), CF(s.X * 0.3, s.Y / 2 - 0.5, s.Z / 2 + 0.03) * CFrame.Angles(0, rad(90), 0), C.dark, smooth, CY)
	add(V(s.X * 0.3, 0.16, 0.06), CF(-s.X * 0.18, s.Y / 2 - 0.5, s.Z / 2 + 0.02), C.teal, neon)
	add(V(0.12, s.X * 0.66, s.X * 0.66), CF(0, -0.3, s.Z / 2) * CFrame.Angles(0, rad(90), 0), C.metal, metalM, CY)
	add(V(0.14, s.X * 0.48, s.X * 0.48), CF(0, -0.3, s.Z / 2 + 0.02) * CFrame.Angles(0, rad(90), 0), C.screen, glassM, CY)
	add(V(0.06, 0.4, 0.12), CF(-0.25, -0.05, s.Z / 2 + 0.09) * CFrame.Angles(0, 0, rad(30)), C.glare)
end

-- Wooden crate: pale boards with darker framing planks and a diagonal brace.
B.Crate = function(add, s, tint)
	local col = tint or C.lightWood
	local plank = shade(col, 0.22)
	add(s - V(0.12, 0.12, 0.12), CF(), col)
	local t = 0.36
	for _, f in { 1, -1 } do
		-- framed front/back faces with a diagonal
		add(V(s.X, t, 0.1), CF(0, s.Y / 2 - t / 2, f * s.Z / 2), plank)
		add(V(s.X, t, 0.1), CF(0, -s.Y / 2 + t / 2, f * s.Z / 2), plank)
		add(V(t, s.Y, 0.1), CF(s.X / 2 - t / 2, 0, f * s.Z / 2), plank)
		add(V(t, s.Y, 0.1), CF(-s.X / 2 + t / 2, 0, f * s.Z / 2), plank)
		local d = math.sqrt((s.X - t) ^ 2 + (s.Y - t) ^ 2)
		add(V(d - 0.3, t * 0.9, 0.12), CF(0, 0, f * s.Z / 2) * CFrame.Angles(0, 0, f * math.atan2(s.Y - t, s.X - t)), plank)
	end
	-- top: framed edges along X plus board seams
	for _, sx in { -1, 1 } do
		add(V(t, 0.1, s.Z - 0.1), CF(sx * (s.X / 2 - t / 2), s.Y / 2, 0), plank)
	end
	for _, z in { -s.Z / 6, s.Z / 6 } do
		add(V(s.X - 2 * t, 0.04, 0.08), CF(0, s.Y / 2 - 0.04, z), plank)
	end
end
B.BigCrate = function(add, s, tint)
	B.Crate(add, s, tint or rgb(226, 184, 120))
	add(V(1.6, 0.7, 0.06), CF(0, 0.3, s.Z / 2 + 0.08), C.red)
	add(V(1.3, 0.12, 0.06), CF(0, 0.3, s.Z / 2 + 0.12), C.white)
	add(V(1.4, 0.06, 1.0), CF(s.X * 0.15, s.Y / 2 + 0.03, 0), C.red)
end

B.Barrel = function(add, s, tint)
	local col = tint or C.blue
	add(V(s.Y - 0.2, s.X * 0.92, s.X * 0.92), CF() * upright, col, smooth, CY)
	add(V(s.Y * 0.5, s.X, s.X), CF() * upright, col, smooth, CY)
	for _, y in { -s.Y * 0.33, s.Y * 0.33 } do
		add(V(0.24, s.X * 0.97, s.X * 0.97), CF(0, y, 0) * upright, C.dark, metalM, CY)
	end
	add(V(0.06, s.X * 0.8, s.X * 0.8), CF(0, s.Y / 2 - 0.08, 0) * upright, light(col, 0.2), smooth, CY)
	add(V(0.12, 0.4, 0.4), CF(s.X * 0.22, s.Y / 2 - 0.02, 0) * upright, C.dark, smooth, CY)
end

B.Mirror = function(add, s, tint)
	local col = tint or C.gold
	add(V(s.X, s.Y - 0.6, 0.35), CF(0, 0.3, 0), col, smooth, SP)
	local g = add(V(s.X - 0.45, s.Y - 1.1, 0.4), CF(0, 0.3, 0.02), rgb(196, 226, 242), glassM, SP)
	g.Reflectance = 0.25
	add(V(0.25, 1.4, 0.42), CF(-s.X * 0.18, 0.7, 0.04) * CFrame.Angles(0, 0, rad(-20)), C.white, smooth, SP)
	for _, sx in { -1, 1 } do
		add(V(0.3, 0.3, s.Z), CF(sx * s.X * 0.28, -s.Y / 2 + 0.15, 0), shade(col, 0.15))
	end
	add(V(0.3, 1, 0.3), CF(0, -s.Y / 2 + 0.6, 0), shade(col, 0.15))
end

B.Toolbox = function(add, s, tint)
	local col = tint or C.red
	bevel(add, V(s.X, s.Y - 0.45, s.Z), CF(0, -0.225, 0), col, light(col, 0.15), 0.12)
	add(V(s.X + 0.04, 0.2, s.Z + 0.04), CF(0, s.Y * 0.05, 0), shade(col, 0.2))
	for _, sx in { -1, 1 } do
		add(V(0.18, 0.4, 0.18), CF(sx * s.X * 0.22, s.Y / 2 - 0.25, 0), C.dark)
		add(V(0.3, 0.26, 0.06), CF(sx * s.X * 0.3, s.Y * 0.05, s.Z / 2 + 0.04), C.metal, metalM)
	end
	add(V(s.X * 0.5, 0.18, 0.22), CF(0, s.Y / 2 - 0.09, 0), C.dark)
end

B.Dresser = function(add, s, tint)
	local col = tint or C.lightWood
	local legH = 0.3
	bevel(add, V(s.X, s.Y - legH, s.Z), CF(0, legH / 2, 0), col, light(col, 0.18), 0.16)
	local inner = s.Y - legH - 0.5
	for row = 0, 2 do
		local h = inner / 3 - 0.12
		local y = -s.Y / 2 + legH + 0.2 + h / 2 + row * (inner / 3)
		add(V(s.X - 0.4, h, 0.1), CF(0, y, s.Z / 2 + 0.03), light(col, 0.12))
		for _, sx in { -1, 1 } do
			add(V(0.26, 0.26, 0.2), CF(sx * s.X * 0.22, y, s.Z / 2 + 0.1), C.gold, smooth, SP)
		end
	end
	legs(add, s, legH, 0.3, 0.3, C.darkWood, true)
	add(V(0.5, 0.9, 0.9), CF(s.X * 0.28, s.Y / 2 + 0.25, 0) * upright, C.teal, smooth, CY)
end

B.DeckChair = function(add, s, tint)
	local frame = C.lightWood
	local stripe = tint or C.blue
	local seatY = -s.Y / 2 + 0.9
	local seatL, seatZ = s.Z * 0.56, s.Z * 0.18
	-- backrest rises toward -Z from the back end of the seat
	local backL, tilt = s.Z * 0.42, rad(30)
	local z0 = seatZ - seatL / 2
	local backCF = CF(0, seatY + backL / 2 * math.sin(tilt), z0 - backL / 2 * math.cos(tilt)) * CFrame.Angles(tilt, 0, 0)
	-- sling: alternating stripes across the width
	local n = 5
	for i = 0, n - 1 do
		local w = s.X * 0.86 / n
		local x = -s.X * 0.43 + w / 2 + i * w
		local c = (i % 2 == 0) and stripe or C.white
		add(V(w, 0.12, seatL), CF(x, seatY, seatZ), c)
		add(V(w, 0.12, backL), backCF * CF(x, 0, 0), c)
	end
	for _, sx in { -1, 1 } do
		local x = sx * (s.X / 2 - 0.09)
		add(V(0.18, 0.22, seatL + 0.1), CF(x, seatY, seatZ), frame)
		add(V(0.18, 0.22, backL + 0.1), backCF * CF(x, 0, 0), frame)
	end
	legs(add, s, 0.8, 0.2, 0.2, frame)
end

B.Sunbed = function(add, s, tint)
	local frame = C.white
	local col = tint or C.yellow
	local seatY = -s.Y / 2 + 0.75
	local seatL, seatZ = s.Z * 0.62, s.Z * 0.19
	local backL, tilt = s.Z * 0.34, rad(22)
	local z0 = seatZ - seatL / 2
	local backCF = CF(0, seatY + backL / 2 * math.sin(tilt), z0 - backL / 2 * math.cos(tilt)) * CFrame.Angles(tilt, 0, 0)
	add(V(s.X, 0.3, seatL), CF(0, seatY, seatZ), frame)
	add(V(s.X, 0.3, backL), backCF, frame)
	softX(add, V(s.X - 0.3, 0.34, seatL - 0.1), CF(0, seatY + 0.3, seatZ), col)
	softX(add, V(s.X - 0.3, 0.34, backL - 0.1), backCF * CF(0, 0.3, 0), col)
	for _, z in { seatZ - seatL * 0.17, seatZ + seatL * 0.17 } do
		add(V(s.X - 0.28, 0.36, 0.3), CF(0, seatY + 0.31, z), C.white)
	end
	add(V(s.X - 0.8, 0.45, 1), backCF * CF(0, 0.6, -backL * 0.22), C.white, smooth, SP)
	legs(add, s, 0.6, 0.3, 0.25, C.grey)
end

B.Grill = function(add, s, tint)
	local col = tint or C.red
	local bodyY = s.Y / 2 - 1.15
	bevel(add, V(s.X * 0.7, 1, s.Z), CF(0, bodyY, 0), shade(col, 0.1), nil, 0.1)
	add(V(s.X * 0.7, s.Z, s.Z), CF(0, bodyY + 0.5, 0), col, smooth, CY) -- rounded hood
	add(V(s.X * 0.72, 0.15, s.Z * 0.6), CF(0, bodyY + 0.5 + s.Z / 2 - 0.02, 0), light(col, 0.2))
	add(V(0.2, 0.2, s.Z * 0.5), CF(0, bodyY + 0.6, s.Z / 2 + 0.1), C.dark)
	for _, sx in { -1, 1 } do
		add(V(s.X * 0.15, 0.15, s.Z * 0.8), CF(sx * s.X * 0.42, bodyY - 0.1, 0), C.lightWood)
	end
	local legH = s.Y - 1.65
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			add(V(0.2, legH, 0.2), CF(sx * s.X * 0.28, -s.Y / 2 + legH / 2, sz * (s.Z / 2 - 0.3)), C.dark)
		end
		add(V(0.2, 0.5, 0.5), CF(sx * s.X * 0.32, -s.Y / 2 + 0.25, s.Z / 2 - 0.3), C.dark, smooth, CY)
	end
	add(V(s.X * 0.5, 0.12, s.Z - 0.6), CF(0, -s.Y / 2 + 0.8, 0), C.grey)
end

B.Cooler = function(add, s, tint)
	local col = tint or C.blue
	add(V(s.X, s.Y - 0.45, s.Z), CF(0, -0.225, 0), col)
	bevel(add, V(s.X + 0.1, 0.45, s.Z + 0.1), CF(0, s.Y / 2 - 0.225, 0), C.white, nil, 0.12)
	add(V(s.X * 0.4, 0.12, 0.3), CF(0, s.Y / 2 + 0.05, 0), light(col, 0.2))
	for _, sx in { -1, 1 } do
		add(V(0.12, 0.3, 0.7), CF(sx * (s.X / 2 + 0.06), s.Y * 0.05, 0), C.white)
	end
	add(V(s.X * 0.5, 0.25, 0.04), CF(0, -0.3, s.Z / 2 + 0.02), C.white)
end

local MassScale = FurnitureData.MassScale

-- Builds a furniture model. The returned model's PrimaryPart "Body" is the only collider.
function FurnitureModels.Build(kind: string, tint: Color3?): Model
	local data = FurnitureData.Get(kind)
	local s = data.Size
	local model = Instance.new("Model")
	model.Name = kind

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = s
	body.Transparency = 1
	body.CanCollide = true
	body.CanTouch = true
	body.CanQuery = true
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	local volume = s.X * s.Y * s.Z
	local density = math.clamp(data.Mass * MassScale / volume, 0.02, 99)
	body.CustomPhysicalProperties = PhysicalProperties.new(density, data.Friction or 0.45, data.Elasticity or 0.12, 1, 1)
	body.Parent = model
	model.PrimaryPart = body

	local function add(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = "Look"
		p.Size = size
		if shape == SP then
			Shapes.Ball(p)
		elseif shape then
			p.Shape = shape
		end
		p.CFrame = body.CFrame * cf
		p.Color = color
		p.Material = material or smooth
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		p.Parent = model
		return p
	end

	local builder = B[kind]
	if builder then
		builder(add, s, tint)
	else
		add(s, CF(), tint or C.wood, smooth)
	end
	return model
end

function FurnitureModels.Has(kind: string): boolean
	return B[kind] ~= nil
end

return FurnitureModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">FxService</string>
          <string name="Source"><![CDATA[--[[
	FxService.luau
	Server -> client presentation events (sounds, particles, toasts, results).
	Gameplay never depends on these; they only describe what already happened.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)

local FxService = {}

function FxService.All(kind: string, data: any?)
	Net.Fx:FireAllClients(kind, data or {})
end

function FxService.To(player: Player, kind: string, data: any?)
	Net.Fx:FireClient(player, kind, data or {})
end

function FxService.Sound(name: string, pos: Vector3?)
	Net.Fx:FireAllClients("Sound", { Name = name, Pos = pos })
end

function FxService.Toast(player: Player, text: string)
	Net.Fx:FireClient(player, "Toast", { Text = text })
end

return FxService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Hazards</string>
          <string name="Source"><![CDATA[--[[
	Hazards.luau
	Environmental hazards and moving surfaces, built from a level's Hazards list:

	  Water     { Kind="Water", Min={x,z}, Max={x,z}, Depth? }  pool / river basin. Movers
	            respawn, furniture is recovered (same item) after a splash.
	  Conveyor  { Kind="Conveyor", Min, Max, Dir={x,z}, Speed }  an anchored belt whose
	            surface velocity physically carries movers and furniture.
	  Platform  { Kind="Platform", Path={{x,y,z},...}, Size={x,y,z}, Speed, Wait }  a raft /
	            lift that ping-pongs along a path; moved kinematically with a matching
	            surface velocity so things standing on it ride along.
	  Traffic   { Kind="Traffic", A={x,z}, B={x,z}, Interval={min,max}, Width? }  cars drive
	            down a visible lane after a flashing, honking warning. A hit knocks and
	            briefly stuns movers and knocks furniture; nothing is ever deleted.
	  Ghost     { Kind="Ghost", Patrol={{x,z},...} }  wanders a patrol loop, rears up when
	            it notices a mover, chases briefly, spooks (stun + drop) and then backs
	            off. A slap stuns it.
	"Reduced hazards" assist: longer gaps between cars, slower ghosts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local S = require(script.Parent.Services)
local Shapes = require(ReplicatedStorage.Shared.Shapes)

local Hazards = {}

local V = Vector3.new
local CF = CFrame.new

type Water = { Min: Vector3, Max: Vector3, Surface: number }
local waters: { Water } = {}
local platforms: { any } = {}
local lanes: { any } = {}
local ghosts: { any } = {}
local folder: Folder? = nil
local rng = Random.new()

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): Part
	local p = Instance.new("Part")
	p.Name = name or "Hazard"
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function v2(t: any): Vector2
	return Vector2.new(t[1], t[2])
end

local function scale(): (number, number)
	if S.World.Assists.ReducedHazards then
		return Config.Hazards.ReducedIntervalScale, Config.Hazards.ReducedSpeedScale
	end
	return 1, 1
end

----------------------------------------------------------------------------------------
-- Water

local function buildWater(h: any, parent: Instance)
	local min, max = v2(h.Min), v2(h.Max)
	local depth = h.Depth or 5
	local size = max - min
	local centre = (min + max) / 2
	local tile = h.EdgeColor or Color3.fromRGB(236, 240, 244)
	-- basin floor and walls
	part(parent, V(size.X, 1, size.Y), CF(centre.X, -depth - 0.5, centre.Y), h.FloorColor or Color3.fromRGB(80, 170, 210), Enum.Material.CeramicTiles, "PoolFloor")
	for _, side in { { V(size.X, depth, 0.6), V(0, 0, -size.Y / 2 - 0.3) }, { V(size.X, depth, 0.6), V(0, 0, size.Y / 2 + 0.3) }, { V(0.6, depth, size.Y + 1.2), V(-size.X / 2 - 0.3, 0, 0) }, { V(0.6, depth, size.Y + 1.2), V(size.X / 2 + 0.3, 0, 0) } } do
		part(parent, side[1], CF(centre.X, -depth / 2, centre.Y) + side[2], tile, Enum.Material.CeramicTiles, "PoolWall")
	end
	-- coping (rim) so the edge reads clearly
	if h.Coping ~= false then
		for _, side in { { V(size.X + 2.4, 0.3, 1.2), V(0, 0, -size.Y / 2 - 0.6) }, { V(size.X + 2.4, 0.3, 1.2), V(0, 0, size.Y / 2 + 0.6) }, { V(1.2, 0.3, size.Y), V(-size.X / 2 - 0.6, 0, 0) }, { V(1.2, 0.3, size.Y), V(size.X / 2 + 0.6, 0, 0) } } do
			local c = part(parent, side[1], CF(centre.X, 0.1, centre.Y) + side[2], tile, Enum.Material.SmoothPlastic, "Coping")
			c:SetAttribute("Ground", true)
		end
	end
	local surfaceY = -(h.SurfaceDrop or 0.9)
	local water = part(parent, V(size.X, 0.4, size.Y), CF(centre.X, surfaceY, centre.Y), h.Color or Color3.fromRGB(70, 180, 235), Enum.Material.Glass, "Water")
	water.Transparency = 0.35
	water.CanCollide = false
	water.CanQuery = false
	water.CanTouch = false
	water:SetAttribute("Water", true)
	table.insert(waters, { Min = V(min.X, 0, min.Y), Max = V(max.X, 0, max.Y), Surface = surfaceY })
end

-- True when a position is under a water surface (movers / items get recovered).
function Hazards.InWater(pos: Vector3): boolean
	for _, w in waters do
		if pos.X > w.Min.X and pos.X < w.Max.X and pos.Z > w.Min.Z and pos.Z < w.Max.Z and pos.Y < w.Surface - 0.2 then
			return true
		end
	end
	return false
end

-- Rectangles of water, so LevelBuilder can leave holes in the ground for them.
function Hazards.WaterRects(level: any): { { Min: Vector2, Max: Vector2 } }
	local list = {}
	for _, h in level.Hazards or {} do
		if h.Kind == "Water" then
			table.insert(list, { Min = v2(h.Min), Max = v2(h.Max) })
		end
	end
	return list
end

----------------------------------------------------------------------------------------
-- Conveyors

local function buildConveyor(h: any, parent: Instance)
	local min, max = v2(h.Min), v2(h.Max)
	local size = max - min
	local centre = (min + max) / 2
	local dir = Vector3.new(h.Dir[1], 0, h.Dir[2]).Unit
	local belt = part(parent, V(size.X, 0.5, size.Y), CF(centre.X, -0.13, centre.Y), Color3.fromRGB(60, 62, 70), Enum.Material.Fabric, "Conveyor")
	belt.CustomPhysicalProperties = PhysicalProperties.new(1, 1.2, 0, 1, 1)
	belt.AssemblyLinearVelocity = dir * (h.Speed or 8)
	belt:SetAttribute("BeltVelocity", dir * (h.Speed or 8))
	belt:SetAttribute("Ground", true)
	belt:SetAttribute("Conveyor", true)
	-- yellow side rails (low, decorative edges) and chevrons showing the direction
	local alongX = math.abs(dir.X) > 0.5
	local len = alongX and size.X or size.Y
	local n = math.max(1, math.floor(len / 4))
	local yaw = math.atan2(-dir.X, -dir.Z)
	for i = 0, n - 1 do
		local t = (i + 0.5) / n - 0.5
		local pos = alongX and V(centre.X + t * size.X, 0.14, centre.Y) or V(centre.X, 0.14, centre.Y + t * size.Y)
		for _, s in { -1, 1 } do
			local arm = part(parent, V(0.35, 0.05, 1.6), CF(pos) * CFrame.Angles(0, yaw, 0) * CF(s * 0.5, 0, 0) * CFrame.Angles(0, math.rad(s * 40), 0), Color3.fromRGB(250, 210, 60), Enum.Material.Neon, "Chevron")
			arm.CanCollide = false
			arm.CanQuery = false
			arm.CanTouch = false
		end
	end
	for _, s in { -1, 1 } do
		local railPos = alongX and V(centre.X, 0.05, centre.Y + s * (size.Y / 2 + 0.25)) or V(centre.X + s * (size.X / 2 + 0.25), 0.05, centre.Y)
		local railSize = alongX and V(size.X, 0.35, 0.5) or V(0.5, 0.35, size.Y)
		local rail = part(parent, railSize, CF(railPos), Color3.fromRGB(250, 200, 50), Enum.Material.SmoothPlastic, "ConveyorRail")
		rail.CanCollide = false
	end
end

----------------------------------------------------------------------------------------
-- Moving platforms

local function buildPlatform(h: any, parent: Instance)
	local s = h.Size or { 8, 1, 8 }
	local size = V(s[1], s[2], s[3])
	local path = {}
	for _, p in h.Path do
		table.insert(path, V(p[1], p[2], p[3]))
	end
	local p = part(parent, size, CF(path[1]), h.Color or Color3.fromRGB(250, 140, 170), Enum.Material.SmoothPlastic, "Platform")
	p.CustomPhysicalProperties = PhysicalProperties.new(1, 1.5, 0, 1, 1)
	p:SetAttribute("Ground", true)
	-- inflatable ring look
	for _, side in { { V(size.X, 1, 1), V(0, 0.6, size.Z / 2 - 0.5) }, { V(size.X, 1, 1), V(0, 0.6, -size.Z / 2 + 0.5) }, { V(1, 1, size.Z), V(size.X / 2 - 0.5, 0.6, 0) }, { V(1, 1, size.Z), V(-size.X / 2 + 0.5, 0.6, 0) } } do
		local rim = part(parent, side[1], p.CFrame + side[2], Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, "PlatformRim")
		rim.CanCollide = false
		rim.CanQuery = false
		local w = Instance.new("WeldConstraint")
		w.Part0 = p
		w.Part1 = rim
		w.Parent = rim
		rim.Anchored = false
		rim.Massless = true
	end
	table.insert(platforms, { Part = p, Path = path, Speed = h.Speed or 6, Wait = h.Wait or 1.5, Index = 1, Dir = 1, WaitLeft = h.Wait or 1.5 })
end

local function stepPlatforms(dt: number)
	for _, pl in platforms do
		local p: Part = pl.Part
		if pl.WaitLeft > 0 then
			pl.WaitLeft -= dt
			p.AssemblyLinearVelocity = Vector3.zero
			continue
		end
		local nextIndex = pl.Index + pl.Dir
		if nextIndex < 1 or nextIndex > #pl.Path then
			pl.Dir = -pl.Dir
			nextIndex = pl.Index + pl.Dir
		end
		local target = pl.Path[nextIndex]
		local pos = p.Position
		local delta = target - pos
		local stepLen = pl.Speed * dt
		if delta.Magnitude <= stepLen then
			p.CFrame = CF(target)
			p.AssemblyLinearVelocity = Vector3.zero
			pl.Index = nextIndex
			pl.WaitLeft = pl.Wait
		else
			local v = delta.Unit * pl.Speed
			p.CFrame = CF(pos + delta.Unit * stepLen)
			p.AssemblyLinearVelocity = v
		end
	end
end

----------------------------------------------------------------------------------------
-- Traffic

local function buildCar(parent: Instance, color: Color3): Model
	local m = Instance.new("Model")
	m.Name = "Car"
	local body = part(m, V(5.6, 2.4, 9), CF(0, 1.9, 0), color, Enum.Material.SmoothPlastic, "CarBody")
	body.CanCollide = false
	m.PrimaryPart = body
	local cab = part(m, V(5, 2, 5), CF(0, 4, 0.5), color:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.SmoothPlastic, "CarCab")
	cab.CanCollide = false
	local glass = part(m, V(4.6, 1.6, 5.1), CF(0, 4.05, 0.5), Color3.fromRGB(150, 200, 230), Enum.Material.Glass, "CarGlass")
	glass.Transparency = 0.3
	glass.CanCollide = false
	for _, x in { -2.6, 2.6 } do
		for _, z in { -3, 3 } do
			local w = part(m, V(1, 2, 2), CF(x, 1, z), Color3.fromRGB(30, 30, 34), Enum.Material.SmoothPlastic, "Wheel")
			w.Shape = Enum.PartType.Cylinder
			w.CanCollide = false
		end
	end
	for _, x in { -1.8, 1.8 } do
		local light = part(m, V(1, 0.6, 0.2), CF(x, 2.3, -4.5), Color3.fromRGB(255, 250, 200), Enum.Material.Neon, "Headlight")
		light.CanCollide = false
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	m.Parent = parent
	return m
end

local CAR_COLORS = {
	Color3.fromRGB(80, 140, 230),
	Color3.fromRGB(240, 200, 60),
	Color3.fromRGB(120, 200, 120),
	Color3.fromRGB(230, 120, 60),
	Color3.fromRGB(180, 110, 210),
}

local function buildLane(h: any, parent: Instance)
	local a = V(h.A[1], 0, h.A[2])
	local b = V(h.B[1], 0, h.B[2])
	local dir = (b - a).Unit
	local width = h.Width or 7
	local lights = {}
	-- warning lamps along both kerbs
	local len = (b - a).Magnitude
	local n = math.max(2, math.floor(len / 12))
	local side = Vector3.new(-dir.Z, 0, dir.X)
	for i = 0, n do
		local p = a + dir * (i / n * len)
		for _, s in { -1, 1 } do
			local lamp = part(parent, V(0.8, 0.5, 0.8), CF(p + side * s * (width / 2 + 0.6) + V(0, 0.25, 0)), Color3.fromRGB(120, 60, 40), Enum.Material.SmoothPlastic, "WarnLamp")
			lamp.CanCollide = false
			table.insert(lights, lamp)
		end
	end
	local interval = h.Interval or { 6, 10 }
	table.insert(lanes, {
		A = a,
		B = b,
		Dir = dir,
		Width = width,
		Lights = lights,
		Interval = interval,
		Next = rng:NextNumber(interval[1], interval[2]),
		State = "Idle",
		Timer = 0,
		Car = nil :: Model?,
		Parent = parent,
		Hit = {} :: { [Instance]: boolean },
	})
end

local function setLights(lane: any, on: boolean)
	for _, l in lane.Lights do
		l.Color = on and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(120, 60, 40)
		l.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
end

local function carHits(lane: any, car: Model)
	local body = car.PrimaryPart :: BasePart
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { car }
	local hits = Workspace:GetPartBoundsInBox(body.CFrame + V(0, 0.8, 0), V(6, 5, 9.5), params)
	for _, p in hits do
		local m = p:FindFirstAncestorOfClass("Model")
		if not m then
			continue
		end
		local player = Players:GetPlayerFromCharacter(m)
		if player and not lane.Hit[player] and not S.Players.IsProtected(player) then
			lane.Hit[player] = true
			local away = (p.Position - body.Position) * V(1, 0, 1)
			local push = lane.Dir * Config.Hazards.CarKnock + (away.Magnitude > 0.1 and away.Unit * 20 or Vector3.zero) + V(0, 30, 0)
			S.Players.Stun(player, Config.Stun.CarHit, true)
			S.Players.Knock(player, push)
			S.Fx.All("Sound", { Name = "CarHit", Pos = p.Position })
		elseif m:GetAttribute("ItemId") and p.Name == "Body" and not lane.Hit[m] then
			lane.Hit[m] = true
			S.Carry.ReleaseItem(m, "knock")
			pcall(function()
				p:SetNetworkOwner(nil)
			end)
			local push = Config.Hazards.ItemKnock / math.max(1, p.AssemblyMass / 10)
			p.AssemblyLinearVelocity = lane.Dir * push + V(0, push * 0.5, 0)
			S.Fx.All("Sound", { Name = "CarHit", Pos = p.Position })
			task.delay(1.5, function()
				if p.Parent and not S.Carry.IsHeld(m) and not p.Anchored then
					pcall(function()
						p:SetNetworkOwnershipAuto()
					end)
				end
			end)
		end
	end
end

local function stepLanes(dt: number)
	local intervalScale, speedScale = scale()
	for _, lane in lanes do
		if lane.State == "Idle" then
			lane.Next -= dt
			if lane.Next <= 0 then
				lane.State = "Warn"
				lane.Timer = Config.Hazards.CarWarnTime
				S.Fx.All("Honk", { Pos = lane.A + V(0, 2, 0) })
			end
		elseif lane.State == "Warn" then
			lane.Timer -= dt
			setLights(lane, math.floor(lane.Timer * 6) % 2 == 0)
			if lane.Timer <= 0 then
				setLights(lane, true)
				local car = buildCar(lane.Parent, CAR_COLORS[rng:NextInteger(1, #CAR_COLORS)])
				local yaw = math.atan2(-lane.Dir.X, -lane.Dir.Z)
				car:PivotTo(CF(lane.A) * CFrame.Angles(0, yaw, 0))
				lane.Car = car
				lane.Dist = 0
				lane.State = "Drive"
				table.clear(lane.Hit)
			end
		elseif lane.State == "Drive" then
			local car = lane.Car :: Model
			local total = (lane.B - lane.A).Magnitude
			lane.Dist += Config.Hazards.CarSpeed * speedScale * dt
			local yaw = math.atan2(-lane.Dir.X, -lane.Dir.Z)
			car:PivotTo(CF(lane.A + lane.Dir * lane.Dist) * CFrame.Angles(0, yaw, 0))
			carHits(lane, car)
			if lane.Dist >= total then
				car:Destroy()
				lane.Car = nil
				lane.State = "Idle"
				setLights(lane, false)
				lane.Next = rng:NextNumber(lane.Interval[1], lane.Interval[2]) * intervalScale
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- Ghosts

local function buildGhost(parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = "Ghost"
	m:SetAttribute("Ghost", true)
	local body = part(m, V(3.4, 4, 3.4), CF(0, 0, 0), Color3.fromRGB(236, 240, 255), Enum.Material.SmoothPlastic, "GhostBody")
	Shapes.Ball(body)
	body.Transparency = 0.2
	body.CanCollide = false
	body:SetAttribute("Ghost", true)
	m.PrimaryPart = body
	local tail = part(m, V(2.6, 2.2, 2.6), CF(0, -2, 0), Color3.fromRGB(236, 240, 255), Enum.Material.SmoothPlastic, "GhostTail")
	Shapes.Ball(tail)
	tail.Transparency = 0.35
	tail.CanCollide = false
	for _, x in { -0.65, 0.65 } do
		local eye = part(m, V(0.6, 0.9, 0.3), CF(x, 0.4, -1.55), Color3.fromRGB(30, 30, 50), Enum.Material.SmoothPlastic, "GhostEye")
		Shapes.Ball(eye)
		eye.CanCollide = false
	end
	local mouth = part(m, V(0.8, 0.6, 0.3), CF(0, -0.5, -1.55), Color3.fromRGB(30, 30, 50), Enum.Material.SmoothPlastic, "GhostMouth")
	Shapes.Ball(mouth)
	mouth.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 200, 255)
	light.Range = 12
	light.Brightness = 1.5
	light.Parent = body
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanTouch = false
		end
	end
	m.Parent = parent
	return m
end

local function buildGhostHazard(h: any, parent: Instance)
	local patrol = {}
	for _, p in h.Patrol do
		table.insert(patrol, V(p[1], 4.2, p[2]))
	end
	local m = buildGhost(parent)
	m:PivotTo(CF(patrol[1]))
	table.insert(ghosts, { Model = m, Patrol = patrol, Index = 1, State = "Wander", Timer = 0, Target = nil :: Player?, Pos = patrol[1] })
end

function Hazards.StunGhost(model: Instance)
	for _, g in ghosts do
		if g.Model == model and g.State ~= "Stunned" then
			g.State = "Stunned"
			g.Timer = Config.Slap.GhostStun
			g.Model:SetAttribute("State", "Stunned")
			S.Fx.All("GhostStun", { Pos = g.Pos })
		end
	end
end

local function nearestMover(pos: Vector3, range: number): (Player?, number)
	local best, bestD = nil, range
	for _, p in S.Players.Movers() do
		local r = S.Players.Root(p)
		if r and not S.Players.IsStunned(p) and not S.Players.IsProtected(p) then
			local d = ((r.Position - pos) * V(1, 0, 1)).Magnitude
			if d < bestD then
				best, bestD = p, d
			end
		end
	end
	return best, bestD
end

local function stepGhosts(dt: number)
	local _, speedScale = scale()
	local t = S.World.SimTime
	for _, g in ghosts do
		local pos: Vector3 = g.Pos
		local moveTo: Vector3? = nil
		local speed = Config.Hazards.GhostSpeed * speedScale
		if g.State == "Stunned" or g.State == "Cooldown" then
			g.Timer -= dt
			if g.State == "Cooldown" then
				moveTo = g.Patrol[g.Index]
			end
			if g.Timer <= 0 then
				g.State = "Wander"
			end
		elseif g.State == "Wander" then
			moveTo = g.Patrol[g.Index]
			local target = nearestMover(pos, Config.Hazards.GhostNotice)
			if target then
				g.State = "Notice"
				g.Timer = 0.7 -- anticipation: it rears up before chasing
				g.Target = target
				S.Fx.All("Ghost", { Pos = pos })
			end
		elseif g.State == "Notice" then
			g.Timer -= dt
			if g.Timer <= 0 then
				g.State = "Chase"
				g.Timer = 3
			end
		elseif g.State == "Chase" then
			g.Timer -= dt
			local target = g.Target
			local r = target and S.Players.Root(target)
			if not r or g.Timer <= 0 or S.Players.IsStunned(target :: Player) then
				g.State = "Cooldown"
				g.Timer = Config.Hazards.GhostCooldown * 0.5
			else
				moveTo = V(r.Position.X, 4.2, r.Position.Z)
				speed = Config.Hazards.GhostChaseSpeed * speedScale
				if ((r.Position - pos) * V(1, 0, 1)).Magnitude < 2.8 then
					S.Players.Stun(target :: Player, Config.Stun.GhostSpook, true)
					S.Players.Knock(target :: Player, ((r.Position - pos) * V(1, 0, 1)).Unit * 20 + V(0, 18, 0))
					S.Fx.All("Spook", { Pos = r.Position, UserId = (target :: Player).UserId })
					g.State = "Cooldown"
					g.Timer = Config.Hazards.GhostCooldown
				end
			end
		end
		if moveTo then
			local delta = (moveTo - pos) * V(1, 0, 1)
			if delta.Magnitude < 0.6 and g.State == "Wander" then
				g.Index = g.Index % #g.Patrol + 1
			elseif delta.Magnitude > 0.01 then
				pos += delta.Unit * math.min(delta.Magnitude, speed * dt)
			end
		end
		g.Pos = pos
		local bob = math.sin(t * 2.4 + g.Index) * 0.35
		local rear = g.State == "Notice" and 1.4 or 0
		local look = moveTo and ((moveTo - pos) * V(1, 0, 1)) or Vector3.zero
		local facing = look.Magnitude > 0.1 and CFrame.lookAt(pos, pos + look) or (g.Model.PrimaryPart :: BasePart).CFrame.Rotation + pos
		g.Model:PivotTo(facing.Rotation + pos + V(0, bob + rear, 0))
		g.Model:SetAttribute("State", g.State)
		local body = g.Model.PrimaryPart :: BasePart
		body.Transparency = (g.State == "Stunned" or g.State == "Cooldown") and 0.65 or 0.2
	end
end

----------------------------------------------------------------------------------------

function Hazards.Build(level: any, parent: Instance)
	Hazards.Clear()
	local f = Instance.new("Folder")
	f.Name = "Hazards"
	f.Parent = parent
	folder = f
	for _, h in level.Hazards or {} do
		if h.Kind == "Water" then
			buildWater(h, f)
		elseif h.Kind == "Conveyor" then
			buildConveyor(h, f)
		elseif h.Kind == "Platform" then
			buildPlatform(h, f)
		elseif h.Kind == "Traffic" then
			buildLane(h, f)
		elseif h.Kind == "Ghost" then
			buildGhostHazard(h, f)
		else
			warn("Hazards: unknown kind " .. tostring(h.Kind))
		end
	end
end

function Hazards.Clear()
	table.clear(waters)
	table.clear(platforms)
	table.clear(lanes)
	table.clear(ghosts)
	if folder then
		folder:Destroy()
	end
	folder = nil
end

-- Only runs while gameplay is active and not paused (simulation time).
function Hazards.Step(dt: number)
	stepPlatforms(dt)
	stepLanes(dt)
	stepGhosts(dt)
end

-- Stop moving surfaces while paused (conveyors keep their belt velocity but everything
-- on them is anchored, so nothing moves).
function Hazards.SetFrozen(frozen: boolean)
	for _, pl in platforms do
		pl.Part.AssemblyLinearVelocity = Vector3.zero
	end
	if folder then
		for _, d in folder:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Conveyor") then
				d.AssemblyLinearVelocity = frozen and Vector3.zero or d:GetAttribute("BeltVelocity") or d.AssemblyLinearVelocity
			end
		end
	end
end

return Hazards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[--[[
	ItemService.luau
	Owns the furniture of the loaded level after LevelBuilder creates it: recovery when an
	item falls in water or out of the world (same model, same id, never a duplicate),
	impact sounds, and the "delivered furniture disappears" assist.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureData = require(ReplicatedStorage.Shared.FurnitureData)
local S = require(script.Parent.Services)

local ItemService = {}

local connections: { RBXScriptConnection } = {}
local lastImpact: { [Model]: number } = {}
local lastGlobalImpact = 0

local function level()
	return S.World.Level
end

-- Finds a free spot for an item near its home: tries the home, then raised and offset.
local function clearSpot(model: Model, home: CFrame): CFrame
	local body = model.PrimaryPart :: BasePart
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model }
	local size = body.Size - Vector3.new(0.3, 0.3, 0.3)
	local offsets = {
		Vector3.zero,
		Vector3.new(0, 1, 0),
		Vector3.new(body.Size.X + 1, 0, 0),
		Vector3.new(-body.Size.X - 1, 0, 0),
		Vector3.new(0, 0, body.Size.Z + 1),
		Vector3.new(0, 0, -body.Size.Z - 1),
	}
	for i = 1, math.min(#offsets, Config.Recovery.ClearanceTries) do
		local cf = home + offsets[i]
		local hits = Workspace:GetPartBoundsInBox(cf, size, params)
		local blocked = false
		for _, h in hits do
			if h.CanCollide and not h:GetAttribute("Ground") then
				blocked = true
				break
			end
		end
		if not blocked then
			return cf
		end
	end
	-- last resort: drop it from above its home
	return home + Vector3.new(0, body.Size.Y + 4, 0)
end

function ItemService.Recover(model: Model, splash: boolean)
	if model:GetAttribute("Recovering") then
		return
	end
	local body = model.PrimaryPart
	local lvl = level()
	if not body or not lvl then
		return
	end
	model:SetAttribute("Recovering", true)
	S.Carry.ReleaseItem(model, "recover")
	S.Fx.All(splash and "Splash" or "Poof", { Pos = body.Position, Item = model.Name })
	body.Anchored = true
	task.delay(Config.Recovery.ItemDelay, function()
		if not model.Parent or level() ~= lvl then
			return
		end
		local home = lvl.ItemHomes[model.Name] or body.CFrame
		local cf = clearSpot(model, home)
		model:PivotTo(cf)
		body.AssemblyLinearVelocity = Vector3.zero
		body.AssemblyAngularVelocity = Vector3.zero
		if not S.World.Paused then
			body.Anchored = false
		end
		model:SetAttribute("Recovering", false)
		S.Fx.All("Poof", { Pos = cf.Position, Item = model.Name })
	end)
end

-- Delivered + assist on: the item fades out and stays counted.
function ItemService.Vanish(model: Model)
	if model:GetAttribute("Vanished") then
		return
	end
	model:SetAttribute("Vanished", true)
	S.Carry.ReleaseItem(model, "vanish")
	local body = model.PrimaryPart
	S.Fx.All("Vanish", { Item = model.Name, Pos = body and body.Position })
	task.delay(0.4, function()
		if model:GetAttribute("Vanished") then
			model.Parent = nil
		end
	end)
end

function ItemService.Step()
	local lvl = level()
	if not lvl or S.World.Paused then
		return
	end
	local bmin, bmax = lvl.Bounds.Min, lvl.Bounds.Max
	for _, model in lvl.Items do
		local body = model.PrimaryPart
		if not body or not model.Parent or model:GetAttribute("Recovering") then
			continue
		end
		local p = body.Position
		local out = p.Y < Config.Recovery.KillY or p.X < bmin.X or p.X > bmax.X or p.Z < bmin.Z or p.Z > bmax.Z
		local wet = S.Hazards.InWater(p)
		if out or wet then
			ItemService.Recover(model, wet)
		end
	end
end

local function hookImpacts(model: Model)
	local body = model.PrimaryPart
	if not body then
		return
	end
	local data = FurnitureData.Kinds[model:GetAttribute("Kind") or ""]
	local soundFamily = data and data.Sound or "Wood"
	local soundName = ({ Wood = "ImpactWood", Soft = "ImpactSoft", Metal = "ImpactMetal", Glass = "ImpactWood" })[soundFamily]
	if data and data.Class == "Heavy" then
		soundName = "ImpactHeavy"
	end
	table.insert(
		connections,
		body.Touched:Connect(function(other)
			if not other.CanCollide then
				return
			end
			local speed = body.AssemblyLinearVelocity.Magnitude
			if speed < Config.SoundRules.ImpactMinSpeed then
				return
			end
			local t = os.clock()
			if (lastImpact[model] and t - lastImpact[model] < Config.SoundRules.ImpactGap) or t - lastGlobalImpact < Config.SoundRules.GlobalImpactGap then
				return
			end
			lastImpact[model] = t
			lastGlobalImpact = t
			S.Fx.All("Impact", { Pos = body.Position, Sound = soundName, Speed = speed })
			if other:GetAttribute("Breakable") then
				S.Breakables.Hit(other, "Impact", body.Position, speed)
			end
		end)
	)
end

-- Called once per loaded level, after LevelBuilder.Build.
function ItemService.Attach()
	ItemService.Detach()
	local lvl = level()
	if not lvl then
		return
	end
	for _, model in lvl.Items do
		hookImpacts(model)
	end
end

function ItemService.Detach()
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	table.clear(lastImpact)
end

-- Anchors / unanchors every item for pause, keeping their velocities.
local savedVel: { [BasePart]: { Vector3 } } = {}
function ItemService.SetFrozen(frozen: boolean)
	local lvl = level()
	if not lvl then
		return
	end
	for _, model in lvl.Items do
		local body = model.PrimaryPart
		if body and model.Parent and not model:GetAttribute("Recovering") then
			if frozen then
				savedVel[body] = { body.AssemblyLinearVelocity, body.AssemblyAngularVelocity }
				body.Anchored = true
			else
				body.Anchored = false
				local v = savedVel[body]
				if v then
					body.AssemblyLinearVelocity = v[1]
					body.AssemblyAngularVelocity = v[2]
				end
			end
		end
	end
	if not frozen then
		table.clear(savedVel)
	end
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">JobManager</string>
          <string name="Source"><![CDATA[--[[
	JobManager.luau
	The shared game state machine (one per server, all movers play together):

	  Lobby      the depot yard: practice grabbing / throwing; the host picks a job
	  Briefing   the job is loaded, movers wait at their spawns, objective + controls shown
	  Countdown  3-2-1, then the timer starts
	  Playing    the timer runs; every required item must be in the truck
	  Results    time, award, best time; host chooses replay / next job / job board
	  (Paused is a flag on top of Playing: simulation, timer and hazards freeze)

	Loading a level always destroys the previous one first, so restarts can't duplicate
	parts, constraints or listeners. Gameplay time (SimTime) only advances while active
	and unpaused; the job timer only while Playing.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Jobs = require(ReplicatedStorage.Shared.Jobs)
local Net = require(ReplicatedStorage.Shared.Net)
local S = require(script.Parent.Services)
local LevelBuilder = require(script.Parent.LevelBuilder)

local JobManager = {}

local phase: string = "Lobby"
local job: any = nil
local timerAccum = 0
local timerRunning = false
local token = 0 -- bumps on every load so stale delayed callbacks do nothing
local lightingDefaults: { [string]: any } = {}
local savedRoots: { [BasePart]: Vector3 } = {}

local function state(): Folder
	return Net.State()
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

function JobManager.Phase(): string
	return phase
end

function JobManager.Job(): any
	return job
end

local function setPhase(p: string)
	phase = p
	state():SetAttribute("Phase", p)
end

local function publishTimer()
	local st = state()
	st:SetAttribute("TimerRunning", timerRunning)
	st:SetAttribute("TimerValue", timerAccum)
	st:SetAttribute("TimerOrigin", serverNow() - timerAccum)
end

local function applyLighting(data: any)
	for key, value in lightingDefaults do
		(Lighting :: any)[key] = value
	end
	for key, value in data.Lighting or {} do
		pcall(function()
			(Lighting :: any)[key] = value
		end)
	end
end

local function unload()
	token += 1
	S.Carry.ReleaseAll()
	S.Items.Detach()
	S.Hazards.Clear()
	if S.World.Level then
		S.World.Level.Folder:Destroy()
	end
	S.World.Level = nil
	S.World.Paused = false
	state():SetAttribute("Paused", false)
	for root in savedRoots do
		if root.Parent then
			root.Anchored = false
		end
	end
	table.clear(savedRoots)
end

local function load(data: any, isJob: boolean)
	unload()
	S.World.Data = data
	S.World.IsJob = isJob
	applyLighting(data)
	local built = LevelBuilder.Build(data, Workspace)
	S.Hazards.Build(data, built.Folder)
	S.World.Level = built
	S.Items.Attach()
	S.Truck.Reset()
	local st = state()
	st:SetAttribute("JobId", isJob and data.Id or "")
	st:SetAttribute("JobName", data.Name)
	st:SetAttribute("TruckPos", built.Truck.Rear.Position)
	st:SetAttribute("CameraYaw", data.Camera and data.Camera.Yaw or Config.Camera.Yaw)
	st:SetAttribute("CameraPitch", data.Camera and data.Camera.Pitch or Config.Camera.Pitch)
	timerAccum = 0
	timerRunning = false
	publishTimer()
	S.Players.RespawnAll()
end

local function publishAssists()
	local a = S.World.Assists
	local st = state()
	st:SetAttribute("AssistTimeScale", a.TimeScale)
	st:SetAttribute("AssistReducedHazards", a.ReducedHazards)
	st:SetAttribute("AssistEasyHeavy", a.EasyHeavy)
	st:SetAttribute("AssistVanish", a.VanishDelivered)
end

function JobManager.GoLobby()
	load(Jobs.Lobby, false)
	job = nil
	S.World.Active = true
	S.Players.SetFrozen(false)
	setPhase("Lobby")
end

local function unlockedForGroup(id: string): boolean
	if Jobs.List[1].Id == id then
		return true
	end
	for _, p in S.Players.Movers() do
		local profile = S.Data.Get(p)
		if profile and profile.Unlocked[id] then
			return true
		end
	end
	return false
end

local function sanitizeAssists(a: any): { [string]: any }
	local out = table.clone(Config.Assists.Defaults)
	if type(a) ~= "table" then
		return out
	end
	if table.find(Config.Assists.TimeTargetScale, a.TimeScale) then
		out.TimeScale = a.TimeScale
	end
	out.ReducedHazards = a.ReducedHazards == true
	out.EasyHeavy = a.EasyHeavy == true
	out.VanishDelivered = a.VanishDelivered == true
	return out
end

-- Host picked a job on the board: load it and show the briefing.
function JobManager.SelectJob(id: any, assists: any)
	if type(id) ~= "string" or not Jobs.ById[id] or not unlockedForGroup(id) then
		return
	end
	S.World.Assists = sanitizeAssists(assists)
	publishAssists()
	job = Jobs.ById[id]
	S.World.Active = false
	load(job, true)
	S.Players.SetFrozen(true)
	setPhase("Briefing")
end

function JobManager.StartCountdown()
	if not job or (phase ~= "Briefing" and phase ~= "Results") then
		return
	end
	if phase == "Results" then
		-- replay: rebuild the level from scratch
		S.World.Active = false
		load(job, true)
	end
	S.Players.SetFrozen(true)
	setPhase("Countdown")
	local myToken = token
	local ends = serverNow() + Config.Countdown
	state():SetAttribute("CountdownEnd", ends)
	for i = Config.Countdown, 1, -1 do
		task.delay(Config.Countdown - i, function()
			if token == myToken and JobManager.Phase() == "Countdown" then
				S.Fx.All("Countdown", { N = i })
			end
		end)
	end
	task.delay(Config.Countdown, function()
		if token ~= myToken or JobManager.Phase() ~= "Countdown" then
			return
		end
		S.Fx.All("Countdown", { N = 0 })
		setPhase("Playing")
		S.World.Active = true
		S.Players.SetFrozen(false)
		timerAccum = 0
		timerRunning = true
		publishTimer()
	end)
end

function JobManager.Restart()
	if not job then
		return
	end
	S.World.Active = false
	load(job, true)
	setPhase("Briefing") -- StartCountdown requires Briefing
	JobManager.StartCountdown()
end

function JobManager.SetPaused(paused: boolean, by: Player?)
	if paused == S.World.Paused then
		return
	end
	if paused and phase ~= "Playing" then
		return
	end
	S.World.Paused = paused
	local st = state()
	st:SetAttribute("Paused", paused)
	st:SetAttribute("PausedBy", by and by:GetAttribute("Slot") or 0)
	S.Items.SetFrozen(paused)
	S.Hazards.SetFrozen(paused)
	for _, p in S.Players.Movers() do
		local root = S.Players.Root(p)
		if root then
			if paused then
				savedRoots[root] = root.AssemblyLinearVelocity
				root.Anchored = true
			else
				root.Anchored = false
				root.AssemblyLinearVelocity = savedRoots[root] or Vector3.zero
			end
		end
	end
	if not paused then
		table.clear(savedRoots)
		S.Carry.RefreshOwners()
	end
	S.Players.UpdateAllSpeeds()
	if phase == "Playing" then
		timerRunning = not paused
		publishTimer()
	end
end

-- TruckService calls this once every required item is securely delivered.
function JobManager.OnAllDelivered()
	if phase ~= "Playing" or not job then
		return
	end
	timerRunning = false
	publishTimer()
	setPhase("Results")
	S.World.Active = false
	S.Players.SetFrozen(true)
	local seconds = math.floor(timerAccum * 100 + 0.5) / 100
	local scale = S.World.Assists.TimeScale or 1
	local medal = Jobs.Medal(job, seconds, scale)
	S.Fx.All("Celebrate", {})
	for _, p in S.Players.Movers() do
		local prev, isBest, unlocked = S.Data.RecordJob(p, job.Id, seconds, medal)
		S.Fx.To(p, "Results", {
			JobId = job.Id,
			Time = seconds,
			Medal = medal,
			PrevBest = prev,
			NewBest = isBest,
			Unlocked = unlocked,
			Scale = scale,
			Assisted = scale ~= 1 or S.World.Assists.ReducedHazards or S.World.Assists.EasyHeavy or S.World.Assists.VanishDelivered,
		})
		S.Fx.To(p, "Profile", S.Data.Get(p))
	end
end

function JobManager.NextJob()
	if phase ~= "Results" or not job then
		return
	end
	local nextJob = Jobs.Next(job.Id)
	if nextJob and unlockedForGroup(nextJob.Id) then
		JobManager.SelectJob(nextJob.Id, S.World.Assists)
	else
		JobManager.GoLobby()
	end
end

function JobManager.OnMoversChanged()
	if S.Players.MoverCount() == 0 and phase ~= "Lobby" then
		JobManager.GoLobby()
		return
	end
	S.Carry.RefreshAll()
	local p = JobManager.Phase()
	if p == "Briefing" or p == "Countdown" or p == "Results" then
		S.Players.SetFrozen(true)
	end
end

-- Fixed-rate gameplay tick (Config.Tick.Rate), with a cap on catch-up after a stall.
local function tick(dt: number)
	if not S.World.Level then
		return
	end
	if S.World.Active and not S.World.Paused then
		S.World.SimTime += dt
		S.Carry.Step()
		S.Items.Step()
		S.Players.Step()
		S.Hazards.Step(dt)
		S.Truck.Step(dt)
		if phase == "Playing" and timerRunning then
			timerAccum += dt
		end
	elseif S.World.Level and not S.World.Paused then
		-- briefing / results: still recover things that fall out of the world
		S.Items.Step()
		S.Players.Step()
	end
end

function JobManager.Init()
	for _, key in { "ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "FogEnd", "FogStart", "FogColor", "ShadowSoftness", "ExposureCompensation" } do
		lightingDefaults[key] = (Lighting :: any)[key]
	end
	local acc = 0
	local publishAcc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += math.min(dt, 0.5)
		local steps = 0
		while acc >= Config.Tick.Rate and steps < Config.Tick.MaxCatchUp do
			tick(Config.Tick.Rate)
			acc -= Config.Tick.Rate
			steps += 1
		end
		if steps >= Config.Tick.MaxCatchUp then
			acc = 0
		end
		publishAcc += dt
		if publishAcc > 1 and timerRunning then
			publishAcc = 0
			publishTimer() -- re-anchor the client clock now and then
		end
	end)
	JobManager.GoLobby()
end

return JobManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">LevelBuilder</string>
          <string name="Source"><![CDATA[--[[
	LevelBuilder.luau
	Turns a level data table (src/shared/Levels/*.luau) into a roofless, furnished world:
	ground zones, room floors, walls with doorways / windows / breakable glass / swinging
	doors / boarded doors, decorative props, the moving truck and the furniture.

	Everything goes into one Folder (workspace.Level). Unloading = destroying that folder,
	so a restart can never duplicate parts, constraints or furniture.

	Coordinates: X/Z ground plane, Y up, studs. Ground top is y = 0.
	Hazards (water, traffic, conveyors, platforms, ghosts) are built by Hazards.luau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FurnitureData = require(ReplicatedStorage.Shared.FurnitureData)
local Shapes = require(ReplicatedStorage.Shared.Shapes)
local FurnitureModels = require(script.Parent.FurnitureModels)
local TruckBuilder = require(script.Parent.TruckBuilder)

local LevelBuilder = {}

local V = Vector3.new
local CF = CFrame.new
local rad = math.rad
local smooth = Enum.Material.SmoothPlastic

export type Opening = {
	At: number, -- distance of the opening centre from wall point A
	Width: number,
	Kind: string, -- Door | Window | BreakWindow | SwingDoor | BoardedDoor | Gap
	Sill: number?,
	Top: number?,
}

export type Built = {
	Folder: Folder,
	Static: Folder,
	ItemsFolder: Folder,
	Items: { [string]: Model },
	ItemOrder: { string },
	ItemHomes: { [string]: CFrame },
	Truck: { Model: Model, Cargo: CFrame, CargoSize: Vector3, Rear: CFrame },
	Spawns: { Vector3 },
	Breakables: { BasePart },
	Bounds: { Min: Vector3, Max: Vector3 },
}

local DEFAULT_WALL_HEIGHT = 7.5
local LOW_WALL_HEIGHT = 4
local WALL_THICK = 0.5

-- Default wall style (a level overrides any of these with `WallStyle`, a wall with its
-- own fields). Faces are painted per room: a face that looks into a Floors rectangle
-- takes that floor's `Wall` colour, other faces take the exterior colour.
local WALL_STYLE = {
	Inner = Color3.fromRGB(246, 236, 214), -- room face without its own paint
	Outer = Color3.fromRGB(246, 236, 214), -- exterior face
	OuterMaterial = smooth,
	Cap = Color3.fromRGB(74, 58, 54), -- thick cap on top of every wall
	CapHeight = 0.45,
	CapOverhang = 0.18,
	Post = nil :: Color3?, -- wall-end posts (default: the cap colour)
	Frame = Color3.fromRGB(196, 150, 104), -- door frames
	Door = Color3.fromRGB(128, 86, 70), -- door leaves
	WindowFrame = Color3.fromRGB(250, 248, 240),
	Baseboard = nil :: Color3?, -- default: each face's colour, darker
}

local PALETTE = {
	Grass = { Color3.fromRGB(166, 212, 108), Enum.Material.Grass },
	Road = { Color3.fromRGB(80, 82, 94), Enum.Material.Asphalt },
	Pavement = { Color3.fromRGB(216, 210, 198), Enum.Material.Concrete },
	Concrete = { Color3.fromRGB(176, 176, 172), Enum.Material.Concrete },
	Wood = { Color3.fromRGB(202, 150, 96), Enum.Material.WoodPlanks },
	DarkWood = { Color3.fromRGB(122, 84, 64), Enum.Material.WoodPlanks },
	Tile = { Color3.fromRGB(226, 228, 224), Enum.Material.CeramicTiles },
	Carpet = { Color3.fromRGB(140, 170, 214), Enum.Material.Fabric },
	CarpetRed = { Color3.fromRGB(176, 72, 80), Enum.Material.Fabric },
	Patio = { Color3.fromRGB(226, 206, 170), Enum.Material.Slate },
	Sand = { Color3.fromRGB(236, 214, 160), Enum.Material.Sand },
	Dirt = { Color3.fromRGB(110, 92, 74), Enum.Material.Ground },
	DeadGrass = { Color3.fromRGB(96, 104, 74), Enum.Material.Grass },
	Metal = { Color3.fromRGB(150, 156, 164), Enum.Material.DiamondPlate },
}
LevelBuilder.Palette = PALETTE

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): Part
	local p = Instance.new("Part")
	p.Name = name or "Part"
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or smooth
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
LevelBuilder.Part = part

local function deco(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = part(parent, size, cf, color, material, "Deco")
	if shape == Enum.PartType.Ball then
		Shapes.Ball(p)
	elseif shape then
		p.Shape = shape
	end
	return p
end

local function rect(parent: Instance, min: Vector2, max: Vector2, topY: number, thick: number, color: Color3, material: Enum.Material, name: string): Part
	local size = V(max.X - min.X, thick, max.Y - min.Y)
	local centre = V((min.X + max.X) / 2, topY - thick / 2, (min.Y + max.Y) / 2)
	return part(parent, size, CF(centre), color, material, name)
end

local subtractRect: (any, any) -> { any }

local function v2(t: any): Vector2
	if typeof(t) == "Vector2" then
		return t
	end
	return Vector2.new(t[1], t[2])
end

-- rectangle minus a hole -> up to four rectangles
type R = { Min: Vector2, Max: Vector2 }
subtractRect = function(r: R, hole: R): { R }
	local hMin = Vector2.new(math.max(r.Min.X, hole.Min.X), math.max(r.Min.Y, hole.Min.Y))
	local hMax = Vector2.new(math.min(r.Max.X, hole.Max.X), math.min(r.Max.Y, hole.Max.Y))
	if hMin.X >= hMax.X or hMin.Y >= hMax.Y then
		return { r }
	end
	local out = {}
	local function add(a: Vector2, b: Vector2)
		if b.X - a.X > 0.01 and b.Y - a.Y > 0.01 then
			table.insert(out, { Min = a, Max = b })
		end
	end
	add(r.Min, Vector2.new(r.Max.X, hMin.Y)) -- strip before the hole (low Z)
	add(Vector2.new(r.Min.X, hMax.Y), r.Max) -- strip after the hole (high Z)
	add(Vector2.new(r.Min.X, hMin.Y), Vector2.new(hMin.X, hMax.Y)) -- left
	add(Vector2.new(hMax.X, hMin.Y), Vector2.new(r.Max.X, hMax.Y)) -- right
	return out
end

local function v3(t: any, y: number?): Vector3
	if typeof(t) == "Vector3" then
		return t
	end
	if #t == 3 then
		return V(t[1], t[2], t[3])
	end
	return V(t[1], y or 0, t[2])
end
LevelBuilder.V3 = v3

----------------------------------------------------------------------------------------
-- Walls

local function glassPane(parent: Instance, size: Vector3, cf: CFrame, breakable: boolean): Part
	local p = part(parent, size, cf, Color3.fromRGB(170, 214, 236), Enum.Material.Glass, breakable and "BreakGlass" or "Glass")
	p.Transparency = 0.45
	p.Reflectance = 0.15
	if breakable then
		p:SetAttribute("Breakable", "Glass")
		-- a white cross so breakable glass reads as a shortcut
		local frame = deco(parent, V(size.X, 0.2, size.Z + 0.05), cf, Color3.new(1, 1, 1), smooth)
		frame.Name = "GlassMullion"
		frame.CanCollide = false
		frame.CanQuery = false
		local m2 = deco(parent, V(0.2, size.Y, size.Z + 0.05), cf, Color3.new(1, 1, 1), smooth)
		m2.Name = "GlassMullion"
		m2.CanCollide = false
		m2.CanQuery = false
		-- keep a reference to the mullions so Breakables can hide them with the pane
		local o1 = Instance.new("ObjectValue")
		o1.Name = "Linked"
		o1.Value = frame
		o1.Parent = p
		local o2 = Instance.new("ObjectValue")
		o2.Name = "Linked"
		o2.Value = m2
		o2.Parent = p
	end
	return p
end

local function swingDoor(parent: Instance, width: number, height: number, hingeCF: CFrame, color: Color3): Model
	-- a free-swinging door leaf on a hinge with a spring that pulls it shut
	local model = Instance.new("Model")
	model.Name = "SwingDoor"
	model.Parent = parent
	local post = part(model, V(0.3, height, 0.3), hingeCF * CF(0, height / 2, 0), color, smooth, "HingePost")
	post.Transparency = 1
	post.CanCollide = false
	local leafW = width - 0.3
	local leaf = Instance.new("Part")
	leaf.Name = "Leaf"
	leaf.Size = V(leafW, height - 0.3, 0.35)
	leaf.CFrame = hingeCF * CF(leafW / 2 + 0.15, height / 2 + 0.1, 0)
	leaf.Color = color
	leaf.Material = Enum.Material.WoodPlanks
	leaf.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.3, 0.1)
	leaf.Parent = model
	local knob = Instance.new("Part")
	knob.Shape = Enum.PartType.Ball
	knob.Size = V(0.4, 0.4, 0.4)
	knob.CFrame = leaf.CFrame * CF(leafW / 2 - 0.5, -0.4, 0.3)
	knob.Color = Color3.fromRGB(230, 184, 70)
	knob.Massless = true
	knob.CanCollide = false
	knob.Parent = model
	local kw = Instance.new("WeldConstraint")
	kw.Part0 = leaf
	kw.Part1 = knob
	kw.Parent = knob
	local a0 = Instance.new("Attachment")
	a0.CFrame = CFrame.Angles(0, 0, rad(90))
	a0.Parent = post
	local a1 = Instance.new("Attachment")
	a1.Position = V(-leafW / 2 - 0.15, -0.1, 0)
	a1.CFrame = CF(a1.Position) * CFrame.Angles(0, 0, rad(90))
	a1.Parent = leaf
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0 = a0
	hinge.Attachment1 = a1
	hinge.LimitsEnabled = true
	hinge.LowerAngle = -100
	hinge.UpperAngle = 100
	hinge.Parent = model
	local spring = Instance.new("TorsionSpringConstraint")
	spring.Attachment0 = a0
	spring.Attachment1 = a1
	spring.Stiffness = 60
	spring.Damping = 12
	spring.MaxTorque = 2000
	spring.Parent = model
	return model
end

local function boardedDoor(parent: Instance, width: number, cf: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "BoardedDoor"
	model.Parent = parent
	local blocker = part(model, V(width, 6, 0.6), cf * CF(0, 3, 0), Color3.new(), smooth, "Blocker")
	blocker.Transparency = 1
	blocker:SetAttribute("Breakable", "Boards")
	blocker:SetAttribute("Hits", 0)
	local plankColor = Color3.fromRGB(150, 108, 70)
	for i, y in { 1.4, 3.1, 4.8 } do
		local tilt = (i % 2 == 0) and 8 or -8
		local plank = deco(model, V(width + 0.6, 0.7, 0.3), cf * CF(0, y, 0.25) * CFrame.Angles(0, 0, rad(tilt)), plankColor, Enum.Material.WoodPlanks)
		plank.CanCollide = false
		plank.CanQuery = false
		local link = Instance.new("ObjectValue")
		link.Name = "Linked"
		link.Value = plank
		link.Parent = blocker
	end
	return model
end

local function noTouch(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
end

type Room = { Min: Vector2, Max: Vector2, Color: Color3?, Material: Enum.Material? }

local function roomAt(rooms: { Room }, p: Vector2): Room?
	for _, r in rooms do
		if p.X > r.Min.X and p.X < r.Max.X and p.Y > r.Min.Y and p.Y < r.Max.Y then
			return r
		end
	end
	return nil
end

-- t-range [t0, t1] where the line o + u * t is inside rectangle r (nil if never)
local function clipLine(o: Vector2, u: Vector2, r: Room): (number?, number?)
	local t0, t1 = -math.huge, math.huge
	for _, axis in { "X", "Y" } do
		local oa, ua = (o :: any)[axis], (u :: any)[axis]
		local lo, hi = (r.Min :: any)[axis], (r.Max :: any)[axis]
		if math.abs(ua) < 1e-6 then
			if oa <= lo or oa >= hi then
				return nil, nil
			end
		else
			local a, b = (lo - oa) / ua, (hi - oa) / ua
			t0 = math.max(t0, math.min(a, b))
			t1 = math.min(t1, math.max(a, b))
		end
	end
	if t1 <= t0 then
		return nil, nil
	end
	return t0, t1
end

-- a door leaf standing open flat against the wall (decoration only)
local function doorLeaf(parent: Instance, cf: CFrame, w: number, h: number, color: Color3)
	local leaf = deco(parent, V(w, h, 0.18), cf * CF(0, h / 2, 0), color, Enum.Material.Wood)
	noTouch(leaf)
	leaf.Name = "DoorLeaf"
	local panel = color:Lerp(Color3.new(1, 1, 1), 0.12)
	for _, y in { h * 0.28, h * 0.7 } do
		local pnl = deco(parent, V(w - 0.8, h * 0.3, 0.06), cf * CF(0, y, 0.11), panel, Enum.Material.Wood)
		noTouch(pnl)
	end
	local knob = deco(parent, V(0.3, 0.3, 0.3), cf * CF(w / 2 - 0.45, h * 0.47, 0.16), Color3.fromRGB(236, 190, 80), Enum.Material.Metal, Enum.PartType.Ball)
	noTouch(knob)
end

-- Builds one wall segment from A to B with openings cut out. A wall is thin, painted per
-- side (see WALL_STYLE), with a thick cap, baseboards, end posts, door frames, open door
-- leaves and window frames. Collision is the two painted halves only (thickness Thick).
local function wall(parent: Instance, w: any, out: Built, style: any, rooms: { Room })
	local a = v2(w.A)
	local b = v2(w.B)
	local height = w.Height or (w.Low and LOW_WALL_HEIGHT or DEFAULT_WALL_HEIGHT)
	local thick = w.Thick or style.Thick or WALL_THICK
	local dir = (b - a)
	local length = dir.Magnitude
	local unit = dir.Unit
	local normal = Vector2.new(-unit.Y, unit.X) -- local +Z of the wall frame
	local yaw = math.atan2(-unit.Y, unit.X)
	local base = CF(V(a.X, 0, a.Y)) * CFrame.Angles(0, yaw, 0) -- local +X runs along the wall
	local capColor = w.CapColor or style.Cap
	local capH = style.CapHeight
	local capW = thick + style.CapOverhang * 2

	local group = Instance.new("Model")
	group.Name = w.Low and "LowWall" or "Wall"
	group:SetAttribute("FadeGroup", true)
	group.Parent = parent

	-- per side (+1 / -1): runs of { t0, t1, color, material, inRoom }
	local function faceRuns(side: number)
		local off = normal * side * (thick / 2 + 0.3)
		local cuts = { 0, length }
		for _, r in rooms do
			local t0, t1 = clipLine(a + off, unit, r)
			if t0 then
				table.insert(cuts, math.clamp(t0 :: number, 0, length))
				table.insert(cuts, math.clamp(t1 :: number, 0, length))
			end
		end
		table.sort(cuts)
		local runs = {}
		for i = 1, #cuts - 1 do
			local t0, t1 = cuts[i], cuts[i + 1]
			if t1 - t0 > 0.01 then
				local room = roomAt(rooms, a + off + unit * ((t0 + t1) / 2))
				local color, material
				local explicit = side > 0 and w.ColorB or w.ColorA
				if explicit then
					color, material = explicit, w.Material or smooth
				elseif room then
					color, material = room.Color or w.Color or style.Inner, room.Material or smooth
				else
					color, material = w.Outer or style.Outer, w.OuterMaterial or style.OuterMaterial or smooth
				end
				local last = runs[#runs]
				if last and last.Color == color and last.Material == material then
					last.T1 = t1
				else
					table.insert(runs, { T0 = t0, T1 = t1, Color = color, Material = material, Room = room ~= nil })
				end
			end
		end
		return runs
	end
	local sides = { [1] = faceRuns(1), [-1] = faceRuns(-1) }

	local function solid(from: number, to: number, y0: number, y1: number)
		if to - from < 0.05 or y1 - y0 < 0.05 then
			return
		end
		for side, runs in sides do
			for _, run in runs do
				local f, t = math.max(from, run.T0), math.min(to, run.T1)
				if t - f > 0.01 then
					local p = part(group, V(t - f, y1 - y0, thick / 2), base * CF((f + t) / 2, (y0 + y1) / 2, side * thick / 4), run.Color, run.Material, "Wall")
					p:SetAttribute("Fadeable", true)
					if y0 < 0.01 then
						local bb = deco(group, V(t - f, 0.5, 0.12), base * CF((f + t) / 2, 0.35, side * (thick / 2 + 0.04)), style.Baseboard or run.Color:Lerp(Color3.new(0.1, 0.06, 0.04), 0.3), smooth)
						noTouch(bb)
					end
				end
			end
		end
		if y1 >= height - 0.01 then
			local cap = deco(group, V(to - from, capH, capW), base * CF((from + to) / 2, y1 + capH / 2, 0), capColor, smooth)
			cap.Name = "Cap"
			cap.CanCollide = false
			cap.CastShadow = false
			cap:SetAttribute("Fadeable", true)
		end
	end

	local function post(t: number, color: Color3, wide: number, h: number)
		local p = deco(group, V(wide, h, thick + 0.24), base * CF(t, h / 2, 0), color, smooth)
		p.Name = "Post"
		p.CanCollide = false
		p:SetAttribute("Fadeable", true)
	end

	local openings: { Opening } = table.clone(w.Openings or {})
	table.sort(openings, function(x, y)
		return x.At < y.At
	end)

	local cursor = 0
	for i, o in openings do
		local from = o.At - o.Width / 2
		local to = o.At + o.Width / 2
		solid(cursor, from, 0, height)
		local mid = base * CF(o.At, 0, 0)
		local frameH = height + capH
		if o.Kind == "Window" then
			local sill = o.Sill or math.min(2.4, height - 1.5)
			local top = o.Top or (w.Low and height or height - 1.2)
			solid(from, to, 0, sill)
			solid(from, to, top, height)
			glassPane(group, V(o.Width, top - sill, 0.2), mid * CF(0, (sill + top) / 2, 0), false)
			local ledge = deco(group, V(o.Width + 0.8, 0.25, thick + 0.4), mid * CF(0, sill + 0.12, 0), style.WindowFrame, smooth)
			noTouch(ledge)
			if top < height - 0.05 then
				local head = deco(group, V(o.Width + 0.8, 0.3, thick + 0.3), mid * CF(0, top, 0), style.WindowFrame, smooth)
				noTouch(head)
			end
			for _, t in { from - 0.15, to + 0.15 } do
				local j = deco(group, V(0.3, top - sill, thick + 0.3), base * CF(t, (sill + top) / 2, 0), style.WindowFrame, smooth)
				noTouch(j)
			end
			local bar = deco(group, V(0.16, top - sill, 0.3), mid * CF(0, (sill + top) / 2, 0), style.WindowFrame, smooth)
			noTouch(bar)
		elseif o.Kind == "BreakWindow" then
			local sill = o.Sill or 0.2
			local top = o.Top or (w.Low and height or height - 1)
			solid(from, to, 0, sill)
			solid(from, to, top, height)
			local pane = glassPane(group, V(o.Width, top - sill, 0.3), mid * CF(0, (sill + top) / 2, 0), true)
			table.insert(out.Breakables, pane)
			for _, t in { from - 0.15, to + 0.15 } do
				local j = deco(group, V(0.3, top - sill, thick + 0.3), base * CF(t, (sill + top) / 2, 0), style.WindowFrame, smooth)
				noTouch(j)
			end
		else
			-- doorways: wooden frame posts on both sides (inside the solid wall, so the
			-- opening keeps its width)
			if o.Frame ~= false then
				post(from - 0.2, o.FrameColor or style.Frame, 0.4, frameH)
				post(to + 0.2, o.FrameColor or style.Frame, 0.4, frameH)
			end
			if o.Kind == "SwingDoor" then
				swingDoor(parent, o.Width, math.min(height, 6.6), base * CF(from, 0, 0), o.Color or style.Door)
			elseif o.Kind == "BoardedDoor" then
				local m = boardedDoor(parent, o.Width, mid)
				local blocker = m:FindFirstChild("Blocker") :: BasePart
				table.insert(out.Breakables, blocker)
			elseif o.Kind == "Door" and o.Leaf ~= false then
				-- open leaves resting flat against the wall beside the doorway
				local prevEnd = 0
				local nextStart = length
				if openings[i - 1] then
					prevEnd = openings[i - 1].At + openings[i - 1].Width / 2
				end
				if openings[i + 1] then
					nextStart = openings[i + 1].At - openings[i + 1].Width / 2
				end
				local double = o.Width >= 7
				local leafW = math.min(double and o.Width / 2 or o.Width, 4)
				local leafH = math.min(6.4, height - 0.5)
				-- on the side the camera sees, unless the level picks one
				local side = o.LeafSide or ((normal:Dot(style.CameraDir) >= 0) and 1 or -1)
				local zOff = side * (thick / 2 + 0.13)
				local roomAfter = nextStart - (to + 0.4)
				local roomBefore = (from - 0.4) - prevEnd
				local placed = 0
				if roomAfter >= leafW and placed < (double and 2 or 1) then
					doorLeaf(group, base * CF(to + 0.4 + leafW / 2, 0, zOff) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0), leafW, leafH, o.Color or style.Door)
					placed += 1
				end
				if roomBefore >= leafW and placed < (double and 2 or 1) then
					doorLeaf(group, base * CF(from - 0.4 - leafW / 2, 0, zOff) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0), leafW, leafH, o.Color or style.Door)
				end
			end
		end
		-- Door and Gap: open (roofless world, so no lintel to snag tall furniture)
		cursor = to
	end
	solid(cursor, length, 0, height)
	if w.Posts ~= false then
		local pc = style.Post or capColor
		post(0, pc, thick + 0.36, height + capH + 0.05)
		post(length, pc, thick + 0.36, height + capH + 0.05)
	end
end

----------------------------------------------------------------------------------------
-- Floor / ground patterns (flat overlay parts on top of one base slab; no collision)

local function flat(parent: Instance, x0: number, z0: number, x1: number, z1: number, y: number, color: Color3, material: Enum.Material?, rot: number?): Part?
	if x1 - x0 < 0.02 or z1 - z0 < 0.02 then
		return nil
	end
	local p = part(parent, V(x1 - x0, 0.04, z1 - z0), CF((x0 + x1) / 2, y + 0.02, (z0 + z1) / 2) * CFrame.Angles(0, rad(rot or 0), 0), color, material or smooth, "Pattern")
	noTouch(p)
	return p
end

local function shade(c: Color3, k: number): Color3
	return k >= 0 and c:Lerp(Color3.new(1, 1, 1), k) or c:Lerp(Color3.new(0, 0, 0), -k)
end
LevelBuilder.Shade = shade

-- Draws spec.Pattern over the rectangle min..max whose top is at y. Base colour c.
-- Patterns: Checker, Dots, Planks, Parquet, SmallTile, Grid, Diamond, Stripes.
local function pattern(parent: Instance, min: Vector2, max: Vector2, y: number, spec: any, c: Color3)
	local kind = spec.Pattern
	if not kind then
		return
	end
	local w, d = max.X - min.X, max.Y - min.Y
	local mat = spec.Material or smooth
	if kind == "Checker" then
		local t = spec.Tile or 3
		local c2 = spec.Color2 or shade(c, -0.55)
		local nx, nz = math.ceil(w / t - 0.01), math.ceil(d / t - 0.01)
		for i = 0, nx - 1 do
			for j = 0, nz - 1 do
				if (i + j) % 2 == 1 then
					flat(parent, min.X + i * t, min.Y + j * t, math.min(min.X + (i + 1) * t, max.X), math.min(min.Y + (j + 1) * t, max.Y), y, c2, mat)
				end
			end
		end
	elseif kind == "Dots" then
		local t = spec.Tile or 4
		local c2 = spec.Color2 or shade(c, 0.25)
		local r = (spec.DotSize or t * 0.42)
		local row = 0
		local z = min.Y + t / 2
		while z < max.Y - r / 2 do
			local x = min.X + t / 2 + ((row % 2 == 1) and t / 2 or 0)
			while x < max.X - r / 2 do
				local dot = part(parent, V(0.04, r, r), CF(x, y + 0.02, z) * CFrame.Angles(0, 0, rad(90)), c2, mat, "Pattern")
				dot.Shape = Enum.PartType.Cylinder
				noTouch(dot)
				x += t
			end
			z += t
			row += 1
		end
	elseif kind == "Planks" or kind == "Stripes" then
		local t = spec.Tile or (kind == "Planks" and 1.5 or 2)
		local alongX = spec.Dir == "X" or (spec.Dir == nil and w >= d)
		local across = alongX and d or w
		local along = alongX and w or d
		local n = math.ceil(across / t - 0.01)
		local gap = kind == "Planks" and 0.1 or 0
		local c2 = spec.Color2 or shade(c, kind == "Planks" and 0.08 or 0.3)
		for i = 0, n - 1 do
			local a0 = i * t + gap / 2
			local a1 = math.min((i + 1) * t, across) - gap / 2
			local color = (i % 2 == 0) and c2 or shade(c2, kind == "Planks" and -0.05 or -1)
			if kind == "Stripes" and i % 2 == 1 then
				continue
			end
			if kind == "Planks" then
				-- staggered board ends
				local len = spec.Board or 8
				local s0 = -((i * 3.1) % len)
				while s0 < along do
					local b0, b1 = math.max(s0, 0) + gap / 2, math.min(s0 + len, along) - gap / 2
					if alongX then
						flat(parent, min.X + b0, min.Y + a0, min.X + b1, min.Y + a1, y, color, mat)
					else
						flat(parent, min.X + a0, min.Y + b0, min.X + a1, min.Y + b1, y, color, mat)
					end
					s0 += len
				end
			else
				if alongX then
					flat(parent, min.X, min.Y + a0, max.X, min.Y + a1, y, color, mat)
				else
					flat(parent, min.X + a0, min.Y, min.X + a1, max.Y, y, color, mat)
				end
			end
		end
	elseif kind == "Parquet" then
		-- square blocks of two boards, alternating direction (reads as herringbone)
		local t = spec.Tile or 4
		local c2 = spec.Color2 or shade(c, 0.1)
		local g = 0.1
		local nx, nz = math.ceil(w / t - 0.01), math.ceil(d / t - 0.01)
		for i = 0, nx - 1 do
			for j = 0, nz - 1 do
				local x0, z0 = min.X + i * t, min.Y + j * t
				local x1, z1 = math.min(x0 + t, max.X), math.min(z0 + t, max.Y)
				local h = t / 2
				for k = 0, 1 do
					local color = (k == 0) and c2 or shade(c2, -0.07)
					if (i + j) % 2 == 0 then
						flat(parent, x0 + g, z0 + k * h + g, x1 - g, math.min(z0 + (k + 1) * h, z1) - g, y, color, mat)
					else
						flat(parent, x0 + k * h + g, z0 + g, math.min(x0 + (k + 1) * h, x1) - g, z1 - g, y, color, mat)
					end
				end
			end
		end
	elseif kind == "SmallTile" or kind == "Grid" then
		local t = spec.Tile or (kind == "SmallTile" and 1.6 or 8)
		local lw = spec.Line or (kind == "SmallTile" and 0.14 or 0.18)
		local c2 = spec.Color2 or (kind == "SmallTile" and shade(c, 0.45) or shade(c, -0.12))
		local x = min.X + t
		while x < max.X - 0.05 do
			flat(parent, x - lw / 2, min.Y, x + lw / 2, max.Y, y, c2, mat)
			x += t
		end
		local z = min.Y + t
		while z < max.Y - 0.05 do
			flat(parent, min.X, z - lw / 2, max.X, z + lw / 2, y + 0.005, c2, mat)
			z += t
		end
	elseif kind == "Diamond" then
		local t = spec.Tile or 3.2
		local c2 = spec.Color2 or Color3.fromRGB(44, 44, 52)
		local sz = spec.DotSize or t * 0.38
		local x = min.X + t
		while x < max.X - 0.1 do
			local z = min.Y + t
			while z < max.Y - 0.1 do
				flat(parent, x - sz / 2, z - sz / 2, x + sz / 2, z + sz / 2, y, c2, mat, 45)
				z += t
			end
			x += t
		end
	end
end

-- Deterministic scatter of grass tufts and flowers over grassy ground.
local function scatterGrass(parent: Instance, level: any, isGrassAt: (Vector2) -> (string?, Color3?))
	local b = level.Bounds
	local min, max = v2(b.Min), v2(b.Max)
	local seed = 0
	for i = 1, #(level.Id or "x") do
		seed = (seed * 31 + string.byte(level.Id, i)) % 100000
	end
	local rng = Random.new(seed + 7)
	local area = (max.X - min.X) * (max.Y - min.Y)
	local density = level.GrassDetail or 4 -- tufts per 100 square studs
	local n = math.floor(area / 100 * density)
	for _ = 1, n do
		local p = Vector2.new(rng:NextNumber(min.X, max.X), rng:NextNumber(min.Y, max.Y))
		local kind, ground = isGrassAt(p)
		if kind then
			local base = shade(ground or PALETTE.Grass[1], -0.12)
			local roll = rng:NextNumber()
			if kind == "Grass" and roll < 0.1 then
				local fc = ({ Color3.fromRGB(255, 255, 250), Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 150, 180) })[rng:NextInteger(1, 3)]
				local f = deco(parent, V(0.55, 0.55, 0.55), CF(p.X, 0.3, p.Y), fc, smooth, Enum.PartType.Ball)
				noTouch(f)
			else
				local yaw = rng:NextNumber(0, 360)
				local tuft = deco(parent, V(0.18, 0.8, 0.6), CF(p.X, 0.3, p.Y) * CFrame.Angles(0, rad(yaw), rad(rng:NextNumber(-12, 12))), shade(base, (rng:NextNumber() < 0.5) and rng:NextNumber(-0.18, -0.05) or rng:NextNumber(0.15, 0.35)), smooth)
				noTouch(tuft)
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- Props (anchored decoration; they do collide so they shape routes)

local Props: { [string]: (parent: Instance, cf: CFrame, p: any) -> () } = {}

Props.Tree = function(parent, cf, p)
	-- trunk + stacked rounded crowns; crowns don't collide and fade like walls
	local s = p.Scale or 1
	local trunk = deco(parent, V(1.1 * s, 4 * s, 1.1 * s), cf * CF(0, 2 * s, 0), p.TrunkColor or Color3.fromRGB(176, 104, 84), Enum.Material.Wood)
	trunk.Name = "Trunk"
	local leaf = p.Color or Color3.fromRGB(96, 178, 104)
	local crowns = p.Style == "Round" and {
		{ 6.4, 5.2, 6.8, 0 },
		{ 4.6, 4, 9.6, 0.15 },
	} or {
		-- tall cypress-like stack (default)
		{ 5.2, 5.4, 5.6, -0.04 },
		{ 4.4, 4.8, 8.8, 0.06 },
		{ 3, 3.6, 11.6, 0.16 },
	}
	for _, c in crowns do
		local crown = deco(parent, V(c[1] * s, c[2] * s, c[1] * s), cf * CF(0, c[3] * s, 0), shade(leaf, c[4]), smooth, Enum.PartType.Ball)
		crown.Name = "Crown"
		crown.CanCollide = false
		crown:SetAttribute("Fadeable", true)
	end
end

Props.DeadTree = function(parent, cf, p)
	local s = p.Scale or 1
	local bark = Color3.fromRGB(70, 60, 64)
	deco(parent, V(1.3 * s, 8 * s, 1.3 * s), cf * CF(0, 4 * s, 0), bark, Enum.Material.Wood)
	deco(parent, V(0.6 * s, 4 * s, 0.6 * s), cf * CF(1.2 * s, 7 * s, 0) * CFrame.Angles(0, 0, rad(-40)), bark, Enum.Material.Wood)
	deco(parent, V(0.5 * s, 3.5 * s, 0.5 * s), cf * CF(-1 * s, 6 * s, 0.5 * s) * CFrame.Angles(rad(20), 0, rad(45)), bark, Enum.Material.Wood)
end

Props.Bush = function(parent, cf, p)
	local s = p.Scale or 1
	local c = p.Color or Color3.fromRGB(100, 184, 108)
	deco(parent, V(3.4 * s, 2.8 * s, 3.4 * s), cf * CF(0, 1.3 * s, 0), c, smooth, Enum.PartType.Ball)
	for _, o in { { 1, 0.5, 0.7, 2.2 }, { -0.9, 0.4, 0.6, 2 }, { 0.1, 1.2, -0.9, 1.8 } } do
		local b = deco(parent, V(o[4] * s, o[4] * s, o[4] * s), cf * CF(o[1] * s, (1.3 + o[2] * 0.6) * s, o[3] * s), shade(c, 0.08), smooth, Enum.PartType.Ball)
		b.CanCollide = false
	end
end

Props.Hedge = function(parent, cf, p)
	-- a row of rounded shrubs on a low box (the box is the collision)
	local len = p.Length or 8
	local c = p.Color or Color3.fromRGB(84, 166, 98)
	deco(parent, V(len, 2.2, 2), cf * CF(0, 1.1, 0), c, smooth)
	local n = math.max(1, math.floor(len / 2.4))
	for i = 0, n - 1 do
		local b = deco(parent, V(2.8, 2.6, 2.8), cf * CF(-len / 2 + (i + 0.5) * (len / n), 2.1, 0), shade(c, (i % 2) * 0.06), smooth, Enum.PartType.Ball)
		b.CanCollide = false
	end
end

Props.Fence = function(parent, cf, p)
	-- picket fence (Style = "Wood": weathered board fence)
	local len = p.Length or 8
	local wood = p.Style == "Wood"
	local c = p.Color or (wood and Color3.fromRGB(168, 160, 150) or Color3.fromRGB(246, 240, 214))
	local h = wood and 3.2 or 2.6
	deco(parent, V(len, 0.35, 0.25), cf * CF(0, h * 0.75, 0.2), shade(c, -0.08))
	deco(parent, V(len, 0.35, 0.25), cf * CF(0, h * 0.3, 0.2), shade(c, -0.08))
	local spacing = wood and 0.95 or 1.1
	local n = math.max(2, math.floor(len / spacing))
	for i = 0, n do
		local x = -len / 2 + i * (len / n)
		local ph = h + ((wood and i % 2 == 1) and -0.25 or 0)
		local pk = deco(parent, V(wood and 0.8 or 0.5, ph, 0.2), cf * CF(x, ph / 2, 0), shade(c, (i % 3 - 1) * 0.04))
		pk.CanCollide = false
		if not wood then
			local tip = deco(parent, V(0.36, 0.36, 0.2), cf * CF(x, ph, 0) * CFrame.Angles(0, 0, rad(45)), c)
			noTouch(tip)
		end
	end
	-- one invisible collider for the whole run
	local col = part(parent, V(len, h, 0.45), cf * CF(0, h / 2, 0.1), c, smooth, "FenceCollider")
	col.Transparency = 1
end

Props.Stones = function(parent, cf, p)
	-- stepping-stone path from Pos toward To ({x,z}); decoration only
	local from = cf.Position
	local to = p.To and v3(p.To) or (cf * CF(0, 0, -10)).Position
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local n = math.max(1, math.floor(d.Magnitude / (p.Spacing or 2.6)))
	local c = p.Color or Color3.fromRGB(214, 214, 206)
	for i = 0, n do
		local pos = from + d * (i / n)
		local sz = (p.Size or 2.2) * (i % 2 == 0 and 1 or 0.9)
		local st = deco(parent, V(0.12, sz, sz * 1.15), CF(pos.X + ((i % 2) - 0.5) * 0.5, 0.08, pos.Z) * CFrame.Angles(0, rad(i * 37), rad(90)), c, Enum.Material.Slate)
		st.Shape = Enum.PartType.Cylinder
		noTouch(st)
	end
end

Props.Doormat = function(parent, cf, p)
	local mat = deco(parent, V(3.6, 0.08, 2), cf * CF(0, 0.07, 0), p.Color or Color3.fromRGB(236, 128, 64), Enum.Material.Fabric)
	noTouch(mat)
	local inner = deco(parent, V(3, 0.1, 1.4), cf * CF(0, 0.08, 0), shade(p.Color or Color3.fromRGB(236, 128, 64), 0.18), Enum.Material.Fabric)
	noTouch(inner)
end

Props.FlowerBed = function(parent, cf, p)
	-- a soil strip with round flowers; decoration only
	local s = p.Size or { 6, 1.6 }
	local soil = deco(parent, V(s[1], 0.2, s[2]), cf * CF(0, 0.1, 0), Color3.fromRGB(132, 96, 72), Enum.Material.Ground)
	noTouch(soil)
	local cols = { Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 220, 90), Color3.fromRGB(250, 250, 250), Color3.fromRGB(190, 130, 230) }
	local n = math.max(2, math.floor(s[1] / 1.2))
	for i = 0, n - 1 do
		local x = -s[1] / 2 + (i + 0.5) * (s[1] / n)
		local leaf = deco(parent, V(1, 0.8, 1), cf * CF(x, 0.5, 0), Color3.fromRGB(96, 170, 90), smooth, Enum.PartType.Ball)
		noTouch(leaf)
		local f = deco(parent, V(0.6, 0.6, 0.6), cf * CF(x, 0.95, (i % 2 - 0.5) * 0.3), cols[i % #cols + 1], smooth, Enum.PartType.Ball)
		noTouch(f)
	end
end

Props.Counter = function(parent, cf, p)
	local len = p.Length or 6
	deco(parent, V(len, 3.2, 2.4), cf * CF(0, 1.6, 0), p.Color or Color3.fromRGB(240, 236, 226))
	deco(parent, V(len + 0.2, 0.3, 2.6), cf * CF(0, 3.3, 0), Color3.fromRGB(70, 74, 84), Enum.Material.Granite)
	for i = 0, math.floor(len / 2) - 1 do
		deco(parent, V(0.5, 0.15, 0.1), cf * CF(-len / 2 + 1 + i * 2, 2.6, 1.22), Color3.fromRGB(180, 180, 186), Enum.Material.Metal)
	end
end

Props.Stove = function(parent, cf, p)
	deco(parent, V(3, 3.2, 2.4), cf * CF(0, 1.6, 0), Color3.fromRGB(230, 232, 236))
	deco(parent, V(3, 0.1, 2.4), cf * CF(0, 3.25, 0), Color3.fromRGB(40, 40, 46))
	for _, x in { -0.7, 0.7 } do
		deco(parent, V(0.12, 0.9, 0.9), cf * CF(x, 3.32, 0) * CFrame.Angles(0, 0, rad(90)), Color3.fromRGB(80, 80, 86), smooth, Enum.PartType.Cylinder)
	end
	deco(parent, V(2.2, 1.4, 0.1), cf * CF(0, 1.4, 1.22), Color3.fromRGB(40, 40, 46), Enum.Material.Glass)
end

Props.Rug = function(parent, cf, p)
	local s = p.Size or { 6, 4 }
	local r = deco(parent, V(s[1], 0.08, s[2]), cf * CF(0, 0.08, 0), p.Color or Color3.fromRGB(230, 170, 90), Enum.Material.Fabric)
	r.CanCollide = false
	local inner = deco(parent, V(s[1] - 1, 0.1, s[2] - 1), cf * CF(0, 0.09, 0), (p.Color or Color3.fromRGB(230, 170, 90)):Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.Fabric)
	inner.CanCollide = false
end

Props.Mailbox = function(parent, cf, _p)
	deco(parent, V(0.4, 3, 0.4), cf * CF(0, 1.5, 0), Color3.fromRGB(120, 90, 70), Enum.Material.Wood)
	deco(parent, V(1, 1, 1.8), cf * CF(0, 3.3, 0), Color3.fromRGB(70, 110, 200))
	deco(parent, V(0.1, 0.8, 0.3), cf * CF(0.55, 3.8, 0.4), Color3.fromRGB(230, 60, 60))
end

Props.StreetLamp = function(parent, cf, _p)
	deco(parent, V(0.5, 11, 0.5), cf * CF(0, 5.5, 0), Color3.fromRGB(60, 64, 72), Enum.Material.Metal)
	local bulb = deco(parent, V(1.4, 0.8, 1.4), cf * CF(0, 11.2, 0), Color3.fromRGB(255, 236, 180), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(255, 226, 170)
	light.Parent = bulb
end

Props.Lantern = function(parent, cf, p)
	deco(parent, V(0.4, 5, 0.4), cf * CF(0, 2.5, 0), Color3.fromRGB(50, 46, 56), Enum.Material.Metal)
	local glow = deco(parent, V(1, 1.2, 1), cf * CF(0, 5.4, 0), p.Color or Color3.fromRGB(255, 190, 90), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Range = p.Range or 16
	light.Brightness = 1.6
	light.Color = glow.Color
	light.Parent = glow
end

Props.Shelf = function(parent, cf, p)
	local len = p.Length or 8
	local h = p.Height or 9
	local c = Color3.fromRGB(70, 110, 190)
	for _, x in { -len / 2 + 0.3, len / 2 - 0.3 } do
		deco(parent, V(0.5, h, 3), cf * CF(x, h / 2, 0), c, Enum.Material.Metal)
	end
	local colors = { Color3.fromRGB(205, 160, 105), Color3.fromRGB(190, 150, 100), Color3.fromRGB(220, 180, 120) }
	for i, y in { 0.4, h * 0.4, h * 0.8 } do
		deco(parent, V(len, 0.3, 3), cf * CF(0, y, 0), Color3.fromRGB(230, 140, 60), Enum.Material.Metal)
		for j = 0, math.floor(len / 2.4) - 1 do
			deco(parent, V(2, 1.6, 2.2), cf * CF(-len / 2 + 1.4 + j * 2.4, y + 0.95, 0), colors[(i + j) % 3 + 1], Enum.Material.Cardboard)
		end
	end
end

Props.Pallet = function(parent, cf, _p)
	deco(parent, V(4, 0.6, 4), cf * CF(0, 0.3, 0), Color3.fromRGB(200, 160, 110), Enum.Material.WoodPlanks)
end

Props.Forklift = function(parent, cf, _p)
	local y = Color3.fromRGB(246, 196, 50)
	deco(parent, V(3.6, 2.4, 5), cf * CF(0, 1.8, 0), y, smooth)
	deco(parent, V(3.4, 0.3, 3.4), cf * CF(0, 5.4, -0.5), Color3.fromRGB(40, 40, 46), Enum.Material.Metal)
	for _, x in { -1.6, 1.6 } do
		deco(parent, V(0.3, 4.6, 0.3), cf * CF(x, 3.3, -1.8), Color3.fromRGB(40, 40, 46), Enum.Material.Metal)
		deco(parent, V(0.3, 4.6, 0.3), cf * CF(x, 3.3, 1), Color3.fromRGB(40, 40, 46), Enum.Material.Metal)
	end
	for _, x in { -1, 1 } do
		deco(parent, V(0.6, 0.3, 3), cf * CF(x * 0.9, 0.4, -4), Color3.fromRGB(80, 80, 86), Enum.Material.Metal)
	end
	deco(parent, V(0.5, 4.6, 0.5), cf * CF(0, 2.3, -2.7), Color3.fromRGB(80, 80, 86), Enum.Material.Metal)
end

Props.Cone = function(parent, cf, _p)
	deco(parent, V(1.4, 0.2, 1.4), cf * CF(0, 0.1, 0), Color3.fromRGB(240, 110, 40))
	deco(parent, V(0.9, 1.6, 0.9), cf * CF(0, 1, 0), Color3.fromRGB(240, 110, 40), smooth, Enum.PartType.Ball)
end

Props.Tombstone = function(parent, cf, _p)
	deco(parent, V(2.2, 2.8, 0.7), cf * CF(0, 1.4, 0), Color3.fromRGB(150, 150, 160), Enum.Material.Slate)
	deco(parent, V(0.7, 2.2, 2.2), cf * CF(0, 2.8, 0) * CFrame.Angles(0, rad(90), rad(90)), Color3.fromRGB(150, 150, 160), Enum.Material.Slate, Enum.PartType.Cylinder)
end

Props.Pumpkin = function(parent, cf, _p)
	deco(parent, V(2, 1.6, 2), cf * CF(0, 0.8, 0), Color3.fromRGB(240, 130, 40), smooth, Enum.PartType.Ball)
	deco(parent, V(0.3, 0.6, 0.3), cf * CF(0, 1.8, 0), Color3.fromRGB(80, 120, 50))
	local glow = deco(parent, V(0.6, 0.4, 0.1), cf * CF(0, 0.9, 0.95), Color3.fromRGB(255, 220, 90), Enum.Material.Neon)
	glow.CanCollide = false
end

Props.Parasol = function(parent, cf, p)
	deco(parent, V(0.3, 7, 0.3), cf * CF(0, 3.5, 0), Color3.fromRGB(240, 240, 240))
	local c = p.Color or Color3.fromRGB(240, 90, 90)
	local top = deco(parent, V(1.2, 7, 7), cf * CF(0, 7, 0) * CFrame.Angles(0, 0, rad(90)), c, Enum.Material.Fabric, Enum.PartType.Cylinder)
	top.CanCollide = false
end

Props.Bathtub = function(parent, cf, _p)
	deco(parent, V(3.4, 2.4, 6.4), cf * CF(0, 1.2, 0), Color3.fromRGB(245, 245, 248))
	local water = deco(parent, V(2.6, 0.1, 5.6), cf * CF(0, 2.2, 0), Color3.fromRGB(150, 210, 240), Enum.Material.Glass)
	water.Transparency = 0.3
end

Props.Fireplace = function(parent, cf, _p)
	deco(parent, V(6, 6, 1.6), cf * CF(0, 3, 0), Color3.fromRGB(170, 90, 70), Enum.Material.Brick)
	local hole = deco(parent, V(3, 2.6, 0.2), cf * CF(0, 1.5, 0.75), Color3.fromRGB(30, 24, 22))
	hole.CanCollide = false
	local fire = deco(parent, V(1.6, 1.2, 0.3), cf * CF(0, 1, 0.8), Color3.fromRGB(255, 150, 60), Enum.Material.Neon, Enum.PartType.Ball)
	fire.CanCollide = false
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Parent = fire
end

Props.Block = function(parent, cf, p)
	local s = p.Size or { 4, 4, 4 }
	local b = deco(parent, V(s[1], s[2], s[3]), cf * CF(0, s[2] / 2, 0), p.Color or Color3.fromRGB(200, 200, 200), p.Material or smooth)
	if p.Fadeable then
		b:SetAttribute("Fadeable", true)
	end
end

Props.Sign = function(parent, cf, p)
	deco(parent, V(0.3, 4, 0.3), cf * CF(-1.6, 2, 0), Color3.fromRGB(120, 90, 70), Enum.Material.Wood)
	deco(parent, V(0.3, 4, 0.3), cf * CF(1.6, 2, 0), Color3.fromRGB(120, 90, 70), Enum.Material.Wood)
	local board = deco(parent, V(4.4, 2, 0.3), cf * CF(0, 3.6, 0), p.Color or Color3.fromRGB(250, 240, 210), Enum.Material.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- +Z, toward the camera
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = p.Text or "SOLD"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.fromRGB(200, 60, 60)
	label.Parent = gui
end

Props.Cobweb = function(parent, cf, _p)
	local w = deco(parent, V(3, 3, 0.1), cf * CF(0, 6, 0) * CFrame.Angles(0, 0, rad(45)), Color3.fromRGB(230, 230, 240), Enum.Material.Fabric)
	w.Transparency = 0.6
	w.CanCollide = false
end

----------------------------------------------------------------------------------------

-- Spawns one furniture item and records its home (recovery) transform.
function LevelBuilder.SpawnItem(out: Built, spec: any, index: number)
	local data = FurnitureData.Get(spec.Kind)
	local model = FurnitureModels.Build(spec.Kind, spec.Tint)
	local id = spec.Id or (spec.Kind .. "_" .. index)
	model.Name = id
	local pos = v3(spec.Pos)
	local y = (spec.Y or pos.Y) + data.Size.Y / 2 + 0.05
	local cf = CF(pos.X, y, pos.Z) * CFrame.Angles(0, rad(spec.Rot or 0), 0)
	model:PivotTo(cf)
	model:SetAttribute("ItemId", id)
	model:SetAttribute("Kind", spec.Kind)
	model:SetAttribute("Class", data.Class)
	model:SetAttribute("Required", spec.Required ~= false)
	model:SetAttribute("Delivered", false)
	model:SetAttribute("Holders", 0)
	model:SetAttribute("MaxHolders", data.Holders)
	model:SetAttribute("DisplayName", data.Name)
	model.Parent = out.ItemsFolder
	out.Items[id] = model
	table.insert(out.ItemOrder, id)
	out.ItemHomes[id] = spec.Home and (CF(v3(spec.Home)) + V(0, data.Size.Y / 2 + 0.05, 0)) or cf
end

-- Soft pastel colour grade (a ColorCorrectionEffect in Lighting, replicated to every
-- client). Levels tune it with `Grade = { Saturation, Contrast, Brightness, TintColor }`.
function LevelBuilder.ApplyGrade(level: any)
	local Lighting = game:GetService("Lighting")
	local cc = Lighting:FindFirstChild("LevelGrade") :: ColorCorrectionEffect?
	if not cc then
		local made = Instance.new("ColorCorrectionEffect")
		made.Name = "LevelGrade"
		made.Parent = Lighting
		cc = made
	end
	local g = level.Grade or {}
	local effect = cc :: ColorCorrectionEffect
	effect.Saturation = g.Saturation or 0.04
	effect.Contrast = g.Contrast or -0.08
	effect.Brightness = g.Brightness or 0.04
	effect.TintColor = g.TintColor or Color3.fromRGB(255, 252, 246)
	effect.Enabled = true
end

function LevelBuilder.Build(level: any, parent: Instance): Built
	local folder = Instance.new("Folder")
	folder.Name = "Level"
	local static = Instance.new("Folder")
	static.Name = "Static"
	static.Parent = folder
	local itemsFolder = Instance.new("Folder")
	itemsFolder.Name = "Items"
	itemsFolder.Parent = folder

	local out: Built = {
		Folder = folder,
		Static = static,
		ItemsFolder = itemsFolder,
		Items = {},
		ItemOrder = {},
		ItemHomes = {},
		Truck = nil :: any,
		Spawns = {},
		Breakables = {},
		Bounds = {
			Min = v3(level.Bounds.Min, -40),
			Max = v3(level.Bounds.Max, 80),
		},
	}

	-- a big base so nothing falls through gaps between zones, with holes for water
	local bmin, bmax = out.Bounds.Min, out.Bounds.Max
	local pieces = { { Min = Vector2.new(bmin.X - 90, bmin.Z - 90), Max = Vector2.new(bmax.X + 90, bmax.Z + 90) } }
	for _, hz in level.Hazards or {} do
		if hz.Kind == "Water" then
			local hole = { Min = v2(hz.Min), Max = v2(hz.Max) }
			local nextPieces = {}
			for _, r in pieces do
				for _, piece in subtractRect(r, hole) do
					table.insert(nextPieces, piece)
				end
			end
			pieces = nextPieces
		end
	end
	for _, r in pieces do
		local base = rect(static, r.Min, r.Max, -0.02, 4, level.BaseColor or PALETTE.Grass[1], level.BaseMaterial or PALETTE.Grass[2], "Base")
		base:SetAttribute("Ground", true)
	end

	local holes = {}
	for _, hz in level.Hazards or {} do
		if hz.Kind == "Water" then
			table.insert(holes, { Min = v2(hz.Min), Max = v2(hz.Max) })
		end
	end
	for _, g in level.Ground or {} do
		local pal = PALETTE[g.Kind] or PALETTE.Concrete
		local zonePieces = { { Min = v2(g.Min), Max = v2(g.Max) } }
		for _, hole in holes do
			local nextPieces = {}
			for _, r in zonePieces do
				for _, piece in subtractRect(r, hole) do
					table.insert(nextPieces, piece)
				end
			end
			zonePieces = nextPieces
		end
		local top = g.Top or 0.02
		local color = g.Color or pal[1]
		for _, r in zonePieces do
			local zone = rect(static, r.Min, r.Max, top, 1, color, g.Material or pal[2], g.Kind)
			zone:SetAttribute("Ground", true)
			if g.Pattern then
				pattern(static, r.Min, r.Max, top, g, color)
			elseif g.Kind == "Pavement" and g.Joints ~= false then
				-- paving slabs: joint lines across the long axis
				pattern(static, r.Min, r.Max, top, { Pattern = "Grid", Tile = g.Tile or 4, Line = 0.14, Color2 = shade(color, -0.14) }, color)
			elseif g.Kind == "Concrete" and g.Joints ~= false then
				pattern(static, r.Min, r.Max, top, { Pattern = "Grid", Tile = g.Tile or 8, Color2 = shade(color, -0.1) }, color)
			end
		end
		if g.Kind == "Road" then
			-- white dashed centre line and kerbs along both long edges
			local min, max = v2(g.Min), v2(g.Max)
			local alongX = (max.X - min.X) > (max.Y - min.Y)
			local len = alongX and (max.X - min.X) or (max.Y - min.Y)
			local n = math.floor(len / 7)
			for i = 0, n - 1 do
				local t = (i + 0.5) / n
				local pos = alongX and V(min.X + t * len, top + 0.02, (min.Y + max.Y) / 2) or V((min.X + max.X) / 2, top + 0.02, min.Y + t * len)
				local dash = deco(static, alongX and V(3.2, 0.04, 0.5) or V(0.5, 0.04, 3.2), CF(pos), Color3.fromRGB(250, 250, 246), smooth)
				noTouch(dash)
			end
			if g.Kerb ~= false then
				local kc = Color3.fromRGB(226, 224, 218)
				for _, e in { 0, 1 } do
					local kerb
					if alongX then
						local z = e == 0 and min.Y + 0.25 or max.Y - 0.25
						kerb = deco(static, V(len, 0.3, 0.5), CF((min.X + max.X) / 2, top + 0.15, z), kc, Enum.Material.Concrete)
					else
						local x = e == 0 and min.X + 0.25 or max.X - 0.25
						kerb = deco(static, V(0.5, 0.3, len), CF(x, top + 0.15, (min.Y + max.Y) / 2), kc, Enum.Material.Concrete)
					end
					noTouch(kerb)
				end
			end
		end
	end

	-- room floors: a slab per room plus its pattern; rooms also paint the walls facing them
	local rooms: { Room } = {}
	for _, r in level.Floors or {} do
		local pal = PALETTE[r.Kind] or PALETTE.Wood
		local color = r.Color or pal[1]
		local f = rect(static, v2(r.Min), v2(r.Max), 0.1, 0.4, color, r.Material or pal[2], "Floor")
		f:SetAttribute("Ground", true)
		pattern(static, v2(r.Min), v2(r.Max), 0.1, r, color)
		table.insert(rooms, { Min = v2(r.Min), Max = v2(r.Max), Color = r.Wall, Material = r.WallMaterial })
	end

	local style = table.clone(WALL_STYLE) :: any
	local camYaw = rad((level.Camera and level.Camera.Yaw) or 25)
	style.CameraDir = Vector2.new(math.sin(camYaw), math.cos(camYaw))
	for k, v in level.WallStyle or {} do
		(style :: any)[k] = v
	end
	for _, w in level.Walls or {} do
		wall(static, w, out, style, rooms)
	end

	-- grass tufts and flowers wherever the visible ground is grass
	if level.GrassDetail ~= 0 then
		local zones = level.Ground or {}
		local baseGrass = (level.BaseMaterial == nil or level.BaseMaterial == Enum.Material.Grass) and "Grass" or nil
		local baseColor = level.BaseColor or PALETTE.Grass[1]
		scatterGrass(static, level, function(p: Vector2): (string?, Color3?)
			for _, r in rooms do
				if p.X > r.Min.X - 1 and p.X < r.Max.X + 1 and p.Y > r.Min.Y - 1 and p.Y < r.Max.Y + 1 then
					return nil
				end
			end
			for _, hole in holes do
				if p.X > hole.Min.X - 1 and p.X < hole.Max.X + 1 and p.Y > hole.Min.Y - 1 and p.Y < hole.Max.Y + 1 then
					return nil
				end
			end
			local best, bestTop, bestColor = baseGrass, -1, baseColor
			for _, g in zones do
				local mn, mx = v2(g.Min), v2(g.Max)
				if p.X >= mn.X and p.X <= mx.X and p.Y >= mn.Y and p.Y <= mx.Y and (g.Top or 0.02) >= bestTop then
					bestTop = g.Top or 0.02
					best = (g.Kind == "Grass" or g.Kind == "DeadGrass") and g.Kind or nil
					bestColor = g.Color or (PALETTE[g.Kind] and PALETTE[g.Kind][1]) or baseColor
				end
			end
			return best, bestColor
		end)
	end

	-- the camera frames this area (house + truck); default: floors and the truck's rear
	local cam = level.Camera or {}
	local vmin, vmax
	if cam.View then
		vmin, vmax = v2(cam.View.Min), v2(cam.View.Max)
	else
		for _, r in rooms do
			vmin = vmin and vmin:Min(r.Min) or r.Min
			vmax = vmax and vmax:Max(r.Max) or r.Max
		end
	end
	if vmin and vmax then
		folder:SetAttribute("ViewMin", V(vmin.X, 0, vmin.Y))
		folder:SetAttribute("ViewMax", V(vmax.X, 0, vmax.Y))
	end

	LevelBuilder.ApplyGrade(level)

	for _, p in level.Props or {} do
		local builder = Props[p.Kind]
		if builder then
			local cf = CF(v3(p.Pos)) * CFrame.Angles(0, rad(p.Rot or 0), 0)
			builder(static, cf, p)
		else
			warn("LevelBuilder: unknown prop " .. tostring(p.Kind))
		end
	end

	local truckModel, cargo, cargoSize, rear = TruckBuilder.Build(folder, level.Truck)
	out.Truck = { Model = truckModel, Cargo = cargo, CargoSize = cargoSize, Rear = rear }

	for i, spec in level.Items or {} do
		LevelBuilder.SpawnItem(out, spec, i)
	end

	for _, s in level.Spawns do
		table.insert(out.Spawns, v3(s, 3))
	end

	folder.Parent = parent
	return out
end

LevelBuilder.Props = Props
LevelBuilder.TruckFloor = TruckBuilder.Floor

return LevelBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">MoverBuilder</string>
          <string name="Source"><![CDATA[--[[
	MoverBuilder.luau
	Dresses a scaled-down R15 character as a cartoon mover (Movers.Build: a big blocky
	head in the chosen style, a short body in the player's slot colour with the slot
	number, brown work gloves, chunky boots). The R15 parts stay (Roblox animates and
	collides them) but are hidden; the costume parts are welded on, massless, and never
	collide or block queries.
	The client animates carrying / slapping / throwing on top (MoverAnimator.luau).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Movers = require(ReplicatedStorage.Shared.Movers)

local MoverBuilder = {}


function MoverBuilder.Dress(character: Model, styleIndex: number, slotColor: Color3)
	local old = character:FindFirstChild("Costume")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Costume"

	-- hide the R15 body; the costume is the look
	local parts: { [string]: BasePart } = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Decal") then
			if d.Name == "face" then
				d:Destroy()
			end
		elseif d:IsA("BasePart") then
			if d.Name ~= "HumanoidRootPart" then
				d.Transparency = 1
				d.CastShadow = false
				if d.Parent == character then
					parts[d.Name] = d
				end
			end
		elseif d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end

	local slot = (character:GetAttribute("Slot") :: number?) or 0
	Movers.Build(folder, parts, styleIndex, slotColor, slot, true)
	folder.Parent = character
end

function MoverBuilder.Description(config: any): HumanoidDescription
	local d = Instance.new("HumanoidDescription")
	d.HeightScale = config.HeightScale
	d.WidthScale = config.WidthScale
	d.DepthScale = config.DepthScale
	d.HeadScale = 1
	d.BodyTypeScale = 0
	d.ProportionScale = 0
	return d
end

return MoverBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--[[
	PlayerService.luau
	Mover slots (P1-P4), spawning, costumes, stuns, respawning and walking speed.

	A player chooses PLAY on the title screen to take a free slot and get a mover; with
	all four slots taken they watch as a spectator until one frees up. The leader (host)
	is the mover with the lowest slot number; only they pick jobs and restart.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Movers = require(ReplicatedStorage.Shared.Movers)
local S = require(script.Parent.Services)
local MoverBuilder = require(script.Parent.MoverBuilder)

local PlayerService = {}

local slots: { [number]: Player } = {}
local frozen = false

local function now(): number
	return Workspace:GetServerTimeNow()
end

function PlayerService.Slot(player: Player): number
	return (player:GetAttribute("Slot") :: number?) or 0
end

function PlayerService.Movers(): { Player }
	local list = {}
	for i = 1, Config.MaxMovers do
		local p = slots[i]
		if p and p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

function PlayerService.MoverCount(): number
	return #PlayerService.Movers()
end

function PlayerService.Leader(): Player?
	return PlayerService.Movers()[1]
end

function PlayerService.IsLeader(player: Player): boolean
	return PlayerService.Leader() == player
end

local function updateLeader()
	local leader = PlayerService.Leader()
	Net.State():SetAttribute("Leader", leader and leader.UserId or 0)
	Net.State():SetAttribute("MoverCount", PlayerService.MoverCount())
end

function PlayerService.Root(player: Player): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function PlayerService.Humanoid(player: Player): Humanoid?
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

function PlayerService.IsStunned(player: Player): boolean
	return (player:GetAttribute("StunUntil") or 0) > now()
end

function PlayerService.IsProtected(player: Player): boolean
	return (player:GetAttribute("ProtectUntil") or 0) > now()
end

-- Walking speed: 0 when frozen / stunned / paused, reduced while carrying.
function PlayerService.UpdateSpeed(player: Player)
	local hum = PlayerService.Humanoid(player)
	if not hum then
		return
	end
	local speed = Config.Movement.WalkSpeed
	local jump = Config.Movement.JumpHeight
	if frozen or S.World.Paused or PlayerService.IsStunned(player) then
		speed = 0
		jump = 0
	else
		local factor = S.Carry and S.Carry.SpeedFactor(player) or 1
		speed *= factor
	end
	hum.WalkSpeed = speed
	hum.JumpHeight = jump
end

function PlayerService.UpdateAllSpeeds()
	for _, p in PlayerService.Movers() do
		PlayerService.UpdateSpeed(p)
	end
end

-- Freeze all movers in place (briefing / countdown / results).
function PlayerService.SetFrozen(value: boolean)
	frozen = value
	PlayerService.UpdateAllSpeeds()
end

function PlayerService.Stun(player: Player, seconds: number, dropItem: boolean)
	if PlayerService.IsProtected(player) then
		return
	end
	player:SetAttribute("StunUntil", now() + seconds)
	if dropItem and S.Carry then
		S.Carry.ReleasePlayer(player, "stun")
	end
	PlayerService.UpdateSpeed(player)
	S.Fx.All("Stun", { UserId = player.UserId, Duration = seconds })
	task.delay(seconds + 0.05, function()
		if player.Parent then
			PlayerService.UpdateSpeed(player)
		end
	end)
end

function PlayerService.Knock(player: Player, velocity: Vector3)
	local root = PlayerService.Root(player)
	if root then
		root.AssemblyLinearVelocity = velocity
	end
end

local function spawnPoint(player: Player): Vector3
	local level = S.World.Level
	local slot = math.max(1, PlayerService.Slot(player))
	if level and #level.Spawns > 0 then
		return level.Spawns[(slot - 1) % #level.Spawns + 1]
	end
	return Vector3.new(0, 5, 0)
end

-- Puts a mover back on their spawn point (new level, restart, fell in water).
function PlayerService.Respawn(player: Player, pos: Vector3?)
	local char = player.Character
	local root = PlayerService.Root(player)
	if not char or not root then
		return
	end
	if S.Carry then
		S.Carry.ReleasePlayer(player, "respawn")
	end
	local p = pos or spawnPoint(player)
	local facing = S.World.Data and S.World.Data.SpawnFacing or 0
	char:PivotTo(CFrame.new(p + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(facing), 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	player:SetAttribute("StunUntil", 0)
	player:SetAttribute("ProtectUntil", now() + Config.Stun.RespawnProtect)
	PlayerService.UpdateSpeed(player)
end

function PlayerService.RespawnAll()
	for _, p in PlayerService.Movers() do
		PlayerService.Respawn(p)
	end
end

local function dress(player: Player)
	local char = player.Character
	if not char then
		return
	end
	local slot = PlayerService.Slot(player)
	local color = Config.Slots[slot] and Config.Slots[slot].Color or Color3.fromRGB(200, 200, 200)
	char:SetAttribute("Slot", slot)
	MoverBuilder.Dress(char, (player:GetAttribute("Style") :: number?) or 1, color)
end

local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	hum.UseJumpPower = false
	dress(player)
	PlayerService.Respawn(player)
	hum.Died:Connect(function()
		-- should not happen (Dead is disabled) but never leave a player stuck
		task.wait(1)
		if player.Parent and PlayerService.Slot(player) > 0 then
			PlayerService.SpawnCharacter(player)
		end
	end)
end

function PlayerService.SpawnCharacter(player: Player)
	if PlayerService.Slot(player) == 0 then
		return
	end
	local desc = MoverBuilder.Description(Config.Movement)
	local ok, err = pcall(function()
		player:LoadCharacterWithHumanoidDescriptionAsync(desc)
	end)
	if not ok then
		warn("PlayerService: spawn failed for " .. player.Name .. ": " .. tostring(err))
	end
end

-- Takes a free slot for the player (from the title screen PLAY button).
function PlayerService.Join(player: Player)
	if PlayerService.Slot(player) > 0 then
		return
	end
	for i = 1, Config.MaxMovers do
		if not slots[i] or not slots[i].Parent then
			slots[i] = player
			player:SetAttribute("Slot", i)
			updateLeader()
			PlayerService.SpawnCharacter(player)
			S.Jobs.OnMoversChanged()
			return
		end
	end
	S.Fx.Toast(player, "All four mover slots are taken - watching for now.")
	player:SetAttribute("Spectator", true)
end

function PlayerService.Leave(player: Player)
	local slot = PlayerService.Slot(player)
	if S.Carry then
		S.Carry.ReleasePlayer(player, "leave")
	end
	if slot > 0 and slots[slot] == player then
		slots[slot] = nil
	end
	player:SetAttribute("Slot", 0)
	if player.Character then
		player.Character:Destroy()
		player.Character = nil
	end
	updateLeader()
	S.Jobs.OnMoversChanged()
	-- a spectator can take the free slot
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Spectator") and PlayerService.Slot(p) == 0 then
			p:SetAttribute("Spectator", false)
			PlayerService.Join(p)
			break
		end
	end
end

function PlayerService.SetStyle(player: Player, style: any)
	if type(style) ~= "number" or style ~= style then
		return
	end
	style = math.clamp(math.floor(style), 1, #Movers.Styles)
	player:SetAttribute("Style", style)
	local profile = S.Data.Get(player)
	if profile then
		profile.Style = style
		S.Data.MarkDirty(player)
	end
	dress(player)
end

-- Movers that fell out of the world or into water get a respawn.
function PlayerService.Step()
	local level = S.World.Level
	if not level or S.World.Paused then
		return
	end
	for _, player in PlayerService.Movers() do
		local root = PlayerService.Root(player)
		if root and not player:GetAttribute("Recovering") then
			local pos = root.Position
			local inWater = S.Hazards and S.Hazards.InWater(pos)
			if pos.Y < Config.Recovery.KillY or inWater then
				player:SetAttribute("Recovering", true)
				S.Carry.ReleasePlayer(player, "fall")
				if inWater then
					S.Fx.All("Splash", { Pos = pos })
				end
				task.delay(Config.Recovery.PlayerDelay, function()
					player:SetAttribute("Recovering", false)
					if player.Parent then
						PlayerService.Respawn(player)
						S.Fx.All("Poof", { Pos = (PlayerService.Root(player) or root).Position })
					end
				end)
			end
		end
	end
end

function PlayerService.Init()
	local function onAdded(player: Player)
		player:SetAttribute("Slot", 0)
		player.CharacterAdded:Connect(function(char)
			setupCharacter(player, char)
		end)
		local profile = S.Data.Load(player)
		player:SetAttribute("Style", profile.Style)
		player:SetAttribute("SaveStatus", S.Data.Status(player))
	end
	Players.PlayerAdded:Connect(onAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerService.Leave(player)
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Services</string>
          <string name="Source"><![CDATA[--[[
	Services.luau
	A tiny registry so server systems can call each other without circular requires:
	each system registers itself in init.server.luau and looks others up at call time.
	World holds the state every system reads.
]]

local Services = {}

Services.World = {
	Level = nil :: any, -- LevelBuilder Built table of the loaded level
	Data = nil :: any, -- level data table
	IsJob = false, -- false in the lobby yard
	Active = false, -- gameplay systems run (lobby practice or a running job)
	Paused = false,
	SimTime = 0, -- gameplay clock: only advances while Active and not paused
	Assists = {} :: { [string]: any },
}

Services.Data = nil :: any
Services.Players = nil :: any
Services.Items = nil :: any
Services.Carry = nil :: any
Services.Truck = nil :: any
Services.Breakables = nil :: any
Services.Hazards = nil :: any
Services.Jobs = nil :: any
Services.Fx = nil :: any

return Services
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">TruckBuilder</string>
          <string name="Source"><![CDATA[--[[
	TruckBuilder.luau
	Builds the moving truck. Local frame: origin = centre of the rear edge at ground
	level, the cargo runs toward -Z, the ramp runs toward +Z down to the ground.
	Returns (model, cargo CFrame at the cargo volume centre, cargo size, rear CFrame).
	TruckService counts delivery inside the cargo volume, so keep those two in sync
	with the walls you build.

	Look: a chunky grey and white box van with an open top so the steep camera sees the
	cargo, thick walls with rounded caps, a low cab with windows at the front, a wide
	ribbed ramp at the rear, and a pale tiled cargo floor printed with blue chevron
	clusters pointing inward (the delivery zone).
]]

local TruckBuilder = {}

local V = Vector3.new
local CF = CFrame.new
local rad = math.rad
local smooth = Enum.Material.SmoothPlastic

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): Part
	local p = Instance.new("Part")
	p.Name = name or "Part"
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or smooth
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function v3(t: any): Vector3
	if typeof(t) == "Vector3" then
		return t
	end
	if #t == 3 then
		return V(t[1], t[2], t[3])
	end
	return V(t[1], 0, t[2])
end

-- Decoration only: never collides, never blocks raycasts or touches.
local function deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local COL = {
	body = Color3.fromRGB(214, 218, 224), -- light grey walls
	bodyLight = Color3.fromRGB(240, 242, 245), -- wall caps, cab
	bodyDark = Color3.fromRGB(150, 156, 166), -- skirts, ramp ribs
		floor = Color3.fromRGB(226, 233, 240), -- pale cargo tiles
	arrow = Color3.fromRGB(62, 108, 232), -- delivery chevrons
	chassis = Color3.fromRGB(58, 60, 68),
	tyre = Color3.fromRGB(38, 38, 44),
	hub = Color3.fromRGB(200, 204, 210),
	glass = Color3.fromRGB(130, 196, 232),
	lamp = Color3.fromRGB(255, 236, 160),
	tail = Color3.fromRGB(232, 72, 64),
	ramp = Color3.fromRGB(176, 182, 192),
}

-- Prints the delivery zone on the cargo floor's top face: clusters of four blue
-- chevrons pointing at each tile centre, like the original's drop zone. GUI frames,
-- not parts, so the whole pattern costs no physics.
local function paintCargoFloor(floor: BasePart, W: number, L: number)
	local stud = 24
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DropZone"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = stud
	gui.LightInfluence = 1
	gui.Parent = floor
	local nx = math.max(2, math.floor(W / 3.4 + 0.5))
	local nz = math.max(2, math.floor(L / 3.4 + 0.5))
	local tx, tz = W / nx, L / nz
	local function bar(cx: number, cy: number, w: number, h: number, angle: number)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = COL.arrow
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(cx * stud, cy * stud)
		f.Size = UDim2.fromOffset(w * stud, h * stud)
		f.Rotation = angle
		f.Parent = gui
	end
	local head = 0.62 -- side of the diamond arrow head
	local half = head * math.sqrt(0.5)
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local cx, cy = (ix + 0.5) * tx, (iz + 0.5) * tz
			for _, u in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				local ux, uy = u[1], u[2]
				local tip = 0.16 -- gap between the tips and the cluster centre
				-- head: a diamond whose inner corner is the tip, then a short stem
				bar(cx + ux * (tip + half), cy + uy * (tip + half), head, head, 45)
				local st = tip + half * 2 + 0.05
				bar(cx + ux * st, cy + uy * st, ux ~= 0 and 0.5 or 0.24, ux ~= 0 and 0.24 or 0.5, 0)
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- The moving truck. Local frame: origin = centre of the rear edge at ground level, the
-- cargo runs toward -Z, the ramp runs toward +Z down to the ground.

local TRUCK_FLOOR = 2
function TruckBuilder.Build(parent: Instance, t: any): (Model, CFrame, Vector3, CFrame)
	local model = Instance.new("Model")
	model.Name = "Truck"
	model.Parent = parent
	local L = t.Length or 18
	local W = t.Width or 11
	local H = t.Height or 7
	local root = CF(v3(t.Pos)) * CFrame.Angles(0, rad(t.Rot or 0), 0)
	local accent = t.Color or Color3.fromRGB(70, 130, 220)
	local function p(size: Vector3, local_: CFrame, color: Color3, material: Enum.Material?, name: string?): Part
		return part(model, size, root * local_, color, material, name or "TruckPart")
	end
	local function cyl(len: number, dia: number, local_: CFrame, color: Color3, name: string?): Part
		local c = p(V(len, dia, dia), local_, color, smooth, name)
		c.Shape = Enum.PartType.Cylinder
		return c
	end
	local alongZ = CFrame.Angles(0, rad(90), 0) -- cylinder axis X -> Z
	local function fade(x: BasePart): BasePart
		x:SetAttribute("Fadeable", true)
		return x
	end
	-- trim on the faded walls: queryable (so the camera can fade it) and collidable
	-- like the wall it sits on, so reach checks still treat the wall as solid
	local function fadeDeco(x: BasePart): BasePart
		x.CanTouch = false
		return fade(x)
	end

	local T = 1.1 -- wall thickness
	local top = TRUCK_FLOOR + H -- wall top
	local outer = W / 2 + T -- outside face of the side walls

	-- chassis and cargo floor (the floor carries the printed delivery zone)
	p(V(2 * outer - 0.6, TRUCK_FLOOR - 1.2, L + 7), CF(0, 0.8 + (TRUCK_FLOOR - 1.2) / 2, -L / 2 - 3.5), COL.chassis, smooth, "Chassis")
	local floor = p(V(W, 0.4, L), CF(0, TRUCK_FLOOR - 0.2, -L / 2), COL.floor, smooth, "CargoFloor")
	floor.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.6, 0.05)
	paintCargoFloor(floor, W, L)

	-- side walls: thick light-grey slabs with a rounded cap; the camera-side one fades
	for _, sx in { -1, 1 } do
		local x = sx * (W / 2 + T / 2)
		fade(p(V(T, H, L), CF(x, TRUCK_FLOOR + H / 2, -L / 2), COL.body, smooth, "CargoWall"))
		fadeDeco(cyl(L, T + 0.2, CF(x, top, -L / 2) * alongZ, COL.bodyLight, "WallCap"))
		fadeDeco(p(V(0.08, 0.9, L + 0.2), CF(sx * (outer + 0.04), TRUCK_FLOOR + 0.25, -L / 2), COL.bodyDark, smooth, "Skirt"))
		fadeDeco(p(V(0.08, 0.6, L - 1.2), CF(sx * (outer + 0.04), TRUCK_FLOOR + H - 1, -L / 2), accent, smooth, "Stripe"))
	end
	-- front wall
	fade(p(V(2 * outer, H, T), CF(0, TRUCK_FLOOR + H / 2, -L - T / 2), COL.body, smooth, "CargoFront"))
	fadeDeco(cyl(2 * outer, T + 0.2, CF(0, top, -L - T / 2), COL.bodyLight, "WallCap"))
	-- rear corner posts framing the open back, with tail lights
	for _, sx in { -1, 1 } do
		fade(p(V(T + 0.3, H + 0.4, 0.6), CF(sx * (W / 2 + T / 2), TRUCK_FLOOR + (H + 0.4) / 2, -0.3), COL.bodyLight, smooth, "RearPost"))
		deco(p(V(0.6, 0.4, 0.12), CF(sx * (W / 2 + T / 2), TRUCK_FLOOR + 0.6, 0.06), COL.tail, Enum.Material.Neon, "TailLight"))
	end

	-- cab: low, rounded, white with the accent band; kept below the cargo walls so it
	-- hides as little of the cargo as possible, and fadeable like the walls
	local cabL = 6
	local cabZ = -L - T - cabL / 2
	local nose = cabZ - cabL / 2
	local cabTop = top - 1.4
	local cabW = 2 * outer - 0.2
	fade(p(V(cabW, cabTop - 2, cabL), CF(0, 1 + (cabTop - 2) / 2, cabZ), COL.bodyLight, smooth, "Cab"))
	fade(cyl(cabW, 2, CF(0, cabTop - 1, nose + 1), COL.bodyLight, "CabRoof"))
	fade(p(V(cabW, 2, cabL - 1), CF(0, cabTop - 1, cabZ + 0.5), COL.bodyLight, smooth, "CabRoof"))
	fadeDeco(p(V(cabW + 0.12, 0.7, cabL + 0.12), CF(0, 2.4, cabZ), accent, smooth, "CabBand"))
	local winY = cabTop - 1.6
	fadeDeco(p(V(cabW - 1.4, 1.7, 0.12), CF(0, winY, nose - 0.02), COL.glass, Enum.Material.Glass, "Windscreen")).Transparency = 0.1
	for _, sx in { -1, 1 } do
		fadeDeco(p(V(0.12, 1.6, cabL * 0.45), CF(sx * (cabW / 2 + 0.02), winY, cabZ - cabL * 0.15), COL.glass, Enum.Material.Glass, "SideWindow")).Transparency = 0.1
		deco(p(V(0.3, 0.9, 0.5), CF(sx * (cabW / 2 + 0.25), winY, nose + 0.8), COL.chassis, smooth, "Mirror"))
		deco(p(V(1.4, 0.7, 0.12), CF(sx * (cabW / 2 - 1.3), 2.4, nose - 0.1), COL.lamp, Enum.Material.Neon, "Headlight"))
	end
	deco(p(V(cabW + 0.3, 0.8, 0.6), CF(0, 1.3, nose - 0.2), COL.chassis, smooth, "Bumper"))
	deco(p(V(W * 0.4, 0.9, 0.1), CF(0, 2.4, nose - 0.08), COL.bodyDark, smooth, "Grille"))

	-- wheels with grey hubs (decoration, no collision so they never snag furniture)
	for _, z in { -2.6, -L + 3, cabZ } do
		for _, sx in { -1, 1 } do
			local x = sx * (outer - 0.5)
			deco(cyl(1.2, 3, CF(x, 1.5, z), COL.tyre, "Wheel"))
			deco(cyl(1.3, 1.4, CF(x, 1.5, z), COL.hub, "Hub"))
		end
	end

	-- ramp from the rear edge down to the ground: wide, grey, ribbed, with side rails
	local rampLen = t.RampLength or 6
	local angle = math.atan2(TRUCK_FLOOR, rampLen)
	local slope = math.sqrt(rampLen * rampLen + TRUCK_FLOOR * TRUCK_FLOOR)
	local rampCF = CF(0, TRUCK_FLOOR / 2 - 0.15, rampLen / 2) * CFrame.Angles(-angle, 0, 0)
	local ramp = p(V(W, 0.4, slope), rampCF, COL.ramp, smooth, "Ramp")
	ramp.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.7, 0.05)
	for i = -2, 2 do
		deco(p(V(0.25, 0.06, slope - 0.6), rampCF * CF(i * W / 5.5, 0.22, 0), COL.bodyDark, smooth, "RampRib"))
	end
	for _, sx in { -1, 1 } do
		deco(p(V(0.4, 0.4, slope), rampCF * CF(sx * (W / 2 - 0.2), 0.3, 0), COL.bodyDark, smooth, "RampRail"))
	end

	-- cargo boundary: a blue line across the opening
	deco(p(V(W, 0.06, 0.35), CF(0, TRUCK_FLOOR + 0.03, -0.2), COL.arrow, smooth, "CargoLine"))

	-- company sign on both sides
	for _, sx in { -1, 1 } do
		local board = fadeDeco(p(V(0.1, 2.2, 8), CF(sx * (outer + 0.06), TRUCK_FLOOR + H * 0.42, -L / 2), COL.bodyLight, smooth, "Logo"))
		local gui = Instance.new("SurfaceGui")
		gui.Face = sx > 0 and Enum.NormalId.Right or Enum.NormalId.Left
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 1
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "MOVING OUT"
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = accent
		label.Parent = gui
	end

	local cargo = root * CF(0, TRUCK_FLOOR + H / 2, -L / 2)
	local cargoSize = V(W, H, L)
	return model, cargo, cargoSize, root
end

TruckBuilder.Floor = TRUCK_FLOOR

return TruckBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">TruckService</string>
          <string name="Source"><![CDATA[--[[
	TruckService.luau
	The one authority on delivery. Reconstruction rule (not taken from the original):
	  * the 8 corners of an item's collider box are tested in truck-cargo space;
	  * an item becomes delivered when at least Config.Delivery.InFraction of its corners
	    are inside the cargo volume (Tolerance studs of slack), nobody holds it, and that
	    stayed true for SettleTime seconds;
	  * a delivered item stops counting when fewer than OutFraction corners are inside
	    (hysteresis, so items on the boundary don't flicker);
	  * stacked items count if they are inside the volume (its top is open).
	The displayed count is always derived from the per-item states, never incremented by
	collision callbacks, and completion is checked only after states update.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local S = require(script.Parent.Services)

local TruckService = {}

local pendingSince: { [Model]: number } = {}
local accumulator = 0

-- Fraction (0..1) of an item's box corners inside the truck cargo volume.
function TruckService.InsideFraction(body: BasePart, cargo: CFrame, cargoSize: Vector3): number
	local tol = Config.Delivery.Tolerance
	local half = body.Size / 2
	local limit = cargoSize / 2
	local inside = 0
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			for _, sz in { -1, 1 } do
				local world = body.CFrame:PointToWorldSpace(Vector3.new(sx * half.X, sy * half.Y, sz * half.Z))
				local l = cargo:PointToObjectSpace(world)
				-- the cargo top is open: allow stacks to poke out above the walls
				if math.abs(l.X) <= limit.X + tol and math.abs(l.Z) <= limit.Z + tol and l.Y >= -limit.Y - tol and l.Y <= limit.Y + 6 then
					inside += 1
				end
			end
		end
	end
	return inside / 8
end

function TruckService.Counts(): (number, number)
	local lvl = S.World.Level
	if not lvl then
		return 0, 0
	end
	local delivered, required = 0, 0
	for _, model in lvl.Items do
		if model:GetAttribute("Required") then
			required += 1
			if model:GetAttribute("Delivered") then
				delivered += 1
			end
		end
	end
	return delivered, required
end

local function publish()
	local d, r = TruckService.Counts()
	local state = Net.State()
	state:SetAttribute("Delivered", d)
	state:SetAttribute("Required", r)
	return d, r
end

function TruckService.Reset()
	table.clear(pendingSince)
	accumulator = 0
	publish()
end

local function setDelivered(model: Model, value: boolean)
	if (model:GetAttribute("Delivered") == true) == value then
		return
	end
	model:SetAttribute("Delivered", value)
	local body = model.PrimaryPart
	S.Fx.All("Deliver", { Item = model.Name, Delivered = value, Pos = body and body.Position, Required = model:GetAttribute("Required") })
	if value and S.World.Assists.VanishDelivered and S.World.IsJob then
		task.delay(Config.Delivery.VanishDelay, function()
			if model:GetAttribute("Delivered") and model.Parent then
				S.Items.Vanish(model)
			end
		end)
	end
end

function TruckService.Step(dt: number)
	local lvl = S.World.Level
	if not lvl or S.World.Paused then
		return
	end
	accumulator += dt
	if accumulator < Config.Tick.DeliveryInterval then
		return
	end
	local step = accumulator
	accumulator = 0
	local truck = lvl.Truck
	local changed = false
	for _, model in lvl.Items do
		if model:GetAttribute("Vanished") then
			continue -- vanished items stay delivered
		end
		local body = model.PrimaryPart
		if not body or not model.Parent or model:GetAttribute("Recovering") then
			if model:GetAttribute("Delivered") then
				setDelivered(model, false)
				changed = true
			end
			pendingSince[model] = nil
			continue
		end
		local frac = TruckService.InsideFraction(body, truck.Cargo, truck.CargoSize)
		local wasDelivered = model:GetAttribute("Delivered") == true
		if wasDelivered then
			if frac < Config.Delivery.OutFraction then
				setDelivered(model, false)
				changed = true
			end
		else
			if frac >= Config.Delivery.InFraction and not S.Carry.IsHeld(model) then
				pendingSince[model] = (pendingSince[model] or 0) + step
				if pendingSince[model] >= Config.Delivery.SettleTime then
					pendingSince[model] = nil
					setDelivered(model, true)
					changed = true
				end
			else
				pendingSince[model] = nil
			end
		end
	end
	if changed then
		local d, r = publish()
		if S.World.IsJob and r > 0 and d >= r then
			S.Jobs.OnAllDelivered()
		end
	end
end

return TruckService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="32">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="33">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="34">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">200</float>
      <float name="CameraMinZoomDistance">10</float>
      <float name="CharacterJumpHeight">3.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="35">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="36">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client entry point. Boot order: loading screen -> systems -> title screen.
	Gameplay authority is the server; the client renders, animates, plays sound and
	sends requests.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local State = require(script.State)
local UI = require(script.UI)
local Audio = require(script.Audio)
local Effects = require(script.Effects)
local Input = require(script.Input)
local Targeting = require(script.Targeting)
local CameraController = require(script.CameraController)
local MoverAnimator = require(script.MoverAnimator)
local Menus = require(script.Menus)
local Hud = require(script.Hud)

pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)
for _, t in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(t, false)
	end)
end

-- loading screen until the world and the profile are here
local loadingRoot = UI.Root("Loading", 100)
local cover = Instance.new("Frame")
cover.Size = UDim2.fromScale(1, 1)
cover.BackgroundColor3 = Color3.fromRGB(255, 196, 80)
cover.Parent = loadingRoot
local title = UI.Title(cover, "MOVING OUT", UDim2.fromScale(0.7, 0.18), UDim2.fromScale(0.5, 0.42), Color3.new(1, 1, 1))
title.AnchorPoint = Vector2.new(0.5, 0.5)
local sub = UI.Title(cover, "Loading the truck...", UDim2.fromScale(0.5, 0.06), UDim2.fromScale(0.5, 0.58), Color3.new(1, 1, 1))
sub.AnchorPoint = Vector2.new(0.5, 0.5)

UI.Init()
Audio.Init()
Effects.Init()
Input.Init()
Targeting.Init()
Input.SetTargetProvider(Targeting.Current)
CameraController.Init()
MoverAnimator.Init()
Menus.Init()
Hud.Init()

local function applyQuality()
	Lighting.GlobalShadows = State.Settings().Quality ~= "Low"
end
State.SettingsChanged:Connect(applyQuality)

task.spawn(function()
	State.LoadProfile()
	applyQuality()
	local t0 = os.clock()
	while not Workspace:FindFirstChild("Level") and os.clock() - t0 < 15 do
		task.wait(0.1)
	end
	cover:Destroy()
	Menus.FollowPhase()
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--[[
	Audio.luau
	Effects and generated music, mixed by the player's settings (master / music /
	effects volume, mute).

	* Effects come from Config.Sounds (built-in Roblox sounds, so they can't be missing).
	  Each play gets a little pitch variation; the same sound can't restart faster than
	  MinGap and at most SoundRules.MaxVoices effects play at once, so a pile of
	  colliding boxes is one clatter, not fifty.
	* World sounds play from a pooled emitter at a position (3D roll-off).
	* Music is generated: a short original bouncy tune sequenced from one tone sample at
	  different pitches (no licensed track needed). It ducks while paused.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)

local Audio = {}

local effects: SoundGroup
local music: SoundGroup
local pools: { [string]: { Sound } } = {}
local poolIndex: { [string]: number } = {}
local lastPlayed: { [string]: number } = {}
local voices = 0
local emitters: { { Part: BasePart, Sound: Sound } } = {}
local emitterIndex = 0
local rng = Random.new()
local ducked = false

local MIN_GAP = 0.04

local function applyVolumes()
	local s = State.Settings()
	local master = s.Mute and 0 or (s.Master or 0.8)
	effects.Volume = master * (s.Effects or 0.8)
	music.Volume = master * (s.Music or 0.5) * (ducked and 0.35 or 1)
end

local function newSound(def: any, parent: Instance, group: SoundGroup): Sound
	local snd = Instance.new("Sound")
	snd.SoundId = def.Id
	snd.Volume = def.Volume or 0.5
	snd.SoundGroup = group
	snd.Parent = parent
	return snd
end

local function pooled(name: string): Sound?
	local def = Config.Sounds[name]
	if not def then
		return nil
	end
	local pool = pools[name]
	if not pool then
		pool = {}
		for _ = 1, 3 do
			table.insert(pool, newSound(def, SoundService, effects))
		end
		pools[name] = pool
		poolIndex[name] = 0
	end
	poolIndex[name] = poolIndex[name] % #pool + 1
	return pool[poolIndex[name]]
end

function Audio.Play(name: string, pitch: number?, volumeScale: number?)
	local t = os.clock()
	if lastPlayed[name] and t - lastPlayed[name] < MIN_GAP then
		return
	end
	if voices >= Config.SoundRules.MaxVoices then
		return
	end
	local def = Config.Sounds[name]
	local snd = pooled(name)
	if not snd or not def then
		return
	end
	lastPlayed[name] = t
	snd.PlaybackSpeed = (pitch or def.Pitch or 1) * (1 + rng:NextNumber(-0.05, 0.05))
	snd.Volume = (def.Volume or 0.5) * (volumeScale or 1)
	snd.TimePosition = 0
	snd:Play()
	voices += 1
	task.delay(1.2, function()
		voices = math.max(0, voices - 1)
	end)
end

function Audio.PlayAt(name: string, pos: Vector3?, pitch: number?, volumeScale: number?)
	if not pos then
		Audio.Play(name, pitch, volumeScale)
		return
	end
	local def = Config.Sounds[name]
	if not def then
		return
	end
	local t = os.clock()
	local key = name .. "@"
	if lastPlayed[key] and t - lastPlayed[key] < MIN_GAP then
		return
	end
	if voices >= Config.SoundRules.MaxVoices then
		return
	end
	lastPlayed[key] = t
	emitterIndex = emitterIndex % #emitters + 1
	local e = emitters[emitterIndex]
	e.Part.Position = pos
	e.Sound.SoundId = def.Id
	e.Sound.Volume = (def.Volume or 0.5) * (volumeScale or 1)
	e.Sound.PlaybackSpeed = (pitch or def.Pitch or 1) * (1 + rng:NextNumber(-0.06, 0.06))
	e.Sound.TimePosition = 0
	e.Sound:Play()
	voices += 1
	task.delay(1.2, function()
		voices = math.max(0, voices - 1)
	end)
end

----------------------------------------------------------------------------------------
-- Generated music: two bars of melody over a walking bass, 132 bpm, C major pentatonic.

local MELODY = { 0, 4, 7, 9, 7, 4, 2, -1, 4, 7, 9, 12, 9, 7, 4, -1, 2, 4, 7, 4, 2, 0, 2, -1, 0, 4, 7, 9, 12, 9, 7, -1 }
local BASS = { -12, -12, -5, -5, -7, -7, -5, -5 }
local musicNotes: { Sound } = {}
local bassNotes: { Sound } = {}
local musicOn = true

local function semis(n: number): number
	return 2 ^ (n / 12)
end

local function startMusic()
	for _ = 1, 4 do
		table.insert(musicNotes, newSound(Config.Sounds.Note, SoundService, music))
		table.insert(bassNotes, newSound(Config.Sounds.Bass, SoundService, music))
	end
	task.spawn(function()
		local step = 0
		local beat = 60 / 132 / 2 -- eighth notes
		local nextTime = os.clock()
		while true do
			nextTime += beat
			if musicOn then
				local m = MELODY[step % #MELODY + 1]
				if m >= 0 then
					local s = musicNotes[step % #musicNotes + 1]
					s.PlaybackSpeed = semis(m) * 1.0
					s.TimePosition = 0
					s:Play()
				end
				if step % 4 == 0 then
					local b = BASS[(step // 4) % #BASS + 1]
					local s = bassNotes[(step // 4) % #bassNotes + 1]
					s.PlaybackSpeed = semis(b + 12) * Config.Sounds.Bass.Pitch
					s.TimePosition = 0
					s:Play()
				end
			end
			step += 1
			local wait = nextTime - os.clock()
			if wait > 0 then
				task.wait(wait)
			else
				nextTime = os.clock()
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

function Audio.SetDucked(value: boolean)
	ducked = value
	applyVolumes()
end

function Audio.Init()
	effects = Instance.new("SoundGroup")
	effects.Name = "MO_Effects"
	effects.Parent = SoundService
	music = Instance.new("SoundGroup")
	music.Name = "MO_Music"
	music.Parent = SoundService
	local folder = Instance.new("Folder")
	folder.Name = "SoundEmitters"
	folder.Parent = Workspace
	for _ = 1, 10 do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.Parent = folder
		local s = Instance.new("Sound")
		s.SoundGroup = effects
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 80
		s.RollOffMaxDistance = 260
		s.Parent = p
		table.insert(emitters, { Part = p, Sound = s })
	end
	applyVolumes()
	State.SettingsChanged:Connect(applyVolumes)
	-- audio start errors (blocked / unavailable) are harmless: sounds just stay silent
	pcall(startMusic)
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController.luau
	Elevated, angled, restrained-perspective camera (Config.Camera; levels can set yaw /
	pitch). It frames every mover in the job plus held furniture with a margin, between a
	minimum and maximum distance, and moves / zooms smoothly with a dead band so it never
	"breathes". If the group is too spread out to fit, it follows the local mover.

	Walls between the camera and any mover fade (collision is unchanged).
	Before PLAY (title screen) it slowly circles the depot.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)

local CameraController = {}

local focus = Vector3.new(0, 0, 0)
local distance = 100
local targetDistance = 100
local shake = 0
local faded: { [BasePart]: boolean } = {}
local rad = math.rad

function CameraController.Shake(amount: number)
	if State.Settings().ReducedShake then
		return
	end
	shake = math.max(shake, amount)
end

local function moverPositions(): { Vector3 }
	local list = {}
	for _, p in Players:GetPlayers() do
		if ((p:GetAttribute("Slot") :: number?) or 0) > 0 and p.Character then
			local root = p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and root.Position.Y > -20 then
				table.insert(list, root.Position)
				local holding = p:GetAttribute("Holding")
				if holding then
					local level = Workspace:FindFirstChild("Level")
					local item = level and level:FindFirstChild("Items") and (level :: any).Items:FindFirstChild(holding)
					if item and item:IsA("Model") and item.PrimaryPart then
						table.insert(list, item.PrimaryPart.Position)
					end
				end
			end
		end
	end
	return list
end

local function fade(camPos: Vector3, targets: { Vector3 })
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local level = Workspace:FindFirstChild("Level")
	if not level then
		return
	end
	params.FilterDescendantsInstances = { level }
	local now: { [BasePart]: boolean } = {}
	for _, t in targets do
		local origin = camPos
		for _ = 1, 4 do
			local d = (t + Vector3.new(0, 1.5, 0)) - origin
			local hit = Workspace:Raycast(origin, d, params)
			if not hit then
				break
			end
			local part = hit.Instance
			if part:GetAttribute("Fadeable") then
				now[part] = true
				-- a wall is a group of parts (two painted faces, cap, trim): fade it whole
				local group = part.Parent
				if group and group:GetAttribute("FadeGroup") then
					for _, desc in group:GetDescendants() do
						if desc:IsA("BasePart") then
							now[desc] = true
						end
					end
				end
			end
			origin = hit.Position + d.Unit * 0.5
		end
	end
	for part in faded do
		if not now[part] then
			part.LocalTransparencyModifier = 0
			faded[part] = nil
		end
	end
	for part in now do
		part.LocalTransparencyModifier = Config.Camera.FadeTransparency
		faded[part] = true
	end
end

-- Fits ground points on screen: returns a focus (on the ground) and the camera distance
-- that shows all of them for this rotation, vertical FOV (degrees) and aspect ratio.
-- Exact for a perspective camera; two passes re-centre the focus on the projected box.
function CameraController.Fit(points: { Vector3 }, centre: Vector3, rot: CFrame, fov: number, aspect: number): (Vector3, number)
	local tanV = math.tan(rad(fov) / 2) * (1 - Config.Camera.ScreenPad)
	local tanH = math.tan(rad(fov) / 2) * aspect * (1 - Config.Camera.ScreenPad)
	local right, up, back = rot.XVector, rot.YVector, rot.ZVector
	local fwd = Vector3.new(-back.X, 0, -back.Z)
	fwd = fwd.Magnitude > 1e-3 and fwd.Unit or Vector3.new(0, 0, -1)
	local f = Vector3.new(centre.X, 0, centre.Z)
	local d = 0
	for _ = 1, 3 do
		d = 0
		for _, p in points do
			local rel = p - f
			local o = rel:Dot(back)
			d = math.max(d, o + math.abs(rel:Dot(right)) / tanH, o + math.abs(rel:Dot(up)) / tanV)
		end
		-- centre the projected box
		local sx0, sx1, sy0, sy1 = math.huge, -math.huge, math.huge, -math.huge
		for _, p in points do
			local rel = p - f
			local depth = math.max(d - rel:Dot(back), 1)
			local sx, sy = rel:Dot(right) / depth, rel:Dot(up) / depth
			sx0, sx1 = math.min(sx0, sx), math.max(sx1, sx)
			sy0, sy1 = math.min(sy0, sy), math.max(sy1, sy)
		end
		local cx, cy = (sx0 + sx1) / 2, (sy0 + sy1) / 2
		local upPerFwd = math.max(fwd:Dot(up), 0.2)
		f += right * (cx * d) + fwd * (cy * d / upPerFwd)
	end
	return f, d
end

function CameraController.Init()
	local cam = Workspace.CurrentCamera
	local t0 = os.clock()
	local fadeAcc = 0
	RunService:BindToRenderStep("MO_Camera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		cam = Workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = Config.Camera.FieldOfView
		local game_ = State.Game()
		local yaw = rad((game_:GetAttribute("CameraYaw") :: number?) or Config.Camera.Yaw)
		local pitch = rad((game_:GetAttribute("CameraPitch") :: number?) or Config.Camera.Pitch)

		local positions = moverPositions()
		local wantFocus = focus
		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(-pitch, 0, 0)
		if not State.Joined then
			-- title screen: slow orbit around the yard
			local tt = os.clock() - t0
			yaw += tt * 0.05
			rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(-pitch, 0, 0)
			wantFocus = Vector3.new(0, 0, 0)
			targetDistance = 150
		elseif #positions > 0 then
			-- frame the level's view area (house + truck, set by LevelBuilder) plus every
			-- mover, held item and the truck's rear, like the fixed overhead shot of the
			-- original: the house fills the screen and only grows when someone leaves it
			local framing: { Vector3 } = {}
			local level = Workspace:FindFirstChild("Level")
			local vMin = level and level:GetAttribute("ViewMin")
			local vMax = level and level:GetAttribute("ViewMax")
			if typeof(vMin) == "Vector3" and typeof(vMax) == "Vector3" then
				for _, x in { vMin.X, vMax.X } do
					for _, z in { vMin.Z, vMax.Z } do
						table.insert(framing, Vector3.new(x, 0, z))
					end
				end
			end
			local m = Config.Camera.Margin
			for _, p in positions do
				for _, o in { Vector3.new(-m, 0, -m), Vector3.new(m, 0, -m), Vector3.new(-m, 0, m), Vector3.new(m, 0, m) } do
					table.insert(framing, Vector3.new(p.X, 0, p.Z) + o)
				end
			end
			local truck = game_:GetAttribute("TruckPos")
			if typeof(truck) == "Vector3" then
				table.insert(framing, Vector3.new(truck.X, 0, truck.Z))
			end
			local minV, maxV = framing[1], framing[1]
			for _, p in framing do
				minV = minV:Min(p)
				maxV = maxV:Max(p)
			end
			local vp = cam.ViewportSize
			local aspect = (vp.Y > 0) and vp.X / vp.Y or 16 / 9
			local want
			wantFocus, want = CameraController.Fit(framing, (minV + maxV) / 2, rot, Config.Camera.FieldOfView, aspect)
			local root = State.Root()
			if want > Config.Camera.MaxDistance and root then
				wantFocus = root.Position
				want = Config.Camera.MaxDistance
			end
			want = math.clamp(want, Config.Camera.MinDistance, Config.Camera.MaxDistance)
			if math.abs(want - targetDistance) > Config.Camera.ZoomDeadband then
				targetDistance = want
			end
		end
		local alpha = 1 - math.exp(-Config.Camera.FollowSpeed * dt)
		focus = focus:Lerp(Vector3.new(wantFocus.X, math.max(wantFocus.Y, 0), wantFocus.Z), alpha)
		distance += (targetDistance - distance) * (1 - math.exp(-Config.Camera.ZoomSpeed * dt))

		local camPos = focus + rot * Vector3.new(0, 0, distance)
		local cf = CFrame.lookAt(camPos, focus)
		if shake > 0 then
			shake = math.max(0, shake - dt * 3)
			local s = shake * 0.6
			cf *= CFrame.new(math.noise(os.clock() * 25, 1) * s, math.noise(os.clock() * 25, 2) * s, 0)
		end
		cam.CFrame = cf
		cam.Focus = CFrame.new(focus)

		fadeAcc += dt
		if fadeAcc > 0.1 then
			fadeAcc = 0
			fade(camPos, positions)
		end
	end)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects.luau
	Plays the server's Fx events locally: sounds, dust puffs, impact bursts, glass shards,
	splinters, splashes, delivery pops, stun stars, confetti. All effects are short-lived
	local parts that never collide (they can't block a route) and are capped in number;
	the Low quality setting halves them.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local Audio = require(script.Parent.Audio)
local CameraController = require(script.Parent.CameraController)
local MoverAnimator = require(script.Parent.MoverAnimator)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local Effects = {}

Effects.Toast = State.Signal() -- (text)
Effects.Event = State.Signal() -- (kind, data) for HUD / tutorial
local folder: Folder
local live = 0
local MAX_LIVE = 160
local rng = Random.new()

local function count(n: number): number
	if State.Settings().Quality == "Low" then
		return math.max(1, n // 2)
	end
	return n
end

local function bit(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part?
	if live >= MAX_LIVE then
		return nil
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	live += 1
	p.Destroying:Connect(function()
		live -= 1
	end)
	return p
end

-- Expanding fading balls (dust, splash).
function Effects.Puff(pos: Vector3, color: Color3, n: number, spread: number, size: number?)
	for _ = 1, count(n) do
		local s = (size or 1.2) * rng:NextNumber(0.7, 1.3)
		local offset = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0, 0.6), rng:NextNumber(-1, 1)) * spread
		local p = bit(Vector3.new(s, s, s), CFrame.new(pos + offset * 0.3), color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		if p then
			p.Transparency = 0.15
			local t = rng:NextNumber(0.35, 0.6)
			TweenService:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = Vector3.new(s, s, s) * 2.2,
				Transparency = 1,
				CFrame = CFrame.new(pos + offset + Vector3.new(0, 1.2, 0)),
			}):Play()
			Debris:AddItem(p, t + 0.05)
		end
	end
end

-- Pieces flying out along an arc (glass, splinters, confetti), simulated by tweens.
function Effects.Burst(pos: Vector3, colors: { Color3 }, n: number, speed: number, size: Vector3, material: Enum.Material?, life: number?)
	for i = 1, count(n) do
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.4, 1.2), rng:NextNumber(-1, 1)).Unit
		local p = bit(size, CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), colors[(i - 1) % #colors + 1], material)
		if p then
			local l = life or 0.8
			local peak = pos + dir * speed * 0.5 + Vector3.new(0, speed * 0.25, 0)
			local land = pos + Vector3.new(dir.X, 0, dir.Z) * speed + Vector3.new(0, -2, 0)
			local up = TweenService:Create(p, TweenInfo.new(l * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(peak) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0) })
			up:Play()
			up.Completed:Connect(function()
				TweenService:Create(p, TweenInfo.new(l * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(land), Transparency = 1 }):Play()
			end)
			Debris:AddItem(p, l + 0.1)
		end
	end
end

-- Floating text over the world ("+1", "!").
function Effects.Pop(pos: Vector3, text: string, color: Color3)
	local anchor = bit(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), color)
	if not anchor then
		return
	end
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = UI.Title(gui, text, UDim2.fromScale(1, 1), UDim2.new(), color)
	TweenService:Create(anchor, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.2)
end

local function itemPos(name: string?): Vector3?
	local level = Workspace:FindFirstChild("Level")
	local items = level and level:FindFirstChild("Items")
	local m = items and name and items:FindFirstChild(name)
	if m and m:IsA("Model") and m.PrimaryPart then
		return m.PrimaryPart.Position
	end
	return nil
end

local handlers: { [string]: (data: any) -> () } = {}

handlers.Sound = function(d)
	Audio.PlayAt(d.Name, d.Pos)
end

handlers.Toast = function(d)
	Effects.Toast:Fire(d.Text)
	Audio.Play("Error", 1.3, 0.6)
end

handlers.Grab = function(d)
	Audio.PlayAt("Grab", d.Pos)
	if d.Pos then
		Effects.Puff(d.Pos, Color3.fromRGB(255, 255, 255), 2, 0.6, 0.5)
	end
end

handlers.Windup = function(d)
	Audio.PlayAt("Windup", d.Pos, d.Coop and 0.8 or 1)
end

handlers.Throw = function(d)
	Audio.PlayAt("Throw", d.Pos, d.Coop and 0.8 or 1.4)
	for _, id in d.Throwers or {} do
		local p = Players:GetPlayerByUserId(id)
		if p then
			MoverAnimator.ThrowRelease(p)
		end
	end
	if d.Coop then
		CameraController.Shake(0.4)
	end
end

handlers.Slap = function(d)
	Audio.PlayAt("Slap", d.Pos)
end

handlers.Impact = function(d)
	local speed = d.Speed or 10
	local vol = math.clamp(speed / 30, 0.3, 1)
	Audio.PlayAt(d.Sound or "ImpactWood", d.Pos, nil, vol)
	if speed > 18 then
		Effects.Puff(d.Pos - Vector3.new(0, 1, 0), Color3.fromRGB(240, 230, 210), 3, 1.2, 0.9)
		if speed > 30 then
			CameraController.Shake(0.25)
		end
	end
end

handlers.Break = function(d)
	local cf: CFrame = d.CFrame
	local size: Vector3 = d.Size
	if d.Kind == "Glass" then
		Audio.PlayAt("Glass", cf.Position)
		Audio.PlayAt("GlassTinkle", cf.Position)
		Effects.Burst(cf.Position, { Color3.fromRGB(190, 230, 250), Color3.fromRGB(240, 250, 255) }, 10, 8, Vector3.new(0.5, 0.5, 0.1), Enum.Material.Glass, 1.0)
	else
		Audio.PlayAt("WoodBreak", cf.Position)
		Effects.Burst(cf.Position, { Color3.fromRGB(150, 108, 70), Color3.fromRGB(120, 86, 56) }, 8, 7, Vector3.new(1.2, 0.3, 0.3), Enum.Material.WoodPlanks, 1.0)
	end
	Effects.Puff(cf.Position - Vector3.new(0, size.Y / 3, 0), Color3.fromRGB(240, 236, 226), 4, 2, 1.2)
	CameraController.Shake(0.35)
	Effects.Event:Fire("Break", d)
end

handlers.Crack = function(d)
	Audio.PlayAt("WoodBreak", d.CFrame.Position, 1.4, 0.5)
	Effects.Puff(d.CFrame.Position, Color3.fromRGB(200, 170, 130), 2, 1, 0.8)
end

handlers.Deliver = function(d)
	local pos = d.Pos or itemPos(d.Item)
	if d.Delivered then
		Audio.PlayAt("Deliver", pos)
		if pos then
			Effects.Pop(pos + Vector3.new(0, 3, 0), "+1", UI.Colors.Green)
			Effects.Burst(pos + Vector3.new(0, 2, 0), { UI.Colors.Yellow, UI.Colors.White }, 6, 4, Vector3.new(0.4, 0.4, 0.4), Enum.Material.Neon, 0.7)
		end
	else
		Audio.PlayAt("Undeliver", pos)
		if pos then
			Effects.Pop(pos + Vector3.new(0, 3, 0), "-1", UI.Colors.Red)
		end
	end
	Effects.Event:Fire("Deliver", d)
end

handlers.Splash = function(d)
	Audio.PlayAt("Splash", d.Pos)
	Effects.Puff(Vector3.new(d.Pos.X, -0.6, d.Pos.Z), Color3.fromRGB(150, 210, 250), 7, 2.5, 1.4)
	Effects.Burst(Vector3.new(d.Pos.X, -0.4, d.Pos.Z), { Color3.fromRGB(120, 200, 245), Color3.fromRGB(230, 245, 255) }, 8, 6, Vector3.new(0.5, 0.5, 0.5), Enum.Material.Glass, 0.7)
end

handlers.Poof = function(d)
	if d.Pos then
		Effects.Puff(d.Pos, Color3.fromRGB(255, 255, 255), 6, 2.5, 1.4)
	end
end

handlers.Vanish = function(d)
	if d.Pos then
		Effects.Burst(d.Pos, { UI.Colors.Yellow, UI.Colors.White }, 10, 5, Vector3.new(0.4, 0.4, 0.4), Enum.Material.Neon, 0.6)
	end
end

handlers.Stun = function(d)
	local p = Players:GetPlayerByUserId(d.UserId)
	local root = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	Audio.PlayAt("Stun", root and root.Position)
	if p == Players.LocalPlayer then
		CameraController.Shake(0.3)
	end
end

handlers.Honk = function(d)
	Audio.PlayAt("Honk", d.Pos)
	Effects.Pop(d.Pos + Vector3.new(0, 4, 0), "! CAR !", UI.Colors.Orange)
end

handlers.Ghost = function(d)
	Audio.PlayAt("Ghost", d.Pos)
	Effects.Pop(d.Pos + Vector3.new(0, 3, 0), "!", UI.Colors.White)
end

handlers.GhostStun = function(d)
	Audio.PlayAt("SlapHit", d.Pos, 0.7)
	Effects.Pop(d.Pos + Vector3.new(0, 3, 0), "zzz", UI.Colors.Blue)
end

handlers.Spook = function(d)
	Audio.PlayAt("Ghost", d.Pos, 0.7)
	Effects.Pop(d.Pos + Vector3.new(0, 4, 0), "BOO!", UI.Colors.White)
end

handlers.Countdown = function(d)
	Audio.Play(d.N == 0 and "Go" or "Countdown")
	Effects.Event:Fire("Countdown", d)
end

handlers.Celebrate = function()
	Audio.Play("Complete")
	for _, p in Players:GetPlayers() do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Effects.Burst(root.Position + Vector3.new(0, 4, 0), { UI.Colors.Red, UI.Colors.Yellow, UI.Colors.Blue, UI.Colors.Green }, 14, 9, Vector3.new(0.5, 0.1, 0.5), Enum.Material.Neon, 1.2)
		end
	end
	Effects.Event:Fire("Celebrate", {})
end

handlers.Results = function(d)
	Effects.Event:Fire("Results", d)
end

handlers.Profile = function(d)
	if type(d) == "table" and d.Settings then
		local settings = State.Profile.Settings
		State.Profile = d
		State.Profile.Settings = settings -- keep any local unsaved tweaks
		State.ProfileChanged:Fire()
	end
end

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "Effects"
	folder.Parent = Workspace
	Net.Fx.OnClientEvent:Connect(function(kind, data)
		local h = handlers[kind]
		if h then
			local ok, err = pcall(h, data or {})
			if not ok then
				warn("Effects." .. tostring(kind) .. ": " .. tostring(err))
			end
		end
	end)
	MoverAnimator.Landed:Connect(function(player, pos)
		if pos then
			Effects.Puff(pos, Color3.fromRGB(245, 240, 228), 3, 1.2, 0.8)
			if player == Players.LocalPlayer then
				Audio.Play("Land")
			end
		elseif player == Players.LocalPlayer then
			Audio.Play("Jump")
		end
	end)
	UI.SetSoundHook(function(name)
		Audio.Play(name)
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--[[
	Hud.luau
	In-play interface, kept to the screen edges so the playfield stays clear:
	  top left     cardboard-box icon + delivered / required pill, job name, pause button
	  top right    stopwatch medal with the current award target (gold, then silver,
	               then bronze as time passes) + the elapsed time pill with a bar that
	               runs down toward that target (freezes while paused); mover chips below
	  bottom       contextual hint ("[E] Grab Sofa", "[Q] Throw", ...)
	  centre       countdown, toasts (feedback such as "Spot taken")
	  lobby bar    JOB BOARD / LOOK / SETTINGS buttons in the depot yard
	  touch        GRAB / THROW / SLAP buttons on phones and tablets
	  tutorial     a small step card in the yard and the first job
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Jobs = require(ReplicatedStorage.Shared.Jobs)
local Net = require(ReplicatedStorage.Shared.Net)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)
local Input = require(script.Parent.Input)
local Effects = require(script.Parent.Effects)
local Targeting = require(script.Parent.Targeting)
local Menus = require(script.Parent.Menus)

local Hud = {}

local C = UI.Colors
local root: ScreenGui
local timerLabel: TextLabel
local timerPill: Frame
local medal: Frame
local medalInner: Frame
local medalLabel: TextLabel
local barFill: Frame
local jobLabel: TextLabel
local countLabel: TextLabel
local countFrame: Frame
local requiredLabel: TextLabel
local hintLabel: TextLabel
local hintFrame: Frame
local chips: Frame
local toastLabel: TextLabel
local countdownLabel: TextLabel
local lobbyBar: Frame
local touchFrame: Frame
local tutorialCard: Frame
local tutorialText: TextLabel
local topLeft: Frame
local pauseButton: TextButton
local saveNote: TextLabel

local function U(xs: number, xo: number, ys: number, yo: number): UDim2
	return UDim2.new(xs, xo, ys, yo)
end

----------------------------------------------------------------------------------------
-- Toasts

local toastToken = 0
function Hud.Toast(text: string)
	toastToken += 1
	local my = toastToken
	toastLabel.Text = text
	toastLabel.Visible = true
	toastLabel.TextTransparency = 0
	task.delay(2.2, function()
		if my == toastToken then
			toastLabel.Visible = false
		end
	end)
end

----------------------------------------------------------------------------------------
-- Tutorial: short step lists that advance on real actions.

local steps: { { Text: string, Done: string } } = {}
local stepIndex = 0
local tutorialActive = false

local LOBBY_STEPS = {
	{ Text = "Walk with %MOVE%.", Done = "Move" },
	{ Text = "Walk up to a box and press %GRAB% to grab it.", Done = "Grab" },
	{ Text = "Press %THROW% to throw it. Light things fly far!", Done = "Throw" },
	{ Text = "Grab it again and drop it with %GRAB%.", Done = "Release" },
	{ Text = "Put a box in the truck: it counts when it rests fully inside.", Done = "Deliver" },
	{ Text = "Ready! %BOARD% to pick a job.", Done = "Never" },
}
local JOB_STEPS = {
	{ Text = "Everything with a highlight can be moved. Grab with %GRAB%.", Done = "Grab" },
	{ Text = "Big things (sofa, bed) are heavy and long: grab an end and walk around to turn them through doors.", Done = "HeavyMoved" },
	{ Text = "Glass with a white cross breaks: throw or slam furniture through it for a shortcut (%SLAP% to slap it).", Done = "Break" },
	{ Text = "Pack the truck: big things first, at the back. Boxes stack on top.", Done = "Deliver" },
}

local function stepText(t: string): string
	local move = Input.Device == "Gamepad" and "the left stick" or Input.Device == "Touch" and "the thumbstick" or "WASD / arrows"
	local board = Input.Device == "Touch" and "Tap JOB BOARD" or "Press P"
	t = t:gsub("%%MOVE%%", move)
	t = t:gsub("%%GRAB%%", "[" .. Input.Label("Grab") .. "]")
	t = t:gsub("%%THROW%%", "[" .. Input.Label("Throw") .. "]")
	t = t:gsub("%%SLAP%%", "[" .. Input.Label("Slap") .. "]")
	t = t:gsub("%%BOARD%%", board)
	return t
end

local function showStep()
	local s = steps[stepIndex]
	if not s or not State.Settings().ShowTutorialHints then
		tutorialCard.Visible = false
		return
	end
	tutorialCard.Visible = true
	tutorialText.Text = string.format("<b>%d/%d</b>  %s", stepIndex, #steps, stepText(s.Text))
	UI.PopIn(tutorialCard)
end

local function startTutorial(list: { any })
	steps = list
	stepIndex = 1
	tutorialActive = true
	showStep()
end

local function stopTutorial()
	tutorialActive = false
	tutorialCard.Visible = false
end

local function advance(event: string)
	if not tutorialActive then
		return
	end
	local s = steps[stepIndex]
	if s and s.Done == event then
		stepIndex += 1
		if stepIndex > #steps then
			stopTutorial()
			Net.Action:FireServer("TutorialDone")
		else
			showStep()
		end
	end
end

----------------------------------------------------------------------------------------

-- Bold white numbers with a dark outline (the HUD's main type).
local function hudText(parent: Instance, text: string, size: UDim2, pos: UDim2, maxText: number, align: Enum.TextXAlignment?, outline: Color3?): TextLabel
	local t = UI.Outlined(parent, text, size, pos, { MaxText = maxText, TextXAlignment = align or Enum.TextXAlignment.Center, OutlineColor = outline or C.Ink, Outline = 3.5 })
	return t
end

-- A little cardboard box drawn with frames (taped lid, shipping label).
local function boxIcon(parent: Instance, size: number, pos: UDim2): Frame
	local box = Instance.new("Frame")
	box.Name = "BoxIcon"
	box.Size = UDim2.fromOffset(size, size)
	box.Position = pos
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.Rotation = -6
	box.BackgroundColor3 = Color3.fromRGB(214, 150, 86)
	box.ZIndex = 3
	box.Parent = parent
	UI.Corner(box, 10)
	UI.Stroke(box, 4, C.White)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.fromRGB(255, 240, 220), Color3.fromRGB(205, 175, 150))
	g.Rotation = 90
	g.Parent = box
	local lid = Instance.new("Frame")
	lid.Size = UDim2.new(1, 0, 0.3, 0)
	lid.BackgroundColor3 = Color3.fromRGB(236, 178, 112)
	lid.BorderSizePixel = 0
	lid.ZIndex = 3
	lid.Parent = box
	UI.Corner(lid, 10)
	local tape = Instance.new("Frame")
	tape.Size = UDim2.new(0.22, 0, 0.42, 0)
	tape.Position = UDim2.fromScale(0.39, 0)
	tape.BackgroundColor3 = Color3.fromRGB(250, 226, 180)
	tape.BorderSizePixel = 0
	tape.ZIndex = 4
	tape.Parent = box
	local label = Instance.new("Frame")
	label.Size = UDim2.fromScale(0.34, 0.2)
	label.Position = UDim2.fromScale(0.14, 0.62)
	label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	label.ZIndex = 4
	label.Parent = box
	UI.Corner(label, 3)
	local stripe = Instance.new("Frame")
	stripe.Size = UDim2.fromScale(0.6, 0.5)
	stripe.Position = UDim2.fromScale(0.2, 0.25)
	stripe.BackgroundColor3 = Color3.fromRGB(70, 170, 230)
	stripe.BorderSizePixel = 0
	stripe.ZIndex = 4
	stripe.Parent = label
	return box
end

local function buildTop()
	-- top right: stopwatch medal + elapsed time pill
	timerPill = Instance.new("Frame")
	timerPill.Name = "Stopwatch"
	timerPill.BackgroundTransparency = 1
	timerPill.Size = UDim2.fromOffset(290, 100)
	timerPill.Position = U(1, -12, 0, 10)
	timerPill.AnchorPoint = Vector2.new(1, 0)
	timerPill.Parent = root
	UI.Scaled(timerPill)
	local pill = Instance.new("Frame")
	pill.Name = "Elapsed"
	pill.Size = UDim2.fromOffset(212, 62)
	pill.Position = UDim2.fromOffset(74, 10)
	pill.BackgroundColor3 = C.Sky
	pill.ZIndex = 1
	pill.Parent = timerPill
	UI.Corner(pill, 16)
	UI.Stroke(pill, 4, C.White)
	UI.Shade(pill, 0.18)
	timerLabel = hudText(pill, "0:00", U(1, -56, 1, -8), U(0, 44, 0, 4), 46, Enum.TextXAlignment.Center, C.SkyDark)
	timerLabel.ZIndex = 2
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Size = UDim2.fromOffset(180, 14)
	bar.Position = UDim2.fromOffset(100, 78)
	bar.BackgroundColor3 = Color3.fromRGB(120, 66, 40)
	bar.Parent = timerPill
	UI.Corner(bar, 7)
	UI.Stroke(bar, 3, C.White)
	barFill = Instance.new("Frame")
	barFill.Name = "Fill"
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BackgroundColor3 = C.Gold
	barFill.BorderSizePixel = 0
	barFill.Parent = bar
	UI.Corner(barFill, 7)
	for i = 1, 3 do
		local tick = Instance.new("Frame")
		tick.Size = UDim2.new(0, 3, 1, 0)
		tick.Position = UDim2.fromScale(i / 4, 0)
		tick.BackgroundColor3 = Color3.fromRGB(90, 48, 30)
		tick.BackgroundTransparency = 0.3
		tick.BorderSizePixel = 0
		tick.ZIndex = 2
		tick.Parent = bar
	end
	-- the stopwatch: a knob, a gold rim and an inner face with the target time
	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(22, 16)
	knob.Position = UDim2.fromOffset(44, 2)
	knob.AnchorPoint = Vector2.new(0.5, 0)
	knob.BackgroundColor3 = C.Gold
	knob.ZIndex = 2
	knob.Parent = timerPill
	UI.Corner(knob, 5)
	UI.Stroke(knob, 3, C.White)
	medal = Instance.new("Frame")
	medal.Name = "Medal"
	medal.Size = UDim2.fromOffset(84, 84)
	medal.Position = UDim2.fromOffset(44, 54)
	medal.AnchorPoint = Vector2.new(0.5, 0.5)
	medal.BackgroundColor3 = C.Gold
	medal.ZIndex = 3
	medal.Parent = timerPill
	UI.Corner(medal, 999)
	UI.Stroke(medal, 4, C.White)
	UI.Shade(medal, 0.12)
	medalInner = Instance.new("Frame")
	medalInner.Size = UDim2.fromScale(0.76, 0.76)
	medalInner.Position = UDim2.fromScale(0.5, 0.5)
	medalInner.AnchorPoint = Vector2.new(0.5, 0.5)
	medalInner.BackgroundColor3 = Color3.fromRGB(226, 144, 24)
	medalInner.ZIndex = 4
	medalInner.Parent = medal
	UI.Corner(medalInner, 999)
	local star = UI.Text(medalInner, "★", UDim2.fromScale(1.05, 1.05), UDim2.fromScale(-0.025, -0.06), { MaxText = 80, TextColor3 = Color3.fromRGB(255, 255, 255), TextTransparency = 0.72, ZIndex = 5 })
	star.Name = "Star"
	medalLabel = hudText(medalInner, "", U(1, 4, 0.6, 0), U(0, -2, 0.2, 0), 26, Enum.TextXAlignment.Center, Color3.fromRGB(110, 60, 10))
	medalLabel.ZIndex = 6

	-- top left: box counter pill, job name, pause button
	topLeft = Instance.new("Frame")
	topLeft.BackgroundTransparency = 1
	topLeft.Size = UDim2.fromOffset(330, 112)
	topLeft.Position = U(0, 10, 0, 62) -- below Roblox's top bar buttons
	topLeft.Parent = root
	UI.Scaled(topLeft)
	countFrame = Instance.new("Frame")
	countFrame.Name = "Counter"
	countFrame.Size = UDim2.fromOffset(176, 60)
	countFrame.Position = UDim2.fromOffset(52, 10)
	countFrame.BackgroundColor3 = Color3.fromRGB(255, 140, 96)
	countFrame.Parent = topLeft
	UI.Corner(countFrame, 16)
	UI.Stroke(countFrame, 4, C.White)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 200, 190))
	g.Rotation = 0
	g.Parent = countFrame
	countLabel = hudText(countFrame, "", U(0.5, -14, 1, -6), U(0, 40, 0, 3), 46, Enum.TextXAlignment.Right, Color3.fromRGB(120, 50, 30))
	requiredLabel = hudText(countFrame, "", U(0.5, -14, 0.62, 0), U(0.5, 26, 0.34, 0), 28, Enum.TextXAlignment.Left, Color3.fromRGB(120, 50, 30))
	boxIcon(topLeft, 72, UDim2.fromOffset(42, 40))
	jobLabel = hudText(topLeft, "", UDim2.fromOffset(250, 26), UDim2.fromOffset(10, 78), 20, Enum.TextXAlignment.Left)
	pauseButton = UI.Button(topLeft, "II", UDim2.fromOffset(54, 54), UDim2.fromOffset(268, 40), function()
		if State.Phase() == "Playing" then
			Net.Action:FireServer("Pause")
		elseif State.Phase() == "Lobby" then
			Menus.Open("Settings")
		end
	end, C.White)

	chips = Instance.new("Frame")
	chips.BackgroundTransparency = 1
	chips.Size = UDim2.fromOffset(200, 200)
	chips.Position = U(1, -10, 0, 118)
	chips.AnchorPoint = Vector2.new(1, 0)
	chips.Parent = root
	UI.Scaled(chips)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.SortOrder = Enum.SortOrder.Name
	layout.Parent = chips
end

local MEDALS = {
	{ Name = "Gold", Rim = Color3.fromRGB(255, 200, 50), Face = Color3.fromRGB(226, 144, 24), Ink = Color3.fromRGB(110, 60, 10) },
	{ Name = "Silver", Rim = Color3.fromRGB(214, 224, 236), Face = Color3.fromRGB(150, 166, 188), Ink = Color3.fromRGB(60, 70, 90) },
	{ Name = "Bronze", Rim = Color3.fromRGB(232, 156, 96), Face = Color3.fromRGB(176, 98, 52), Ink = Color3.fromRGB(80, 40, 20) },
}

local function clockText(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- Medal shows the next award still reachable; the bar runs down toward it.
local function updateStopwatch(t: number, job: any)
	if not job or not job.Awards then
		medal.Visible = false
		local bar = barFill.Parent :: Frame
		bar.Visible = false
		return
	end
	medal.Visible = true
	local bar = barFill.Parent :: Frame
	bar.Visible = true
	local scale = (State.Game():GetAttribute("AssistTimeScale") :: number?) or 1
	local prev = 0
	for _, m in MEDALS do
		local target = (job.Awards[m.Name] or 0) * scale
		if t <= target then
			medal.BackgroundColor3 = m.Rim
			medalInner.BackgroundColor3 = m.Face
			barFill.BackgroundColor3 = m.Rim
			local stroke = medalLabel:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = m.Ink
			end
			medalLabel.Text = clockText(target)
			barFill.Size = UDim2.fromScale(math.clamp(1 - (t - prev) / math.max(target - prev, 1), 0, 1), 1)
			return
		end
		prev = target
	end
	medal.BackgroundColor3 = C.Grey
	medalInner.BackgroundColor3 = Color3.fromRGB(150, 146, 156)
	medalLabel.Text = "--"
	barFill.Size = UDim2.fromScale(0, 1)
end

local function refreshChips()
	for _, c in chips:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for _, p in Players:GetPlayers() do
		local slot = (p:GetAttribute("Slot") :: number?) or 0
		if slot > 0 then
			local info = Config.Slots[slot]
			local f = Instance.new("Frame")
			f.Name = "Chip" .. slot
			f.Size = UDim2.fromOffset(190, 36)
			f.BackgroundColor3 = info.Color
			f.Parent = chips
			UI.Corner(f, 18)
			UI.Stroke(f, 3, C.White)
			UI.Shade(f, 0.15)
			local leader = State.Game():GetAttribute("Leader") == p.UserId
			UI.Outlined(f, string.format("%s %s  %s%s", info.Name, info.Symbol, p.DisplayName, leader and "  ★" or ""), U(1, -16, 1, -6), U(0, 8, 0, 3), { TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20, Outline = 2, OutlineColor = info.Color:Lerp(C.Ink, 0.6) })
		end
	end
end

local function buildBottom()
	hintFrame = Instance.new("Frame")
	hintFrame.Size = UDim2.fromOffset(460, 48)
	hintFrame.Position = U(0.5, 0, 1, -16)
	hintFrame.AnchorPoint = Vector2.new(0.5, 1)
	hintFrame.BackgroundColor3 = C.PanelDark
	hintFrame.BackgroundTransparency = 0.15
	hintFrame.Parent = root
	UI.Corner(hintFrame, 24)
	UI.Scaled(hintFrame)
	hintLabel = UI.Text(hintFrame, "", U(1, -24, 1, -10), U(0, 12, 0, 5), { TextColor3 = C.White, MaxText = 24 })

	toastLabel = UI.Title(root, "", U(0.7, 0, 0, 40), U(0.5, 0, 0, 84), C.White)
	toastLabel.AnchorPoint = Vector2.new(0.5, 0)
	toastLabel.Visible = false

	countdownLabel = UI.Title(root, "", U(0.4, 0, 0.25, 0), U(0.5, 0, 0.42, 0), C.Yellow)
	countdownLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	countdownLabel.Visible = false
	local lim = countdownLabel:FindFirstChildOfClass("UITextSizeConstraint")
	if lim then
		lim.MaxTextSize = 140
	end

	saveNote = UI.Text(root, "", U(0.5, 0, 0, 22), U(0.5, 0, 1, -70), { TextColor3 = C.White, MaxText = 16, TextStrokeTransparency = 0.3 })
	saveNote.AnchorPoint = Vector2.new(0.5, 1)
end

local function buildLobbyBar()
	lobbyBar = Instance.new("Frame")
	lobbyBar.BackgroundTransparency = 1
	lobbyBar.Size = UDim2.fromOffset(470, 64)
	lobbyBar.Position = U(0.5, 0, 0, 10)
	lobbyBar.AnchorPoint = Vector2.new(0.5, 0)
	lobbyBar.Parent = root
	UI.Scaled(lobbyBar)
	UI.Button(lobbyBar, "JOB BOARD", UDim2.fromOffset(170, 56), UDim2.fromOffset(85, 32), function()
		Menus.OpenBoard()
	end, C.Yellow)
	UI.Button(lobbyBar, "LOOK", UDim2.fromOffset(130, 56), UDim2.fromOffset(245, 32), function()
		Menus.OpenLook()
	end, C.White)
	UI.Button(lobbyBar, "SETTINGS", UDim2.fromOffset(150, 56), UDim2.fromOffset(395, 32), function()
		Menus.Open("Settings")
	end, C.White)
end

local function buildTouch()
	touchFrame = Instance.new("Frame")
	touchFrame.BackgroundTransparency = 1
	touchFrame.Size = UDim2.fromOffset(250, 170)
	touchFrame.Position = U(1, -96, 1, -8) -- left of Roblox's jump button
	touchFrame.AnchorPoint = Vector2.new(1, 1)
	touchFrame.Parent = root
	local function tb(text: string, action: string, size: number, x: number, y: number, color: Color3)
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(size, size)
		b.Position = UDim2.fromOffset(x, y)
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.1
		b.Font = UI.Font
		b.Text = text
		b.TextScaled = true
		b.TextColor3 = C.Ink
		b.AutoButtonColor = true
		b.Parent = touchFrame
		UI.Corner(b, 999)
		UI.Stroke(b, 3)
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0.15, 0)
		pad.PaddingRight = UDim.new(0.15, 0)
		pad.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				Input.Press(action)
			end
		end)
		b.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				Input.ReleasePress(action)
			end
		end)
		return b
	end
	local grab = tb("GRAB", "Grab", 96, 196, 112, C.Yellow)
	grab.Name = "GrabButton"
	tb("THROW", "Throw", 74, 96, 128, C.Orange)
	tb("SLAP", "Slap", 62, 130, 42, C.White)
end

----------------------------------------------------------------------------------------

local function currentHint(): string
	local phase = State.Phase()
	if State.MySlot() == 0 then
		return State.Joined and "All four mover slots are taken - you're watching." or ""
	end
	if phase ~= "Playing" and phase ~= "Lobby" then
		return ""
	end
	local holding = State.Player:GetAttribute("Holding")
	if holding then
		local class = State.Player:GetAttribute("HoldingClass")
		local level = Workspace:FindFirstChild("Level")
		local item = level and level:FindFirstChild("Items") and (level :: any).Items:FindFirstChild(holding)
		local name = item and item:GetAttribute("DisplayName") or "it"
		local holders = item and item:GetAttribute("Holders") or 1
		if class == "Heavy" and holders < 2 then
			local movers = (State.Game():GetAttribute("MoverCount") :: number?) or 1
			if movers > 1 then
				return string.format("[%s] Drop  ·  Heavy %s: a partner can grab the other end", Input.Label("Grab"), name)
			end
			return string.format("[%s] Drop  ·  Heavy %s: drag it, turn it to fit doors", Input.Label("Grab"), name)
		end
		if holders >= 2 then
			local primed = item and item:GetAttribute("Primed") or 0
			if primed > 0 then
				return string.format("THROW TOGETHER!  [%s]  (%d/%d ready)", Input.Label("Throw"), primed, holders)
			end
			return string.format("[%s] Drop  ·  [%s] Throw together", Input.Label("Grab"), Input.Label("Throw"))
		end
		return string.format("[%s] Drop  ·  [%s] Throw %s", Input.Label("Grab"), Input.Label("Throw"), name)
	end
	local target = Targeting.Current()
	if target then
		local name = target:GetAttribute("DisplayName") or target.Name
		local delivered = target:GetAttribute("Delivered") and "  (in truck)" or ""
		return string.format("[%s] Grab %s%s", Input.Label("Grab"), name, delivered)
	end
	if phase == "Lobby" then
		if State.IsLeader() then
			return "Practice in the yard, then open the JOB BOARD"
		end
		return "Practice in the yard - the host picks the job"
	end
	return ""
end

local function update()
	local game_ = State.Game()
	local phase = State.Phase()
	local joined = State.Joined
	local menu = Menus.Current()
	local inJob = phase == "Playing" or phase == "Countdown"
	local visibleHud = joined and (menu == nil or menu == "Pause")

	-- timer
	timerPill.Visible = visibleHud and (inJob or phase == "Results")
	local running = game_:GetAttribute("TimerRunning")
	local t = running and (Workspace:GetServerTimeNow() - ((game_:GetAttribute("TimerOrigin") :: number?) or 0)) or ((game_:GetAttribute("TimerValue") :: number?) or 0)
	t = math.max(0, t)
	timerLabel.Text = clockText(t)

	-- job info
	topLeft.Visible = joined and menu == nil
	local jobId = game_:GetAttribute("JobId")
	local job = Jobs.ById[jobId or ""]
	updateStopwatch(t, job)
	jobLabel.Text = job and job.Name or "The Depot (practice)"
	local d = (game_:GetAttribute("Delivered") :: number?) or 0
	local r = (game_:GetAttribute("Required") :: number?) or 0
	if job then
		countLabel.Size = U(0.5, -14, 1, -6)
		countLabel.Text = tostring(d)
		requiredLabel.Text = "/" .. tostring(r)
	else
		countLabel.Size = U(1, -48, 0.7, 0)
		countLabel.Text = "Practice!"
		requiredLabel.Text = ""
	end
	if job and r > 0 and d >= r then
		countFrame.BackgroundColor3 = Color3.fromRGB(110, 210, 110)
	else
		countFrame.BackgroundColor3 = Color3.fromRGB(255, 140, 96)
	end
	pauseButton.Text = phase == "Playing" and "II" or "⚙"

	chips.Visible = joined and menu == nil

	-- hint
	local hint = visibleHud and menu == nil and currentHint() or ""
	if Input.Device == "Touch" then
		-- keep the bottom right free for the touch buttons
		hintFrame.AnchorPoint = Vector2.new(0.5, 0)
		hintFrame.Position = U(0.5, 0, 0, phase == "Lobby" and 58 or 62)
	else
		hintFrame.AnchorPoint = Vector2.new(0.5, 1)
		hintFrame.Position = U(0.5, 0, 1, -16)
	end
	hintLabel.Text = hint
	hintFrame.Visible = hint ~= ""
	lobbyBar.Visible = joined and menu == nil and phase == "Lobby" and State.MySlot() > 0
	touchFrame.Visible = joined and menu == nil and Input.Device == "Touch" and State.MySlot() > 0 and (phase == "Lobby" or phase == "Playing")

	-- countdown
	if phase == "Countdown" then
		local left = ((game_:GetAttribute("CountdownEnd") :: number?) or 0) - Workspace:GetServerTimeNow()
		countdownLabel.Visible = true
		countdownLabel.Text = left > 0 and tostring(math.ceil(left)) or "GO!"
	elseif countdownLabel.Text ~= "GO!" then
		countdownLabel.Visible = false
	end

	if menu ~= nil then
		tutorialCard.Visible = false
	elseif tutorialActive and State.Settings().ShowTutorialHints then
		tutorialCard.Visible = true
	end

	local status = State.SaveStatus
	saveNote.Text = (joined and phase == "Lobby" and menu == nil and status ~= "ok") and "Progress isn't being saved this session (data storage unavailable)." or ""
end

function Hud.Init()
	root = UI.Root("Hud", 10)
	buildTop()
	buildBottom()
	buildLobbyBar()
	buildTouch()

	tutorialCard = UI.Panel(root, UDim2.fromOffset(300, 92), U(0, 10, 0, 182), Vector2.new(0, 0))
	UI.Scaled(tutorialCard)
	tutorialText = UI.Text(tutorialCard, "", U(1, -20, 1, -14), U(0, 10, 0, 7), { TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18 })
	tutorialCard.Visible = false

	Effects.Toast:Connect(Hud.Toast)
	Effects.Event:Connect(function(kind, data)
		if kind == "Countdown" and data.N == 0 then
			countdownLabel.Text = "GO!"
			countdownLabel.Visible = true
			task.delay(0.8, function()
				if countdownLabel.Text == "GO!" then
					countdownLabel.Visible = false
					countdownLabel.Text = ""
				end
			end)
		elseif kind == "Deliver" and data.Delivered then
			advance("Deliver")
			local sc = countFrame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
			sc.Parent = countFrame
			sc.Scale = 1.3
			TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		elseif kind == "Break" then
			advance("Break")
		end
	end)
	Input.ActionFired:Connect(function(action)
		if action == "GrabMiss" then
			Hud.Toast("Nothing in reach - walk up to something first")
		elseif action == "GamepadLost" then
			Hud.Toast("Controller disconnected - reconnect it to keep playing")
		else
			advance(action)
		end
	end)

	-- tutorial triggers: the yard on first visits, the first job
	local heavyTimer = 0
	local moved = 0
	local lastPos: Vector3? = nil
	local function phaseTutorial()
		local phase = State.Phase()
		local jobId = State.Game():GetAttribute("JobId")
		if phase == "Lobby" and State.Joined and not State.Profile.TutorialSeen and not tutorialActive then
			startTutorial(LOBBY_STEPS)
		elseif phase == "Playing" and jobId == Jobs.List[1].Id then
			startTutorial(JOB_STEPS)
		elseif phase ~= "Lobby" and phase ~= "Playing" then
			stopTutorial()
		end
	end
	State.Game():GetAttributeChangedSignal("Phase"):Connect(phaseTutorial)
	Menus.Changed:Connect(function(name)
		if name == nil then
			phaseTutorial()
		end
	end)

	local game_ = State.Game()
	for _, attr in { "Leader", "MoverCount" } do
		game_:GetAttributeChangedSignal(attr):Connect(refreshChips)
	end
	Players.PlayerAdded:Connect(function(p)
		p:GetAttributeChangedSignal("Slot"):Connect(refreshChips)
		refreshChips()
	end)
	for _, p in Players:GetPlayers() do
		p:GetAttributeChangedSignal("Slot"):Connect(refreshChips)
	end
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshChips)
	end)
	refreshChips()

	RunService.RenderStepped:Connect(function(dt)
		update()
		-- tutorial progress that isn't a button press
		local rootPart = State.Root()
		if tutorialActive and rootPart then
			if lastPos then
				moved += (rootPart.Position - lastPos).Magnitude
				if moved > 12 then
					advance("Move")
				end
			end
			lastPos = rootPart.Position
			if State.Player:GetAttribute("HoldingClass") == "Heavy" and rootPart.AssemblyLinearVelocity.Magnitude > 2 then
				heavyTimer += dt
				if heavyTimer > 2.5 then
					advance("HeavyMoved")
				end
			end
		end
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--[[
	Input.luau
	Turns keyboard, gamepad and touch input into mover actions (Grab / Throw / Slap /
	Pause) and drives menu navigation. Movement and jumping are Roblox's own controls;
	our fixed overhead camera makes them camera-relative (up = up the screen).

	* Each player plays on their own device (Roblox co-op is online, one mover per
	  player), so "multiple local players" maps to multiple Roblox players in a server.
	* Grab is a toggle by default (press to grab, press to drop); the Grab Toggle setting
	  off makes it hold-to-carry.
	* The three actions can be remapped (Settings); a fixed alternate set always works.
	* When the window loses focus or a controller disconnects, held input is cleared, the
	  held item is let go and a solo job pauses.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local Input = {}

Input.Device = "Keyboard" -- Keyboard | Gamepad | Touch
Input.DeviceChanged = State.Signal()
Input.ActionFired = State.Signal() -- (action) for the tutorial / HUD
Input.PauseRequested = State.Signal()
Input.BackRequested = State.Signal()

local targetProvider: (() -> Model?)? = nil
local controls: any = nil
local grabHeld = false
local capturing: ((Enum.KeyCode) -> ())? = nil

function Input.SetTargetProvider(fn: () -> Model?)
	targetProvider = fn
end

local function keyFor(action: string): string
	local custom = State.Profile.Bindings and State.Profile.Bindings[action]
	return custom or Config.Bindings.Keyboard[action]
end

-- Human-readable label for an action on the current device.
function Input.Label(action: string): string
	if Input.Device == "Gamepad" then
		local b = Config.Bindings.Gamepad[action] or ""
		local names = { ButtonA = "A", ButtonB = "B", ButtonX = "X", ButtonY = "Y", ButtonR1 = "RB", ButtonL1 = "LB", ButtonR2 = "RT", ButtonL2 = "LT", ButtonStart = "Menu" }
		return names[b] or b
	elseif Input.Device == "Touch" then
		return string.upper(action)
	end
	local k = keyFor(action)
	local pretty = { Space = "Space", Escape = "Esc", LeftShift = "L-Shift", Return = "Enter" }
	return pretty[k] or k
end

local function inGameplay(): boolean
	local phase = State.Phase()
	return State.Joined and State.MySlot() > 0 and (phase == "Lobby" or phase == "Playing") and not State.Game():GetAttribute("Paused") and not State.MenuOpen
end

local function fire(action: string)
	if action == "Grab" then
		local char = State.Character()
		local holding = State.Player:GetAttribute("Holding")
		if holding then
			Net.Action:FireServer("Release")
			Input.ActionFired:Fire("Release")
		else
			local target = targetProvider and targetProvider()
			if target then
				Net.Action:FireServer("Grab", target.Name)
				Input.ActionFired:Fire("Grab")
			elseif char then
				Input.ActionFired:Fire("GrabMiss")
			end
		end
	elseif action == "Throw" then
		if State.Player:GetAttribute("Holding") then
			Net.Action:FireServer("Throw")
			Input.ActionFired:Fire("Throw")
		end
	elseif action == "Slap" then
		Net.Action:FireServer("Slap")
		Input.ActionFired:Fire("Slap")
	end
end

-- Public so touch buttons can press actions.
function Input.Press(action: string)
	if action == "Pause" then
		Input.PauseRequested:Fire()
		return
	end
	if not inGameplay() then
		return
	end
	if action == "Grab" and not State.Settings().GrabToggle then
		grabHeld = true
		if not State.Player:GetAttribute("Holding") then
			fire("Grab")
		end
		return
	end
	fire(action)
end

function Input.ReleasePress(action: string)
	if action == "Grab" and not State.Settings().GrabToggle and grabHeld then
		grabHeld = false
		if State.Player:GetAttribute("Holding") then
			Net.Action:FireServer("Release")
			Input.ActionFired:Fire("Release")
		end
	end
end

local function actionForKey(key: Enum.KeyCode): string?
	for _, action in Config.Bindings.Remappable do
		if keyFor(action) == key.Name or Config.Bindings.KeyboardAlt[action] == key.Name then
			return action
		end
	end
	if key == Enum.KeyCode.P or key == Enum.KeyCode.Escape then
		return "Pause"
	end
	return nil
end

local function actionForButton(key: Enum.KeyCode): string?
	for action, name in Config.Bindings.Gamepad do
		if name == key.Name and action ~= "Jump" then
			return action
		end
	end
	for action, name in Config.Bindings.GamepadAlt do
		if name == key.Name then
			return action
		end
	end
	return nil
end

-- Remapping: the next key press is handed to fn instead of the game.
function Input.Capture(fn: (Enum.KeyCode) -> ())
	capturing = fn
end

function Input.SetBinding(action: string, key: Enum.KeyCode)
	State.Profile.Bindings = State.Profile.Bindings or {}
	State.Profile.Bindings[action] = key.Name
	Net.Action:FireServer("SaveBindings", State.Profile.Bindings)
end

function Input.ResetBindings()
	State.Profile.Bindings = {}
	Net.Action:FireServer("SaveBindings", {})
end

function Input.KeyName(action: string): string
	return keyFor(action)
end

-- Character controls are off while a modal menu is open or the mover is frozen.
function Input.SetControlsEnabled(on: boolean)
	if not controls then
		return
	end
	if on then
		controls:Enable()
	else
		controls:Disable()
	end
end

local function setDevice(d: string)
	if Input.Device ~= d then
		Input.Device = d
		Input.DeviceChanged:Fire(d)
	end
end

local function clearHeldInput(reason: string)
	grabHeld = false
	if State.Player:GetAttribute("Holding") then
		Net.Action:FireServer("Release")
	end
	local solo = (State.Game():GetAttribute("MoverCount") or 0) <= 1
	if State.Phase() == "Playing" and not State.Game():GetAttribute("Paused") and (solo or reason == "gamepad") then
		Net.Action:FireServer("Pause")
	end
end

function Input.Init()
	task.spawn(function()
		local ok, module = pcall(function()
			return require(Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		end)
		if ok and module then
			controls = module:GetControls()
		end
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		setDevice("Touch")
	end

	UserInputService.LastInputTypeChanged:Connect(function(t)
		if t == Enum.UserInputType.Touch then
			setDevice("Touch")
		elseif t.Name:find("Gamepad") then
			setDevice("Gamepad")
		elseif t == Enum.UserInputType.Keyboard or t.Name:find("Mouse") then
			setDevice("Keyboard")
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if capturing and input.UserInputType == Enum.UserInputType.Keyboard then
			local fn = capturing
			capturing = nil
			fn(input.KeyCode) -- Escape means "cancel"
			return
		end
		local key = input.KeyCode
		-- menu navigation (keyboard); gamepad navigation is Roblox's own selection
		if UI.NavActive() and State.MenuOpen and input.UserInputType == Enum.UserInputType.Keyboard then
			if key == Enum.KeyCode.Up or key == Enum.KeyCode.W or key == Enum.KeyCode.Left or key == Enum.KeyCode.A then
				UI.NavMove(-1)
				return
			elseif key == Enum.KeyCode.Down or key == Enum.KeyCode.S or key == Enum.KeyCode.Right or key == Enum.KeyCode.D or key == Enum.KeyCode.Tab then
				UI.NavMove(1)
				return
			elseif key == Enum.KeyCode.Return or key == Enum.KeyCode.KeypadEnter or key == Enum.KeyCode.Space then
				UI.NavActivate()
				return
			elseif key == Enum.KeyCode.Escape or key == Enum.KeyCode.Backspace then
				Input.BackRequested:Fire()
				return
			end
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local action = actionForKey(key)
			if action == "Pause" then
				if State.MenuOpen then
					Input.BackRequested:Fire()
				else
					Input.PauseRequested:Fire()
				end
			elseif action and not processed then
				Input.Press(action)
			end
		elseif input.UserInputType.Name:find("Gamepad") then
			if key == Enum.KeyCode.ButtonB and State.MenuOpen then
				Input.BackRequested:Fire()
				return
			end
			local action = actionForButton(key)
			if action == "Pause" then
				if State.MenuOpen then
					Input.BackRequested:Fire()
				else
					Input.PauseRequested:Fire()
				end
			elseif action and not State.MenuOpen then
				Input.Press(action)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local action = actionForKey(input.KeyCode)
			if action then
				Input.ReleasePress(action)
			end
		elseif input.UserInputType.Name:find("Gamepad") then
			local action = actionForButton(input.KeyCode)
			if action then
				Input.ReleasePress(action)
			end
		end
	end)

	-- don't let the game's own keys scroll or trigger default actions
	ContextActionService:BindActionAtPriority("MO_SinkTab", function()
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Tab)

	UserInputService.WindowFocusReleased:Connect(function()
		clearHeldInput("focus")
	end)
	GuiService.MenuOpened:Connect(function()
		clearHeldInput("focus")
	end)
	UserInputService.GamepadDisconnected:Connect(function()
		if Input.Device == "Gamepad" then
			clearHeldInput("gamepad")
			Input.ActionFired:Fire("GamepadLost")
		end
	end)
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[--[[
	Menus.luau
	Every full menu: Title, Look (mover style), Job Board (with assists), Briefing,
	Pause (with confirmations), Results, Settings (volumes, grab mode, motion, text size,
	quality, key remapping) and Controls. Screens follow the shared game phase; every
	button does a real thing, and works with mouse, touch, keyboard and gamepad.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Jobs = require(ReplicatedStorage.Shared.Jobs)
local Movers = require(ReplicatedStorage.Shared.Movers)
local Net = require(ReplicatedStorage.Shared.Net)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)
local Input = require(script.Parent.Input)
local Audio = require(script.Parent.Audio)
local Effects = require(script.Parent.Effects)

local Menus = {}

local C = UI.Colors
local root: ScreenGui
local screens: { [string]: Frame } = {}
local navs: { [string]: { GuiObject } } = {}
local current: string? = nil
local stack: { string } = {}
local refreshers: { [string]: () -> () } = {}
local lastResults: any = nil
local selectedJob: string? = nil
local assists = table.clone(Config.Assists.Defaults)

Menus.Changed = State.Signal()

local function U(xs: number, xo: number, ys: number, yo: number): UDim2
	return UDim2.new(xs, xo, ys, yo)
end

local function screen(name: string, dim: boolean?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.fromRGB(26, 44, 74)
	f.BackgroundTransparency = dim == false and 1 or 0.42
	f.Visible = false
	f.Parent = root
	screens[name] = f
	return f
end

local function card(parent: Instance, w: number, h: number): Frame
	local p = UI.Panel(parent, UDim2.fromScale(w, h), UDim2.fromScale(0.5, 0.5))
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(980, 700)
	lim.Parent = p
	UI.Scaled(p)
	return p
end

function Menus.Current(): string?
	return current
end

-- Shows a screen (nil = none). push keeps the current one to come back to; pop is
-- used by Back so the rest of the stack survives.
function Menus.Show(name: string?, push: boolean?, pop: boolean?)
	if push and current and name then
		table.insert(stack, current)
	elseif not push and not pop then
		table.clear(stack)
	end
	for n, f in screens do
		f.Visible = n == name
	end
	current = name
	if name and refreshers[name] then
		refreshers[name]()
	end
	if name then
		local inner = screens[name]:FindFirstChildWhichIsA("Frame")
		if inner then
			UI.PopIn(inner)
		end
	end
	UI.SetNav(name and navs[name] or {})
	Input.SetControlsEnabled(name == nil)
	Audio.SetDucked(name == "Pause")
	Menus.Changed:Fire(name)
end

function Menus.Back()
	local prev = table.remove(stack)
	if prev then
		Menus.Show(prev, false, true)
	elseif current == "Pause" then
		Net.Action:FireServer("Resume")
	elseif current == "Title" or current == "Briefing" or current == "Results" then
		return -- these follow the game phase
	else
		Menus.Show(nil)
	end
end

----------------------------------------------------------------------------------------
-- Title

local function buildTitle()
	local s = screen("Title", false)
	local logo = UI.Title(s, Config.GameName, U(0.8, 0, 0.2, 0), U(0.5, 0, 0.22, 0), C.Yellow)
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Rotation = -3
	local sub = UI.Title(s, "Physics furniture moving - solo or with up to 4 movers", U(0.7, 0, 0.06, 0), U(0.5, 0, 0.36, 0), C.White)
	sub.AnchorPoint = Vector2.new(0.5, 0.5)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = U(0.32, 0, 0.4, 0)
	holder.Position = U(0.5, 0, 0.66, 0)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Parent = s
	local lim = Instance.new("UISizeConstraint")
	lim.MinSize = Vector2.new(220, 180)
	lim.MaxSize = Vector2.new(420, 330)
	lim.Parent = holder
	UI.Scaled(holder)
	local play = UI.NavButton(holder, "PLAY", U(1, 0, 0.3, 0), U(0.5, 0, 0.15, 0), function()
		State.Joined = true
		Net.Action:FireServer("Play")
		Menus.Show(nil)
		Menus.FollowPhase()
	end, C.Yellow)
	local settings = UI.NavButton(holder, "SETTINGS", U(1, 0, 0.2, 0), U(0.5, 0, 0.45, 0), function()
		Menus.Show("Settings", true)
	end, C.White)
	local controls = UI.NavButton(holder, "CONTROLS", U(1, 0, 0.2, 0), U(0.5, 0, 0.7, 0), function()
		Menus.Show("Controls", true)
	end, C.White)
	local note = UI.Title(s, "", U(0.8, 0, 0.04, 0), U(0.5, 0, 0.95, 0), C.White)
	note.AnchorPoint = Vector2.new(0.5, 0.5)
	navs.Title = { play, settings, controls }
	refreshers.Title = function()
		local status = State.SaveStatus
		note.Text = (status == "ok") and ("v" .. Config.Version) or ("v" .. Config.Version .. "  ·  progress is not being saved this session")
	end
end

----------------------------------------------------------------------------------------
-- Look (mover style)

local function lookCamera(vp: ViewportFrame)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.CFrame = CFrame.lookAt(Vector3.new(-2.2, 4.6, -13), Vector3.new(0, 3.05, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
end

local function buildLook()
	local s = screen("Look")
	local p = card(s, 0.94, 0.84)
	local size = p:FindFirstChildOfClass("UISizeConstraint")
	if size then
		size.MaxSize = Vector2.new(1400, 640)
	end
	UI.Banner(p, "Mover Select")
	UI.Text(p, "Pick your look. Your shirt keeps your player colour and number.", U(1, -40, 0.05, 0), U(0, 20, 0.775, 0), { TextColor3 = C.PanelDark, MaxText = 18 })
	local list = {}
	local cards: { [number]: TextButton } = {}
	local views: { [number]: ViewportFrame } = {}
	local builtFor = -1
	local n = #Movers.Styles
	local w = 0.96 / n
	for i, style in Movers.Styles do
		local b = UI.NavButton(p, "", U(w, -8, 0.66, 0), U(0.02 + (i - 0.5) * w, 0, 0.47, 0), function()
			Net.Action:FireServer("SetStyle", i)
			State.Profile.Style = i
			if refreshers.Look then
				refreshers.Look()
			end
		end, style.Card)
		b:SetAttribute("Style", i)
		local bar = Instance.new("UIAspectRatioConstraint")
		bar.AspectRatio = 0.56
		bar.Parent = b
		UI.Shade(b, 0.3)
		local vp = Instance.new("ViewportFrame")
		vp.Name = "Portrait"
		vp.Size = U(1, -6, 0.8, 0)
		vp.Position = U(0.5, 0, 0.02, 0)
		vp.AnchorPoint = Vector2.new(0.5, 0)
		vp.BackgroundTransparency = 1
		vp.Ambient = Color3.fromRGB(150, 150, 160)
		vp.LightColor = Color3.fromRGB(255, 250, 240)
		vp.LightDirection = Vector3.new(-0.6, -1, 0.9)
		vp.Parent = b
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 0.62
		ar.Parent = vp
		lookCamera(vp)
		views[i] = vp
		local name = UI.Outlined(b, style.Name, U(1, -8, 0.13, 0), U(0, 4, 0.84, 0), { MaxText = 26 })
		name.Name = "StyleName"
		local pick = Instance.new("Frame")
		pick.Name = "Picked"
		pick.BackgroundTransparency = 1
		pick.Size = U(1, 10, 1, 10)
		pick.Position = U(0, -5, 0, -5)
		pick.Visible = false
		pick.Parent = b
		UI.Corner(pick, 22)
		UI.Stroke(pick, 5, C.Yellow)
		local tag = UI.Outlined(pick, "Ready!", U(1, -10, 0, 30), U(0, 5, 0, 10), { MaxText = 28, TextColor3 = C.Yellow })
		tag.Name = "ReadyTag"
		cards[i] = b
		table.insert(list, b)
	end
	local done = UI.NavButton(p, "DONE", U(0.26, 0, 0.11, 0), U(0.5, 0, 0.9, 0), function()
		Menus.Back()
	end, C.Green)
	table.insert(list, done)
	navs.Look = list
	refreshers.Look = function()
		local mine = (State.Player:GetAttribute("Style") :: number?) or State.Profile.Style or 1
		local slot = State.MySlot()
		if slot ~= builtFor then
			builtFor = slot
			local info = Config.Slots[slot] or Config.Slots[1]
			for i, vp in views do
				local old = vp:FindFirstChild("MoverPreview")
				if old then
					old:Destroy()
				end
				local m = Movers.PreviewModel(i, info.Color, slot, Config.Movement.HeightScale)
				m.Parent = vp
			end
		end
		for i, b in cards do
			local pick = b:FindFirstChild("Picked") :: Frame
			pick.Visible = i == mine
		end
	end
end

----------------------------------------------------------------------------------------
-- Job board

local function medalColor(m: string?): Color3
	return m == "Gold" and C.Gold or m == "Silver" and C.Silver or m == "Bronze" and C.Bronze or C.Grey
end

local function buildBoard()
	local s = screen("Board")
	local p = card(s, 0.94, 0.9)
	UI.Banner(p, "Job Board", 0.36)
	local hostNote = UI.Text(p, "", U(0.6, 0, 0.045, 0), U(0.2, 0, 0.085, 0), { TextColor3 = C.PanelDark, MaxText = 20 })
	local list: { GuiObject } = {}
	local cards: { [string]: TextButton } = {}
	for i, job in Jobs.List do
		local b = UI.NavButton(p, "", U(0.23, 0, 0.42, 0), U(0.135 + (i - 1) * 0.243, 0, 0.36, 0), function()
			selectedJob = job.Id
			if refreshers.Board then
				refreshers.Board()
			end
		end, C.White)
		b.TextTransparency = 1
		local title = UI.Text(b, job.Name, U(1, 0, 0.2, 0), U(0, 0, 0, 0), { MaxText = 24 })
		title.Name = "JobTitle"
		local desc = UI.Text(b, job.Tagline or "", U(1, 0, 0.3, 0), U(0, 0, 0.22, 0), { TextColor3 = C.PanelDark, MaxText = 15 })
		desc.Name = "Desc"
		local info = UI.Text(b, "", U(1, 0, 0.26, 0), U(0, 0, 0.53, 0), { MaxText = 16 })
		info.Name = "Info"
		local badge = Instance.new("Frame")
		badge.Name = "Badge"
		badge.Size = U(0.5, 0, 0.16, 0)
		badge.Position = U(0.25, 0, 0.82, 0)
		badge.Parent = b
		UI.Corner(badge, 10)
		UI.Stroke(badge, 2)
		local bt = UI.Text(badge, "", UDim2.fromScale(1, 1), UDim2.new(), { MaxText = 16 })
		bt.Name = "BadgeText"
		cards[job.Id] = b
		table.insert(list, b)
	end

	-- assists
	local ax = Instance.new("Frame")
	ax.BackgroundTransparency = 1
	ax.Size = U(0.62, 0, 0.3, 0)
	ax.Position = U(0.02, 0, 0.6, 0)
	ax.Parent = p
	UI.Text(ax, "ASSISTS (host's choice, apply to everyone)", U(1, 0, 0.16, 0), U(0, 0, 0, 0), { TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18 })
	local assistInfo = UI.Text(ax, "", U(1, 0, 0.2, 0), U(0, 0, 0.82, 0), { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.PanelDark, MaxText = 14 })
	local function assistButton(label: string, x: number, y: number, explain: string, onClick: () -> ()): TextButton
		local b = UI.NavButton(ax, label, U(0.48, 0, 0.26, 0), U(x, 0, y, 0), function()
			onClick()
			assistInfo.Text = explain
			if refreshers.Board then
				refreshers.Board()
			end
		end, C.White)
		b.MouseEnter:Connect(function()
			assistInfo.Text = explain
		end)
		b.SelectionGained:Connect(function()
			assistInfo.Text = explain
		end)
		table.insert(list, b)
		return b
	end
	local timeB = assistButton("", 0.25, 0.33, "Award targets: multiplies the gold / silver / bronze times (easier awards).", function()
		local opts = Config.Assists.TimeTargetScale
		local i = table.find(opts, assists.TimeScale) or 1
		assists.TimeScale = opts[i % #opts + 1]
	end)
	local hazB = assistButton("", 0.75, 0.33, "Fewer hazards: longer gaps between cars and slower ghosts.", function()
		assists.ReducedHazards = not assists.ReducedHazards
	end)
	local heavyB = assistButton("", 0.25, 0.63, "Easier heavy items: more lift and speed when carrying big furniture.", function()
		assists.EasyHeavy = not assists.EasyHeavy
	end)
	local vanishB = assistButton("", 0.75, 0.63, "Delivered items vanish: furniture disappears once it counts, so the truck never fills up.", function()
		assists.VanishDelivered = not assists.VanishDelivered
	end)

	local start = UI.NavButton(p, "START JOB", U(0.3, 0, 0.12, 0), U(0.82, 0, 0.7, 0), function()
		if selectedJob and State.IsLeader() then
			Net.Action:FireServer("SelectJob", selectedJob, assists)
		end
	end, C.Green)
	local back = UI.NavButton(p, "BACK", U(0.3, 0, 0.1, 0), U(0.82, 0, 0.85, 0), function()
		Menus.Show(nil)
	end, C.White)
	table.insert(list, start)
	table.insert(list, back)
	navs.Board = list

	refreshers.Board = function()
		local profile = State.Profile
		local leader = State.IsLeader()
		hostNote.Text = leader and "You're the host: pick a job" or "Only the host (P1) can start a job"
		for i, job in Jobs.List do
			local b = cards[job.Id]
			local unlocked = i == 1 or (profile.Unlocked and profile.Unlocked[job.Id])
			local best = profile.Best and profile.Best[job.Id]
			local medal = profile.Medals and profile.Medals[job.Id]
			local info = b:FindFirstChild("Info") :: TextLabel
			local badge = b:FindFirstChild("Badge") :: Frame
			local bt = badge:FindFirstChild("BadgeText") :: TextLabel
			if unlocked then
				local a = job.Awards
				local sc = assists.TimeScale
				info.Text = string.format("%d items\nBest: %s\nGold %s · Silver %s · Bronze %s", Jobs.RequiredCount(job), best and UI.FormatTime(best) or "--", UI.FormatTime(a.Gold * sc), UI.FormatTime(a.Silver * sc), UI.FormatTime(a.Bronze * sc))
				badge.BackgroundColor3 = medalColor(medal)
				bt.Text = medal and medal ~= "None" and string.upper(medal) or "NO AWARD"
			else
				info.Text = "Finish the previous job to unlock"
				badge.BackgroundColor3 = C.Grey
				bt.Text = "LOCKED"
			end
			b.BackgroundColor3 = (selectedJob == job.Id) and C.Yellow or (unlocked and C.Cream or C.Grey)
			UI.SetDisabled(b, not unlocked)
		end
		timeB.Text = "Award times x" .. tostring(assists.TimeScale)
		hazB.Text = "Fewer hazards: " .. (assists.ReducedHazards and "ON" or "OFF")
		heavyB.Text = "Easier heavy: " .. (assists.EasyHeavy and "ON" or "OFF")
		vanishB.Text = "Items vanish: " .. (assists.VanishDelivered and "ON" or "OFF")
		UI.SetDisabled(start, not (leader and selectedJob ~= nil))
		for _, ab in { timeB, hazB, heavyB, vanishB } do
			UI.SetDisabled(ab, not leader)
		end
	end
	State.ProfileChanged:Connect(function()
		if current == "Board" then
			refreshers.Board()
		end
	end)
end

----------------------------------------------------------------------------------------
-- Briefing

local function buildBriefing()
	local s = screen("Briefing")
	local p = card(s, 0.8, 0.8)
	local title = UI.Banner(p, "", 0.5)
	local objective = UI.Text(p, "", U(1, -40, 0.08, 0), U(0, 20, 0.1, 0), { TextColor3 = C.Orange, MaxText = 26 })
	local body = UI.Text(p, "", U(0.55, -30, 0.5, 0), U(0, 20, 0.25, 0), { TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxText = 18 })
	local controls = UI.Text(p, "", U(0.42, -20, 0.5, 0), U(0.57, 0, 0.25, 0), { TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = C.PanelDark, MaxText = 16 })
	local wait = UI.Text(p, "", U(0.6, 0, 0.06, 0), U(0.2, 0, 0.77, 0), { TextColor3 = C.PanelDark, MaxText = 18 })
	local start = UI.NavButton(p, "START!", U(0.3, 0, 0.12, 0), U(0.66, 0, 0.9, 0), function()
		Net.Action:FireServer("StartJob")
	end, C.Green)
	local back = UI.NavButton(p, "JOB BOARD", U(0.26, 0, 0.1, 0), U(0.3, 0, 0.9, 0), function()
		Net.Action:FireServer("Board")
	end, C.White)
	navs.Briefing = { start, back }
	refreshers.Briefing = function()
		local id = State.Game():GetAttribute("JobId")
		local job = Jobs.ById[id or ""]
		if not job then
			return
		end
		local movers = (State.Game():GetAttribute("MoverCount") :: number?) or 1
		title.Text = job.Name
		objective.Text = "Move every required item into the truck as fast as you can!"
		local lines = {}
		for _, l in job.Briefing or {} do
			table.insert(lines, "• " .. l)
		end
		table.insert(lines, string.format("• %d items must end up in the truck.", Jobs.RequiredCount(job)))
		if movers > 1 then
			table.insert(lines, "• Heavy things: one mover grabs each end. Walk together to carry, walk around each other to turn it, both press Throw to toss it.")
		else
			table.insert(lines, "• Solo: you can drag heavy things alone - slower, but always possible.")
		end
		body.Text = table.concat(lines, "\n")
		controls.Text = table.concat({
			"Move: " .. (Input.Device == "Gamepad" and "left stick" or Input.Device == "Touch" and "thumbstick" or "WASD / arrows"),
			"Grab / drop: " .. Input.Label("Grab"),
			"Throw: " .. Input.Label("Throw"),
			"Slap: " .. Input.Label("Slap"),
			"Jump: " .. (Input.Device == "Gamepad" and "A" or Input.Device == "Touch" and "jump button" or "Space"),
			"Pause: " .. (Input.Device == "Gamepad" and "Menu" or Input.Device == "Touch" and "II button" or "P"),
		}, "\n")
		local leader = State.IsLeader()
		start.Visible = leader
		back.Visible = leader
		wait.Text = leader and "" or "Waiting for the host to start..."
	end
end

----------------------------------------------------------------------------------------
-- Pause

local confirmAction: (() -> ())? = nil

local function buildPause()
	local s = screen("Pause")
	local p = card(s, 0.42, 0.78)
	local title = UI.Banner(p, "Paused", 0.7)
	local by = UI.Text(p, "", U(1, -40, 0.06, 0), U(0, 20, 0.13, 0), { TextColor3 = C.PanelDark, MaxText = 18 })
	local y = 0.27
	local function b(text: string, fn: () -> (), color: Color3?): TextButton
		local btn = UI.NavButton(p, text, U(0.8, 0, 0.1, 0), U(0.5, 0, y, 0), fn, color or C.White)
		y += 0.125
		return btn
	end
	local resume = b("RESUME", function()
		Net.Action:FireServer("Resume")
	end, C.Green)
	local restart = b("RESTART JOB", function()
		confirmAction = function()
			Net.Action:FireServer("Restart")
		end
		Menus.Show("Confirm", true)
	end)
	local board = b("QUIT TO JOB BOARD", function()
		confirmAction = function()
			Net.Action:FireServer("Board")
		end
		Menus.Show("Confirm", true)
	end)
	local settings = b("SETTINGS", function()
		Menus.Show("Settings", true)
	end)
	local controls = b("CONTROLS", function()
		Menus.Show("Controls", true)
	end)
	local note = UI.Text(p, "", U(0.9, 0, 0.06, 0), U(0.05, 0, 0.9, 0), { TextColor3 = C.PanelDark, MaxText = 14 })
	navs.Pause = { resume, restart, board, settings, controls }
	refreshers.Pause = function()
		local slot = (State.Game():GetAttribute("PausedBy") :: number?) or 0
		by.Text = slot > 0 and ("Paused by " .. Config.Slots[slot].Name) or ""
		local leader = State.IsLeader()
		UI.SetDisabled(restart, not leader)
		UI.SetDisabled(board, not leader)
		note.Text = leader and "" or "Only the host can restart or quit the job."
		title.Text = "Paused"
	end

	-- confirmation dialog
	local cs = screen("Confirm")
	local cp = card(cs, 0.42, 0.36)
	UI.Banner(cp, "Are you sure?", 0.7)
	local ct = UI.Text(cp, "Progress in this job will be lost.", U(0.9, 0, 0.3, 0), U(0.05, 0, 0.2, 0), { MaxText = 24 })
	ct.Name = "Question"
	local yes = UI.NavButton(cp, "YES", U(0.38, 0, 0.24, 0), U(0.28, 0, 0.75, 0), function()
		local fn = confirmAction
		confirmAction = nil
		Menus.Back()
		if fn then
			fn()
		end
	end, C.Red)
	local no = UI.NavButton(cp, "NO", U(0.38, 0, 0.24, 0), U(0.72, 0, 0.75, 0), function()
		confirmAction = nil
		Menus.Back()
	end, C.White)
	navs.Confirm = { no, yes }
end

----------------------------------------------------------------------------------------
-- Results

local function buildResults()
	local s = screen("Results")
	local p = card(s, 0.6, 0.82)
	local title = UI.Banner(p, "Job Complete!", 0.6)
	local time = UI.Text(p, "", U(1, -40, 0.13, 0), U(0, 20, 0.14, 0), { MaxText = 52 })
	local medal = Instance.new("Frame")
	medal.Size = U(0.36, 0, 0.12, 0)
	medal.Position = U(0.32, 0, 0.29, 0)
	medal.Parent = p
	UI.Corner(medal, 20)
	UI.Stroke(medal, 5, C.White)
	UI.Shade(medal, 0.2)
	local medalText = UI.Outlined(medal, "", UDim2.fromScale(1, 1), UDim2.new(), { MaxText = 34 })
	local detail = UI.Text(p, "", U(0.9, 0, 0.24, 0), U(0.05, 0, 0.43, 0), { TextColor3 = C.PanelDark, MaxText = 20 })
	local replay = UI.NavButton(p, "REPLAY", U(0.28, 0, 0.11, 0), U(0.2, 0, 0.82, 0), function()
		Net.Action:FireServer("Replay")
	end, C.Yellow)
	local nextB = UI.NavButton(p, "NEXT JOB", U(0.28, 0, 0.11, 0), U(0.5, 0, 0.82, 0), function()
		Net.Action:FireServer("NextJob")
	end, C.Green)
	local board = UI.NavButton(p, "JOB BOARD", U(0.28, 0, 0.11, 0), U(0.8, 0, 0.82, 0), function()
		Net.Action:FireServer("Board")
	end, C.White)
	local wait = UI.Text(p, "", U(0.9, 0, 0.05, 0), U(0.05, 0, 0.93, 0), { TextColor3 = C.PanelDark, MaxText = 14 })
	navs.Results = { nextB, replay, board }
	refreshers.Results = function()
		local r = lastResults
		if not r then
			time.Text = "..."
			return
		end
		local job = Jobs.ById[r.JobId]
		title.Text = "Job Complete!"
		time.Text = UI.FormatTime(r.Time)
		medal.BackgroundColor3 = medalColor(r.Medal)
		medalText.Text = r.Medal == "None" and "NO AWARD" or string.upper(r.Medal)
		local lines = {}
		if r.NewBest then
			table.insert(lines, r.PrevBest and string.format("NEW BEST! (was %s)", UI.FormatTime(r.PrevBest)) or "First clear - best time saved!")
		elseif r.PrevBest then
			table.insert(lines, "Best: " .. UI.FormatTime(r.PrevBest))
		end
		if job then
			local a = job.Awards
			local sc = r.Scale or 1
			table.insert(lines, string.format("Gold %s · Silver %s · Bronze %s", UI.FormatTime(a.Gold * sc), UI.FormatTime(a.Silver * sc), UI.FormatTime(a.Bronze * sc)))
		end
		if r.Unlocked and Jobs.ById[r.Unlocked] then
			table.insert(lines, "Unlocked: " .. Jobs.ById[r.Unlocked].Name)
		end
		if r.Assisted then
			table.insert(lines, "(assists were on)")
		end
		detail.Text = table.concat(lines, "\n")
		local leader = State.IsLeader()
		local hasNext = job and Jobs.Next(job.Id) ~= nil
		replay.Visible = leader
		board.Visible = leader
		nextB.Visible = leader and hasNext == true
		wait.Text = leader and "" or "Waiting for the host..."
	end
	Effects.Event:Connect(function(kind, data)
		if kind == "Results" then
			lastResults = data
			if current == "Results" then
				refreshers.Results()
			end
		end
	end)
end

----------------------------------------------------------------------------------------
-- Settings

local function buildSettings()
	local s = screen("Settings")
	local p = card(s, 0.8, 0.88)
	UI.Banner(p, "Settings", 0.36)
	local list: { GuiObject } = {}
	local labels: { [string]: TextButton } = {}
	local explain = UI.Text(p, "", U(0.9, 0, 0.06, 0), U(0.05, 0, 0.8, 0), { TextColor3 = C.PanelDark, MaxText = 15 })
	local row = 0
	local function item(key: string, onClick: () -> (), help: string, col: number): TextButton
		local b = UI.NavButton(p, "", U(0.44, 0, 0.075, 0), U(0.27 + col * 0.46, 0, 0.17 + row * 0.088, 0), function()
			onClick()
			if refreshers.Settings then
				refreshers.Settings()
			end
			explain.Text = help
		end, C.White)
		b.MouseEnter:Connect(function()
			explain.Text = help
		end)
		b.SelectionGained:Connect(function()
			explain.Text = help
		end)
		labels[key] = b
		b:SetAttribute("Label", key)
		table.insert(list, b)
		if col == 1 then
			row += 1
		end
		return b
	end
	local textFns: { [TextButton]: () -> string } = {}
	local function add(key: string, text: () -> string, onClick: () -> (), help: string, col: number)
		local b = item(key, onClick, help, col)
		textFns[b] = text
	end
	local function cycleVolume(key: string)
		local v = State.Settings()[key] or 0.5
		v = math.floor(v * 10 + 0.5) / 10 + 0.2
		if v > 1.01 then
			v = 0
		end
		State.SetSetting(key, v)
	end
	local function pct(key: string): string
		return tostring(math.floor((State.Settings()[key] or 0) * 100 + 0.5)) .. "%"
	end
	add("Master", function()
		return "Master volume: " .. pct("Master")
	end, function()
		cycleVolume("Master")
	end, "Overall volume (tap to step 0-100%).", 0)
	add("Mute", function()
		return "Mute: " .. (State.Settings().Mute and "ON" or "OFF")
	end, function()
		State.SetSetting("Mute", not State.Settings().Mute)
	end, "Silences all game sound.", 1)
	add("Music", function()
		return "Music: " .. pct("Music")
	end, function()
		cycleVolume("Music")
	end, "Volume of the generated music.", 0)
	add("Effects", function()
		return "Effects: " .. pct("Effects")
	end, function()
		cycleVolume("Effects")
	end, "Volume of sound effects.", 1)
	add("GrabToggle", function()
		return "Grab mode: " .. (State.Settings().GrabToggle and "TOGGLE" or "HOLD")
	end, function()
		State.SetSetting("GrabToggle", not State.Settings().GrabToggle)
	end, "Toggle: press grab to pick up, press again to drop. Hold: keep the button held to carry.", 0)
	add("ReducedShake", function()
		return "Reduced motion: " .. (State.Settings().ReducedShake and "ON" or "OFF")
	end, function()
		State.SetSetting("ReducedShake", not State.Settings().ReducedShake)
	end, "Turns off screen shake and menu bounce animations.", 1)
	add("TextScale", function()
		return "Text & HUD size: " .. tostring(State.Settings().TextScale or 1) .. "x"
	end, function()
		local opts = { 0.85, 1, 1.15, 1.3 }
		local i = table.find(opts, State.Settings().TextScale) or 2
		State.SetSetting("TextScale", opts[i % #opts + 1])
	end, "Makes menus and the HUD bigger or smaller.", 0)
	add("Quality", function()
		return "Graphics: " .. (State.Settings().Quality or "High")
	end, function()
		State.SetSetting("Quality", State.Settings().Quality == "Low" and "High" or "Low")
	end, "Low: fewer shadows and effects for older devices. Gameplay is identical.", 1)
	add("ShowTutorialHints", function()
		return "Tutorial hints: " .. (State.Settings().ShowTutorialHints and "ON" or "OFF")
	end, function()
		State.SetSetting("ShowTutorialHints", not State.Settings().ShowTutorialHints)
	end, "Shows the step-by-step hints card in the yard and the first job.", 0)
	add("Reset", function()
		return "Reset key bindings"
	end, function()
		Input.ResetBindings()
	end, "Puts Grab / Throw / Slap back on E / Q / F.", 1)
	for _, action in Config.Bindings.Remappable do
		add("Bind" .. action, function()
			return action .. " key: " .. Input.KeyName(action)
		end, function()
			local b = labels["Bind" .. action]
			b.Text = "Press a key... (Esc cancels)"
			Input.Capture(function(key)
				if key ~= Enum.KeyCode.Escape then
					Input.SetBinding(action, key)
				end
				if refreshers.Settings then
					refreshers.Settings()
				end
			end)
		end, "Choose a new keyboard key. The alternate keys (L-Shift / R / G) always work too.", action == "Throw" and 1 or 0)
	end
	local back = UI.NavButton(p, "BACK", U(0.3, 0, 0.08, 0), U(0.5, 0, 0.92, 0), function()
		Menus.Back()
	end, C.Green)
	table.insert(list, back)
	navs.Settings = list
	refreshers.Settings = function()
		for b, fn in textFns do
			b.Text = fn()
		end
	end
end

----------------------------------------------------------------------------------------
-- Controls

local function buildControls()
	local s = screen("Controls")
	local p = card(s, 0.8, 0.84)
	UI.Banner(p, "Controls", 0.36)
	local cols = {
		{ "KEYBOARD", "Move: WASD or arrows\nGrab / drop: E (or L-Shift)\nThrow: Q (or R)\nSlap: F (or G)\nJump: Space\nPause: P or Esc\nMenus: arrows + Enter" },
		{ "GAMEPAD", "Move: left stick\nGrab / drop: RB (or RT)\nThrow: X (or B)\nSlap: Y (or LB)\nJump: A\nPause: Menu\nMenus: d-pad + A, B back" },
		{ "TOUCH", "Move: thumbstick\nGrab / drop: GRAB\nThrow: THROW\nSlap: SLAP\nJump: jump button\nPause: II (top left)" },
	}
	for i, c in cols do
		UI.Text(p, c[1], U(0.3, 0, 0.07, 0), U(0.03 + (i - 1) * 0.32, 0, 0.14, 0), { TextColor3 = C.Orange, MaxText = 24 })
		UI.Text(p, c[2], U(0.3, 0, 0.42, 0), U(0.03 + (i - 1) * 0.32, 0, 0.23, 0), { TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxText = 18 })
	end
	UI.Text(p, "Heavy furniture: grab one end each. Walk together to carry, walk around each other to turn it, and both press Throw within a moment to toss it. Light things fly far: throw them over gaps and into the truck!", U(0.94, 0, 0.16, 0), U(0.03, 0, 0.68, 0), { TextColor3 = C.PanelDark, MaxText = 17 })
	local back = UI.NavButton(p, "BACK", U(0.3, 0, 0.09, 0), U(0.5, 0, 0.91, 0), function()
		Menus.Back()
	end, C.Green)
	navs.Controls = { back }
end

----------------------------------------------------------------------------------------

-- Opens the right screen for the shared phase (called whenever it changes).
function Menus.FollowPhase()
	if not State.Joined then
		Menus.Show("Title")
		return
	end
	local phase = State.Phase()
	local paused = State.Game():GetAttribute("Paused") == true
	if phase == "Briefing" or phase == "Countdown" then
		lastResults = nil
	end
	if phase == "Briefing" then
		if current ~= "Settings" and current ~= "Controls" then
			Menus.Show("Briefing")
		end
	elseif phase == "Results" then
		Menus.Show("Results")
	elseif phase == "Playing" and paused then
		if current ~= "Pause" and current ~= "Confirm" and current ~= "Settings" and current ~= "Controls" then
			Menus.Show("Pause")
		end
	elseif phase == "Playing" or phase == "Countdown" then
		if current ~= nil then
			Menus.Show(nil)
		end
	elseif phase == "Lobby" then
		if current == "Briefing" or current == "Results" or current == "Pause" or current == "Confirm" then
			Menus.Show(nil)
		end
		if current == "Board" and refreshers.Board then
			refreshers.Board()
		end
	end
	if current == "Briefing" and refreshers.Briefing then
		refreshers.Briefing()
	end
end

function Menus.OpenBoard()
	selectedJob = selectedJob or Jobs.List[1].Id
	Menus.Show("Board")
end

function Menus.OpenLook()
	Menus.Show("Look")
end

function Menus.Open(name: string)
	Menus.Show(name, current ~= nil)
end

function Menus.Init()
	root = UI.Root("Menus", 20)
	root.ScreenInsets = Enum.ScreenInsets.None -- the dimmer covers the notch strips too
	buildTitle()
	buildLook()
	buildBoard()
	buildBriefing()
	buildPause()
	buildResults()
	buildSettings()
	buildControls()
	local game_ = State.Game()
	for _, attr in { "Phase", "Paused", "Leader", "JobId", "MoverCount" } do
		game_:GetAttributeChangedSignal(attr):Connect(Menus.FollowPhase)
	end
	Input.BackRequested:Connect(function()
		if current == "Title" then
			return
		end
		Menus.Back()
	end)
	Input.PauseRequested:Connect(function()
		if State.Phase() == "Playing" and not State.Game():GetAttribute("Paused") then
			Net.Action:FireServer("Pause")
		elseif current == nil and State.Joined and State.Phase() == "Lobby" then
			Menus.Show("Board")
		end
	end)
	State.SettingsChanged:Connect(function()
		if current and refreshers[current] then
			refreshers[current]()
		end
	end)
	Workspace:GetAttributeChangedSignal("ServerStarted"):Connect(Menus.FollowPhase)
	Menus.Show("Title")
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">MoverAnimator</string>
            <string name="Source"><![CDATA[--[[
	MoverAnimator.luau
	Everything that makes movers readable and expressive, for every mover (local only):
	  * a numbered ground ring in the slot colour that sits on the floor under the mover
	    (raycast; hidden while falling / recovering, never z-fights: it floats 0.06 up),
	  * an overhead tag "P1 ▲" (number + symbol, not just colour),
	  * procedural poses layered over Roblox's walk / idle / jump animations:
	    carrying (arms out to the load, heavier = lower arms and a lean), throw wind-up
	    and release, slap, stunned flailing with stars, celebrating.
	Poses write Motor6D.Transform in PreSimulation, after the Animator has run.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local MoverAnimator = {}

type Rig = {
	Player: Player,
	Char: Model,
	Root: BasePart,
	Humanoid: Humanoid,
	LS: Motor6D?,
	RS: Motor6D?,
	LE: Motor6D?,
	RE: Motor6D?,
	Waist: Motor6D?,
	Neck: Motor6D?,
	Ring: Part,
	RingLabel: TextLabel,
	RingStroke: UIStroke,
	Tag: BillboardGui,
	Stars: BillboardGui,
	ThrowAt: number,
}

local rigs: { [Player]: Rig } = {}
local folder: Folder
local rad = math.rad
local Angles = CFrame.Angles

MoverAnimator.Landed = State.Signal()

local function motor(char: Model, part: string, name: string): Motor6D?
	local p = char:FindFirstChild(part)
	return p and p:FindFirstChild(name) :: Motor6D?
end

local function makeRing(slot: number): (Part, TextLabel, UIStroke)
	local info = Config.Slots[slot] or Config.Slots[1]
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Transparency = 1
	ring.Size = Vector3.new(4.6, 0.1, 4.6)
	ring.Parent = folder
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = ring
	local circle = Instance.new("Frame")
	circle.Size = UDim2.fromScale(0.92, 0.92)
	circle.Position = UDim2.fromScale(0.5, 0.5)
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.BackgroundTransparency = 1
	circle.Parent = gui
	UI.Corner(circle, 999)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 14
	stroke.Color = info.Color
	stroke.Parent = circle
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(0.3, 0.3)
	label.Position = UDim2.fromScale(0.5, 0.96)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.BackgroundColor3 = info.Color
	label.Font = UI.Font
	label.Text = tostring(slot)
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = gui
	UI.Corner(label, 999)
	return ring, label, stroke
end

local function makeTag(player: Player, slot: number, head: BasePart): (BillboardGui, BillboardGui)
	local info = Config.Slots[slot] or Config.Slots[1]
	local tag = Instance.new("BillboardGui")
	tag.Name = "MoverTag"
	tag.Size = UDim2.fromOffset(64, 22)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 3.3, 0)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0
	tag.MaxDistance = 400
	tag.Adornee = head
	tag.Parent = folder
	-- small and quiet: the ring and shirt number do most of the work; your own tag
	-- gets a white outline so you can find yourself in a crowd
	local t = UI.Text(tag, info.Name .. info.Symbol, UDim2.fromScale(1, 1), UDim2.new(), { TextColor3 = info.Color, MaxText = 18 })
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = player == Players.LocalPlayer and Color3.new(1, 1, 1) or Color3.fromRGB(30, 24, 36)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = t
	local stars = Instance.new("BillboardGui")
	stars.Name = "Stars"
	stars.Size = UDim2.fromOffset(90, 40)
	stars.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	stars.AlwaysOnTop = true
	stars.Enabled = false
	stars.Adornee = head
	stars.Parent = folder
	UI.Text(stars, "★ ✦ ★", UDim2.fromScale(1, 1), UDim2.new(), { TextColor3 = Color3.fromRGB(255, 220, 80), MaxText = 30 })
	return tag, stars
end

local function removeRig(player: Player)
	local r = rigs[player]
	if r then
		r.Ring:Destroy()
		r.Tag:Destroy()
		r.Stars:Destroy()
		rigs[player] = nil
	end
end

local function buildRig(player: Player, char: Model)
	removeRig(player)
	local root = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	local head = char:WaitForChild("Head", 10) :: BasePart?
	if not root or not hum or not head then
		return
	end
	local slot = (player:GetAttribute("Slot") :: number?) or 1
	local ring, label, stroke = makeRing(slot)
	local tag, stars = makeTag(player, slot, head)
	local rig: Rig = {
		Player = player,
		Char = char,
		Root = root,
		Humanoid = hum,
		LS = motor(char, "LeftUpperArm", "LeftShoulder"),
		RS = motor(char, "RightUpperArm", "RightShoulder"),
		LE = motor(char, "LeftLowerArm", "LeftElbow"),
		RE = motor(char, "RightLowerArm", "RightElbow"),
		Waist = motor(char, "UpperTorso", "Waist"),
		Neck = motor(char, "Head", "Neck"),
		Ring = ring,
		RingLabel = label,
		RingStroke = stroke,
		Tag = tag,
		Stars = stars,
		ThrowAt = 0,
	}
	rigs[player] = rig
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed then
			MoverAnimator.Landed:Fire(player, root.Position - Vector3.new(0, 2.6, 0))
		elseif new == Enum.HumanoidStateType.Jumping and player == Players.LocalPlayer then
			MoverAnimator.Landed:Fire(player, nil)
		end
	end)
end

-- Marks a throw release so the arms snap forward (called from Effects).
function MoverAnimator.ThrowRelease(player: Player)
	local r = rigs[player]
	if r then
		r.ThrowAt = os.clock()
	end
end

local function track(player: Player)
	local function onChar(char: Model)
		task.spawn(buildRig, player, char)
	end
	if player.Character then
		onChar(player.Character)
	end
	player.CharacterAdded:Connect(onChar)
	player.CharacterRemoving:Connect(function()
		removeRig(player)
	end)
	player:GetAttributeChangedSignal("Slot"):Connect(function()
		if player.Character then
			onChar(player.Character)
		end
	end)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function updateRings()
	local exclude: { Instance } = { folder }
	for _, r in rigs do
		table.insert(exclude, r.Char)
	end
	local level = Workspace:FindFirstChild("Level")
	if level and level:FindFirstChild("Items") then
		table.insert(exclude, (level :: any).Items)
	end
	rayParams.FilterDescendantsInstances = exclude
	for player, r in rigs do
		if not r.Root.Parent then
			continue
		end
		local hit = Workspace:Raycast(r.Root.Position, Vector3.new(0, -14, 0), rayParams)
		local visible = hit ~= nil and not player:GetAttribute("Recovering") and r.Root.Position.Y > -10
		if hit then
			r.Ring.CFrame = CFrame.new(hit.Position + Vector3.new(0, 0.06, 0))
		end
		local gui = r.Ring:FindFirstChildOfClass("SurfaceGui")
		if gui then
			gui.Enabled = visible
		end
		-- the ring shrinks a little while airborne so jumps read clearly
		local air = hit and (r.Root.Position.Y - hit.Position.Y) or 0
		local s = math.clamp(1 - (air - 2.6) / 10, 0.6, 1)
		r.Ring.Size = Vector3.new(4.6 * s, 0.1, 4.6 * s)
	end
end

local function pose(r: Rig, t: number)
	local p = r.Player
	local now = Workspace:GetServerTimeNow()
	local stunned = ((p:GetAttribute("StunUntil") :: number?) or 0) > now
	local holding = p:GetAttribute("Holding")
	local class = p:GetAttribute("HoldingClass")
	local windup = p:GetAttribute("Windup")
	local slapAt = (p:GetAttribute("SlapAt") :: number?) or 0
	local celebrating = State.Phase() == "Results"
	r.Stars.Enabled = stunned

	local ls, rs, le, re, waist, neck
	if stunned then
		local w = math.sin(t * 18)
		ls = Angles(rad(150 + w * 20), 0, rad(-25))
		rs = Angles(rad(150 - w * 20), 0, rad(25))
		waist = Angles(0, rad(w * 15), rad(w * 6))
		neck = Angles(0, rad(-w * 20), 0)
	elseif celebrating then
		local w = math.sin(t * 10)
		ls = Angles(rad(165), 0, rad(-20 + w * 15))
		rs = Angles(rad(165), 0, rad(20 - w * 15))
		waist = Angles(0, rad(w * 8), 0)
	elseif windup then
		ls = Angles(rad(165), 0, rad(-10))
		rs = Angles(rad(165), 0, rad(10))
		waist = Angles(rad(-14), 0, 0)
	elseif os.clock() - r.ThrowAt < 0.25 then
		ls = Angles(rad(70), 0, 0)
		rs = Angles(rad(70), 0, 0)
		waist = Angles(rad(14), 0, 0)
	elseif holding then
		local heavy = class == "Heavy"
		local medium = class == "Medium"
		local lift = heavy and 62 or (medium and 72 or 85)
		local bob = math.sin(t * 9) * (heavy and 3 or 1.5) * math.clamp(r.Root.AssemblyLinearVelocity.Magnitude / 10, 0, 1)
		ls = Angles(rad(lift + bob), 0, rad(-12))
		rs = Angles(rad(lift - bob), 0, rad(12))
		le = Angles(rad(15), 0, 0)
		re = Angles(rad(15), 0, 0)
		waist = Angles(rad(heavy and 10 or (medium and 5 or -3)), 0, 0)
	end
	if now - slapAt < 0.3 then
		local k = (now - slapAt) / 0.3
		rs = Angles(rad(95), rad(-70 + 140 * k), 0)
		waist = Angles(0, rad(-25 + 50 * k), 0)
	end
	if ls and r.LS then
		r.LS.Transform = ls
	end
	if rs and r.RS then
		r.RS.Transform = rs
	end
	if le and r.LE then
		r.LE.Transform = le
	end
	if re and r.RE then
		r.RE.Transform = re
	end
	if waist and r.Waist then
		r.Waist.Transform = waist
	end
	if neck and r.Neck then
		r.Neck.Transform = neck
	end
end

function MoverAnimator.Init()
	folder = Instance.new("Folder")
	folder.Name = "MoverFx"
	folder.Parent = Workspace
	for _, p in Players:GetPlayers() do
		track(p)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(removeRig)
	RunService.PreSimulation:Connect(function()
		local t = os.clock()
		for _, r in rigs do
			if r.Char.Parent then
				pose(r, t)
			end
		end
	end)
	RunService.RenderStepped:Connect(updateRings)
end

return MoverAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	State.luau
	Client-side shared state: the saved profile (settings, bindings, records), the
	current menu screen, and a tiny signal helper. Settings changes are saved through
	the server (the profile lives in a DataStore).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local State = {}

export type Signal = { Connect: (self: Signal, fn: (...any) -> ()) -> (), Fire: (self: Signal, ...any) -> () }

function State.Signal(): Signal
	local listeners: { (...any) -> () } = {}
	local s = {}
	function s.Connect(_self, fn)
		table.insert(listeners, fn)
	end
	function s.Fire(_self, ...)
		for _, fn in listeners do
			task.spawn(fn, ...)
		end
	end
	return s :: any
end

State.Player = Players.LocalPlayer
State.Profile = {
	Settings = table.clone(Config.SettingsDefaults),
	Bindings = {},
	Unlocked = {},
	Best = {},
	Medals = {},
	Style = 1,
	TutorialSeen = false,
} :: any
State.SaveStatus = "memory"
State.Joined = false -- pressed PLAY and owns a mover slot (or spectates)
State.MenuOpen = false -- a modal menu is open (movement keys drive the menu)
State.ProfileChanged = State.Signal()
State.SettingsChanged = State.Signal()

function State.Settings(): any
	return State.Profile.Settings
end

function State.SetSetting(key: string, value: any)
	State.Profile.Settings[key] = value
	State.SettingsChanged:Fire(key, value)
	Net.Action:FireServer("SaveSettings", State.Profile.Settings)
end

function State.LoadProfile()
	local ok, profile, status = pcall(function()
		return Net.Profile:InvokeServer()
	end)
	if ok and type(profile) == "table" then
		State.Profile = profile
		State.SaveStatus = status or "memory"
	end
	State.ProfileChanged:Fire()
	State.SettingsChanged:Fire()
end

function State.Game(): Folder
	return Net.State()
end

function State.Phase(): string
	return (State.Game():GetAttribute("Phase") :: string?) or "Lobby"
end

function State.MySlot(): number
	return (State.Player:GetAttribute("Slot") :: number?) or 0
end

function State.IsLeader(): boolean
	return State.Game():GetAttribute("Leader") == State.Player.UserId
end

function State.Character(): Model?
	return State.Player.Character
end

function State.Root(): BasePart?
	local c = State.Player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Targeting</string>
            <string name="Source"><![CDATA[--[[
	Targeting.luau
	Picks the furniture the local mover would grab and outlines it.

	Score = distance to the nearest point of the item's box (not its centre: a long
	sofa's near end counts) + a penalty for items behind the mover. Items behind walls
	are skipped (raycast), full items (no free grip) are skipped, and a new target must
	beat the current one by Config.Carry.TargetHysteresis so the outline doesn't flicker
	between two items when standing between them. The server re-validates every grab.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)

local Targeting = {}

local current: Model? = nil
local highlight: Highlight
Targeting.Changed = State.Signal()

local function closestPoint(body: BasePart, pos: Vector3): Vector3
	local half = body.Size / 2
	local lp = body.CFrame:PointToObjectSpace(pos)
	local c = Vector3.new(math.clamp(lp.X, -half.X, half.X), math.clamp(lp.Y, -half.Y, half.Y), math.clamp(lp.Z, -half.Z, half.Z))
	return body.CFrame:PointToWorldSpace(c)
end

local function blocked(origin: Vector3, point: Vector3, model: Model): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex: { Instance } = { model }
	local char = State.Character()
	if char then
		table.insert(ex, char)
	end
	params.FilterDescendantsInstances = ex
	local d = point - origin
	if d.Magnitude < 0.5 then
		return false
	end
	local hit = Workspace:Raycast(origin, d.Unit * (d.Magnitude - 0.3), params)
	return hit ~= nil and hit.Instance.CanCollide and not hit.Instance:GetAttribute("Ground") and hit.Instance.Name ~= "Body"
end

function Targeting.Current(): Model?
	if current and current.Parent then
		return current
	end
	return nil
end

local function score(model: Model, root: BasePart): number?
	local body = model.PrimaryPart
	if not body or model:GetAttribute("Recovering") or model:GetAttribute("Vanished") then
		return nil
	end
	local holders = (model:GetAttribute("Holders") :: number?) or 0
	local max = (model:GetAttribute("MaxHolders") :: number?) or 1
	if holders >= max then
		return nil
	end
	local point = closestPoint(body, root.Position)
	local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
	local dist = flat.Magnitude
	if dist > Config.Carry.Reach then
		return nil
	end
	local look = root.CFrame.LookVector
	local dot = dist > 0.1 and look:Dot(flat.Unit) or 1
	if blocked(root.Position, point, model) then
		return nil
	end
	return dist + (1 - dot) * Config.Carry.FacingWeight
end

local function setCurrent(m: Model?)
	if m == current then
		return
	end
	current = m
	highlight.Adornee = m
	highlight.Enabled = m ~= nil
	Targeting.Changed:Fire(m)
end

local function update()
	local root = State.Root()
	local level = Workspace:FindFirstChild("Level")
	local items = level and level:FindFirstChild("Items")
	if not root or not items or State.Player:GetAttribute("Holding") or State.MySlot() == 0 then
		setCurrent(nil)
		return
	end
	local slot = Config.Slots[State.MySlot()]
	if slot then
		highlight.OutlineColor = slot.Color
	end
	local best, bestScore = nil, math.huge
	local currentScore: number? = nil
	for _, m in items:GetChildren() do
		if m:IsA("Model") then
			local s = score(m, root)
			if s then
				if m == current then
					currentScore = s
				end
				if s < bestScore then
					best, bestScore = m, s
				end
			end
		end
	end
	if currentScore and best ~= current and bestScore > currentScore - Config.Carry.TargetHysteresis then
		return -- keep the current target (hysteresis)
	end
	setCurrent(best)
end

function Targeting.Init()
	highlight = Instance.new("Highlight")
	highlight.Name = "GrabTarget"
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.82
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = Workspace
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 1 / 20 then
			acc = 0
			update()
		end
	end)
end

return Targeting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	UI.luau
	Small UI kit in the game's chunky cartoon style: cream cards with a tan rim and a
	sky-blue ribbon title, big rounded buttons with a soft top-lit gradient, bold white
	FredokaOne text with a dark outline on coloured surfaces. Every button is selectable with a gamepad and
	navigable with the keyboard (arrows / WASD + Enter) through UI.SetNav, and shows a
	clear focus ring. Text and HUD scale with the TextScale setting.
]]

local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local State = require(script.Parent.State)

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.Colors = {
	Panel = Color3.fromRGB(253, 244, 222),
	PanelRim = Color3.fromRGB(232, 208, 164),
	PanelDark = Color3.fromRGB(110, 84, 64),
	Ink = Color3.fromRGB(70, 48, 40),
	Cream = Color3.fromRGB(244, 226, 190),
	Sky = Color3.fromRGB(96, 198, 244),
	SkyDark = Color3.fromRGB(28, 96, 160),
	Yellow = Color3.fromRGB(255, 204, 64),
	Orange = Color3.fromRGB(255, 140, 70),
	Red = Color3.fromRGB(236, 84, 80),
	Green = Color3.fromRGB(96, 200, 110),
	Blue = Color3.fromRGB(90, 160, 240),
	White = Color3.fromRGB(255, 255, 255),
	Grey = Color3.fromRGB(190, 186, 196),
	Gold = Color3.fromRGB(255, 200, 50),
	Silver = Color3.fromRGB(200, 210, 222),
	Bronze = Color3.fromRGB(214, 140, 80),
}
local C = UI.Colors

local roots: { ScreenGui } = {}
local scales: { UIScale } = {}

-- Small screens (phones) shrink the UI so it doesn't cover the playfield.
local function screenFactor(): number
	local cam = workspace.CurrentCamera
	local h = cam and cam.ViewportSize.Y or 720
	return math.clamp(h / 720, 0.62, 1)
end
UI.ScreenFactor = screenFactor

local function applyScale()
	local s = (State.Settings().TextScale or 1) * screenFactor()
	for _, sc in scales do
		sc.Scale = s
	end
end

function UI.Root(name: string, order: number): ScreenGui
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = order
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	table.insert(roots, g)
	return g
end

-- A full-screen container that scales with the TextScale setting.
function UI.Layer(root: ScreenGui, name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundTransparency = 1
	f.Parent = root
	return f
end

-- Scales a frame's contents by the TextScale setting (pinned at the given anchor).
function UI.Scaled(frame: GuiObject)
	local s = Instance.new("UIScale")
	s.Parent = frame
	table.insert(scales, s)
	applyScale()
end

function UI.Corner(obj: GuiObject, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 16)
	c.Parent = obj
	return c
end

function UI.Stroke(obj: GuiObject, thickness: number?, color: Color3?): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or C.Ink
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
	return s
end

function UI.Panel(parent: Instance, size: UDim2, pos: UDim2, anchor: Vector2?, color: Color3?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = color or C.Panel
	f.BorderSizePixel = 0
	f.Parent = parent
	UI.Corner(f, 22)
	UI.Stroke(f, 6, C.PanelRim)
	return f
end

-- Vertical top-lit shading for chunky surfaces (multiplies the background colour).
function UI.Shade(obj: GuiObject, amount: number?)
	local g = Instance.new("UIGradient")
	local k = 1 - (amount or 0.14)
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(k, k, k))
	g.Rotation = 90
	g.Parent = obj
	return g
end

-- Bold outlined text (white with a dark contextual stroke), like the HUD numbers.
function UI.Outlined(parent: Instance, text: string, size: UDim2, pos: UDim2, props: any?): TextLabel
	local t = UI.Text(parent, text, size, pos, props)
	if not (props and props.TextColor3) then
		t.TextColor3 = C.White
	end
	local s = Instance.new("UIStroke")
	s.Thickness = props and props.Outline or 3
	s.Color = props and props.OutlineColor or C.Ink
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = t
	return t
end

-- A sky-blue ribbon title tag that straddles the top edge of a card.
function UI.Banner(parent: Instance, text: string, width: number?): TextLabel
	local b = Instance.new("Frame")
	b.Name = "Banner"
	b.Size = UDim2.new(width or 0.46, 0, 0, 60)
	b.Position = UDim2.new(0.5, 0, 0, -4)
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Rotation = -1.5
	b.BackgroundColor3 = C.Sky
	b.ZIndex = 5
	b.Parent = parent
	UI.Corner(b, 14)
	UI.Stroke(b, 5, C.White)
	UI.Shade(b, 0.12)
	local lim = Instance.new("UISizeConstraint")
	lim.MinSize = Vector2.new(200, 0)
	lim.MaxSize = Vector2.new(460, 60)
	lim.Parent = b
	-- folded ribbon corner
	local fold = Instance.new("Frame")
	fold.Size = UDim2.fromOffset(22, 22)
	fold.Position = UDim2.new(1, -6, 1, -6)
	fold.AnchorPoint = Vector2.new(0.5, 0.5)
	fold.Rotation = 45
	fold.BackgroundColor3 = C.SkyDark
	fold.ZIndex = 4
	fold.Parent = b
	local t = UI.Outlined(b, text, UDim2.new(1, -24, 1, -12), UDim2.fromOffset(12, 6), { MaxText = 40, OutlineColor = C.SkyDark, Outline = 3.5, ZIndex = 6 })
	t.Name = "BannerText"
	return t
end

function UI.Text(parent: Instance, text: string, size: UDim2, pos: UDim2, props: any?): TextLabel
	local t = Instance.new("TextLabel")
	t.Size = size
	t.Position = pos
	t.BackgroundTransparency = 1
	t.Font = UI.Font
	t.Text = text
	t.TextColor3 = C.Ink
	t.TextScaled = true
	t.TextWrapped = true
	t.RichText = true
	if props then
		for k, v in props do
			if k ~= "MaxText" and k ~= "Outline" and k ~= "OutlineColor" then
				(t :: any)[k] = v
			end
		end
	end
	t.Parent = parent
	local lim = Instance.new("UITextSizeConstraint")
	lim.MaxTextSize = props and props.MaxText or 40
	lim.MinTextSize = 9
	lim.Parent = t
	return t
end

-- Outlined title text (white with a dark stroke) for over-the-world labels.
function UI.Title(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?): TextLabel
	local t = UI.Text(parent, text, size, pos, { TextColor3 = color or C.White, MaxText = 96 })
	local s = Instance.new("UIStroke")
	s.Thickness = 4
	s.Color = C.Ink
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = t
	return t
end

local function focusRing(): Frame
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.Size = UDim2.new(1, 12, 1, 12)
	f.Position = UDim2.fromOffset(-6, -6)
	local s = Instance.new("UIStroke")
	s.Thickness = 4
	s.Color = C.White
	s.Parent = f
	local s2 = Instance.new("UICorner")
	s2.CornerRadius = UDim.new(0, 20)
	s2.Parent = f
	return f
end

local clickSound: ((string) -> ())? = nil
function UI.SetSoundHook(fn: (string) -> ())
	clickSound = fn
end

export type Button = TextButton

local function luminance(c: Color3): number
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

-- Chunky rounded button. The visible text is a child label that mirrors b.Text, so
-- coloured buttons get bold white text with an outline while the button keeps its rim.
function UI.Button(parent: Instance, text: string, size: UDim2, pos: UDim2, onClick: () -> (), color: Color3?): TextButton
	local base = color or C.Yellow
	if base == C.White then
		base = C.Cream -- light buttons are warm cream, like the cards
	end
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.BackgroundColor3 = base
	b.AutoButtonColor = false
	b.Font = UI.Font
	b.Text = text
	b.TextColor3 = C.Ink
	b.TextTransparency = 1
	b.TextScaled = true
	b.Selectable = true
	b.SelectionImageObject = focusRing()
	b.Parent = parent
	UI.Corner(b, 18)
	local stroke = UI.Stroke(b, 3, base:Lerp(C.Ink, 0.45))
	UI.Shade(b)
	local light = luminance(base) > 0.72
	local label = UI.Text(b, text, UDim2.new(1, -20, 1, -12), UDim2.fromOffset(10, 6), { MaxText = 30, TextColor3 = light and C.Ink or C.White })
	label.Name = "Label"
	if not light then
		local ts = Instance.new("UIStroke")
		ts.Thickness = 2.5
		ts.Color = base:Lerp(C.Ink, 0.6)
		ts.LineJoinMode = Enum.LineJoinMode.Round
		ts.Parent = label
	end
	b:GetPropertyChangedSignal("Text"):Connect(function()
		label.Text = b.Text
	end)
	local hovered = false
	local function restyle()
		stroke.Color = hovered and C.White or b.BackgroundColor3:Lerp(C.Ink, 0.45)
		stroke.Thickness = hovered and 5 or 3
	end
	b:GetPropertyChangedSignal("BackgroundColor3"):Connect(restyle)
	local function hover(on: boolean)
		hovered = on
		restyle()
	end
	b.MouseEnter:Connect(function()
		hover(true)
		if clickSound then
			clickSound("Focus")
		end
	end)
	b.MouseLeave:Connect(function()
		hover(false)
	end)
	b.SelectionGained:Connect(function()
		hover(true)
		if clickSound then
			clickSound("Focus")
		end
	end)
	b.SelectionLost:Connect(function()
		hover(false)
	end)
	b.Activated:Connect(function()
		if b:GetAttribute("Disabled") then
			if clickSound then
				clickSound("Error")
			end
			return
		end
		if clickSound then
			clickSound("Click")
		end
		local sc = b:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		sc.Parent = b
		sc.Scale = 0.92
		TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		onClick()
	end)
	return b
end

function UI.SetDisabled(b: TextButton, disabled: boolean)
	b:SetAttribute("Disabled", disabled)
	local label = b:FindFirstChild("Label") :: TextLabel?
	if label then
		label.TextTransparency = disabled and 0.5 or 0
	else
		b.TextTransparency = disabled and 0.5 or 0
	end
	b.BackgroundTransparency = disabled and 0.35 or 0
end

----------------------------------------------------------------------------------------
-- Keyboard / gamepad menu navigation

local navList: { GuiObject } = {}
local navIndex = 0

-- Makes these buttons the active menu: arrows / WASD move, Enter activates.
function UI.SetNav(list: { GuiObject }, focusFirst: boolean?)
	navList = list
	navIndex = 0
	State.MenuOpen = #list > 0
	if #list > 0 and (focusFirst ~= false) then
		navIndex = 1
		GuiService.SelectedObject = list[1]
	elseif #list == 0 then
		GuiService.SelectedObject = nil
	end
end

function UI.NavActive(): boolean
	return #navList > 0
end

function UI.NavMove(delta: number)
	if #navList == 0 then
		return
	end
	local current = GuiService.SelectedObject
	local idx = current and table.find(navList, current) or navIndex
	local n = #navList
	for _ = 1, n do
		idx = ((idx or 0) - 1 + delta) % n + 1
		local candidate = navList[idx]
		if candidate.Visible and not candidate:GetAttribute("Disabled") then
			break
		end
	end
	navIndex = idx or 1
	GuiService.SelectedObject = navList[navIndex]
end

function UI.NavActivate()
	local current = GuiService.SelectedObject
	if current and table.find(navList, current) and current:IsA("GuiButton") then
		-- Activated can't be fired from code; buttons store their handler for this
		local fire = current:FindFirstChild("Fire") :: BindableEvent?
		if fire then
			fire:Fire()
		end
	end
end

-- Lets keyboard Enter trigger a button (Activated only fires from real input).
function UI.Bindable(b: TextButton, fn: () -> ())
	local ev = Instance.new("BindableEvent")
	ev.Name = "Fire"
	ev.Event:Connect(function()
		if b:GetAttribute("Disabled") then
			return
		end
		if clickSound then
			clickSound("Click")
		end
		fn()
	end)
	ev.Parent = b
end

-- Button + keyboard binding in one call.
function UI.NavButton(parent: Instance, text: string, size: UDim2, pos: UDim2, onClick: () -> (), color: Color3?): TextButton
	local b = UI.Button(parent, text, size, pos, onClick, color)
	UI.Bindable(b, onClick)
	return b
end

function UI.Init()
	State.SettingsChanged:Connect(applyScale)
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	end
end

-- Short pop-in animation for panels (respects Reduced Motion via ReducedShake setting).
function UI.PopIn(obj: GuiObject)
	local sc = obj:FindFirstChild("PopScale") :: UIScale?
	if not sc then
		local s = Instance.new("UIScale")
		s.Name = "PopScale"
		s.Parent = obj
		sc = s
	end
	local scale = sc :: UIScale
	if State.Settings().ReducedShake then
		scale.Scale = 1
		return
	end
	scale.Scale = 0.85
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

function UI.FormatTime(seconds: number): string
	local m = math.floor(seconds / 60)
	local s = seconds - m * 60
	return string.format("%d:%05.2f", m, s)
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="47">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-400</float>
      <float name="Gravity">140</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
