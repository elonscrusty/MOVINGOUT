      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config.luau
	Every gameplay tuning value in one place, readable by server and client.

	IMPORTANT: these numbers are RECONSTRUCTION DEFAULTS chosen to make a working game.
	None of them are measurements of the original Moving Out. Tune them by playtesting.

	Units are Roblox studs. As a rule of thumb one "metre" of the design brief is about
	4.5 studs (a mover is roughly 4.5 studs tall), so a 0.95 m doorway is about 5 studs.
	Never put secrets here: this module replicates to every client.
]]

local Config = {
	GameName = "MOVING OUT",
	Version = "0.1.0",
	MaxMovers = 4,
	StudsPerMetre = 4.5,
}

-- Fixed-rate gameplay tick on the server (Roblox steps rigid-body physics itself; this is
-- the rate our own gameplay logic, delivery checks and hazards update at).
Config.Tick = {
	Rate = 1 / 60,
	MaxCatchUp = 5, -- at most this many gameplay ticks after a stall
	DeliveryInterval = 0.1,
}

Config.Movement = {
	WalkSpeed = 16, -- ~3.6 m/s
	JumpHeight = 3.2, -- short hop: clears a step or a fallen box, not a wall
	HeightScale = 0.78, -- R15 scale for short cartoon movers
	WidthScale = 1.0,
	DepthScale = 1.0,
	-- walking speed while carrying, as a fraction of WalkSpeed, by how much of the item's
	-- needed strength the holders supply (see Carry.Strength). Resistance, not input lag.
	CarrySpeedMin = 0.42,
	CarrySpeedMax = 0.95,
}

Config.Carry = {
	Reach = 4.2, -- from the root part centre to the nearest point of the item's box
	ServerReachSlack = 2.5, -- extra distance the server tolerates (latency)
	GripSpacing = 2.4, -- two grips on the same item can't be closer than this
	HoldOffset = Vector3.new(0, 0.1, -1.9), -- carry point, root-part space (in front, waist)
	Responsiveness = 28,
	MaxVelocity = 60,
	-- lift force per holder as a fraction of the item's weight (mass * gravity)
	LiftPerHolder = { Light = 3.0, Medium = 1.6, Heavy = 0.8 },
	-- extra fraction for a holder who is the only mover in the job (solo play):
	-- heavy items become carryable but stay slow and awkward
	SoloBonus = { Light = 0, Medium = 0.3, Heavy = 0.45 },
	-- "strength needed" to walk at full carry speed, in holders
	Strength = { Light = 0.6, Medium = 1.2, Heavy = 2.0 },
	UprightTorque = 4000, -- per unit of item mass; keeps carried things upright
	UprightResponsiveness = 18,
	SpinDamping = 60, -- per unit of item mass; stops held items spinning wildly
	TargetHysteresis = 1.2, -- a new target must score this much better to steal focus
	FacingWeight = 2.5, -- how much "in front of me" matters when picking a target
	DropProtect = 0.25, -- seconds before the same player can re-grab after release
}

Config.Throw = {
	Windup = 0.22, -- single throw anticipation
	CoopWindow = 0.3, -- partners must press throw within this many seconds
	CoopWindup = 0.35,
	-- launch velocity (studs/s) by item weight class: Forward, Up
	Velocity = {
		Light = { Forward = 52, Up = 34 },
		Medium = { Forward = 38, Up = 28 },
		Heavy = { Forward = 34, Up = 30 }, -- cooperative only
	},
	ServerOwnSeconds = 1.6, -- server simulates a thrown item for this long
	Cooldown = 0.45,
}

Config.Slap = {
	Range = 4.5,
	Radius = 3.2,
	Cooldown = 0.6,
	PlayerKnock = 26,
	PlayerStun = 0.45,
	ItemPush = 18,
	GhostStun = 3.0,
}

Config.Stun = {
	CarHit = 1.3,
	GhostSpook = 1.1,
	RespawnProtect = 1.6,
}

Config.Delivery = {
	-- an item counts as delivered when at least InFraction of its 8 box corners are inside
	-- the cargo volume (with Tolerance studs of slack), it isn't held, and it has stayed
	-- that way for SettleTime. It stops counting when fewer than OutFraction are inside.
	InFraction = 7 / 8,
	OutFraction = 5 / 8,
	Tolerance = 0.6,
	SettleTime = 0.5,
	VanishDelay = 0.6, -- assist: delivered furniture disappears after this
}

Config.Recovery = {
	KillY = -30, -- below this, items and movers are recovered
	ItemDelay = 1.2,
	PlayerDelay = 1.0,
	ClearanceTries = 6,
}

Config.Breakable = {
	ImpactSpeed = 14, -- relative speed of a furniture hit that breaks a window
	ShardCount = 8,
	ShardLife = 1.4,
	DoorSlaps = 3, -- boarded doors break after this many slaps (or a hard hit)
	DoorImpactSpeed = 22,
}

Config.Hazards = {
	CarWarnTime = 2.0,
	CarSpeed = 34,
	CarKnock = 55,
	ItemKnock = 30,
	GhostSpeed = 7,
	GhostChaseSpeed = 13,
	GhostNotice = 9,
	GhostCooldown = 4.5,
	-- assist "reduced hazards" multiplies spawn intervals by this and slows ghosts
	ReducedIntervalScale = 1.8,
	ReducedSpeedScale = 0.7,
}

Config.Camera = {
	Pitch = 62, -- degrees down: near top-down like the original
	Yaw = 25, -- degrees around the up axis (levels can override)
	FieldOfView = 26, -- low FOV = restrained perspective, walls barely lean
	MinDistance = 120,
	MaxDistance = 420,
	Margin = 5, -- studs kept around each mover
	ScreenPad = 0.04, -- fraction of the half-screen kept free at the edges
	DistancePerStud = 1.05, -- preview tool fallback framing only
	FollowSpeed = 4,
	ZoomSpeed = 2,
	ZoomDeadband = 6, -- ignore distance changes smaller than this (no zoom breathing)
	FadeTransparency = 0.75,
}

Config.Countdown = 3

-- Assist options the host (first player) chooses on the job board.
Config.Assists = {
	TimeTargetScale = { 1, 1.25, 1.5, 2 },
	Defaults = {
		TimeScale = 1,
		ReducedHazards = false,
		EasyHeavy = false,
		VanishDelivered = false,
	},
}

-- Player slots: colour + number + a symbol so colour is never the only cue.
Config.Slots = {
	{ Name = "P1", Color = Color3.fromRGB(235, 72, 72), Symbol = "▲" },
	{ Name = "P2", Color = Color3.fromRGB(64, 140, 240), Symbol = "●" },
	{ Name = "P3", Color = Color3.fromRGB(245, 196, 40), Symbol = "■" },
	{ Name = "P4", Color = Color3.fromRGB(70, 200, 110), Symbol = "◆" },
}

-- Default bindings. Players can remap the three actions (saved in their profile).
Config.Bindings = {
	Keyboard = {
		Grab = "E",
		Throw = "Q",
		Slap = "F",
		Jump = "Space", -- jump is Roblox's own; listed for the controls screen
		Pause = "Escape",
	},
	-- second set that always works, for keyboards that drop key combinations
	KeyboardAlt = {
		Grab = "LeftShift",
		Throw = "R",
		Slap = "G",
	},
	Gamepad = {
		Grab = "ButtonR1",
		Throw = "ButtonX",
		Slap = "ButtonY",
		Jump = "ButtonA",
		Pause = "ButtonStart",
	},
	GamepadAlt = {
		Grab = "ButtonR2",
		Throw = "ButtonB",
		Slap = "ButtonL1",
	},
	Remappable = { "Grab", "Throw", "Slap" },
}

-- Built-in Roblox sounds (shipped with every client, so they can never be missing).
Config.Sounds = {
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.45, Pitch = 1 },
	Focus = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.2, Pitch = 1.4 },
	Grab = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.5, Pitch = 0.8 },
	Release = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.35, Pitch = 0.6 },
	Windup = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.25, Pitch = 0.9 },
	Throw = { Id = "rbxasset://sounds/Rocket whoosh 01.wav", Volume = 0.2, Pitch = 1.4 },
	ImpactWood = { Id = "rbxasset://sounds/collide.wav", Volume = 0.35, Pitch = 1.1 },
	ImpactHeavy = { Id = "rbxasset://sounds/collide.wav", Volume = 0.55, Pitch = 0.7 },
	ImpactSoft = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.45, Pitch = 1.2 },
	ImpactMetal = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.25, Pitch = 1.3 },
	Glass = { Id = "rbxasset://sounds/snap.mp3", Volume = 0.8, Pitch = 1.6 },
	GlassTinkle = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.3, Pitch = 2.6 },
	WoodBreak = { Id = "rbxasset://sounds/snap.mp3", Volume = 0.8, Pitch = 0.8 },
	Deliver = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Pitch = 1.25 },
	Undeliver = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, Pitch = 0.7 },
	Splash = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 0.7, Pitch = 1 },
	Slap = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.35, Pitch = 1.5 },
	SlapHit = { Id = "rbxasset://sounds/splat.wav", Volume = 0.5, Pitch = 1.6 },
	Jump = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.3, Pitch = 1.2 },
	Land = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.25, Pitch = 1.1 },
	Honk = { Id = "rbxasset://sounds/Launching rocket.wav", Volume = 0.25, Pitch = 2.4 },
	CarHit = { Id = "rbxasset://sounds/collide.wav", Volume = 0.7, Pitch = 0.9 },
	Ghost = { Id = "rbxasset://sounds/Rocket whoosh 01.wav", Volume = 0.35, Pitch = 0.45 },
	Stun = { Id = "rbxasset://sounds/splat.wav", Volume = 0.4, Pitch = 0.8 },
	Countdown = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Pitch = 1 },
	Go = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Pitch = 1.5 },
	Complete = { Id = "rbxasset://sounds/victory.wav", Volume = 0.6, Pitch = 1 },
	Error = { Id = "rbxasset://sounds/button.wav", Volume = 0.35, Pitch = 0.6 },
	-- tones used by the generated music
	Note = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.12, Pitch = 1 },
	Bass = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.18, Pitch = 0.5 },
}

Config.SoundRules = {
	ImpactMinSpeed = 9, -- softer contacts make no sound
	ImpactGap = 0.12, -- per item
	GlobalImpactGap = 0.04,
	MaxVoices = 16,
}

-- Defaults for per-player settings (saved in the profile; validated on load).
Config.SettingsDefaults = {
	Master = 0.8,
	Music = 0.5,
	Effects = 0.8,
	Mute = false,
	GrabToggle = true, -- press to grab, press again to drop (off = hold to carry)
	ReducedShake = false,
	TextScale = 1,
	Quality = "High", -- "High" or "Low" (fewer shadows / effects, same gameplay)
	ShowTutorialHints = true,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">FurnitureData</string>
          <string name="Source"><![CDATA[--[[
	FurnitureData.luau
	Physical stats of every furniture kind. The visual models are built on the server by
	FurnitureModels.luau; the collider is always one box of exactly Size.

	Class   Light / Medium / Heavy: carrying lift, carry speed and throw rules (Config).
	Mass    relative mass units (Light 1-3, Medium 4-8, Heavy 10-20). These are
	        reconstruction defaults, multiplied by MassScale into Roblox mass.
	Holders how many movers can grip it at once.
	Sound   impact sound family: Wood, Soft, Metal, Glass.
	Size    collider box in studs (X width, Y height, Z depth) at rotation 0.
]]

local FurnitureData = {
	MassScale = 4,
}

type Kind = {
	Name: string,
	Class: string,
	Mass: number,
	Holders: number,
	Sound: string,
	Size: Vector3,
	Friction: number?,
	Elasticity: number?,
}

local K: { [string]: Kind } = {
	-- light
	Box = { Name = "Box", Class = "Light", Mass = 2, Holders = 1, Sound = "Soft", Size = Vector3.new(2.3, 2.3, 2.3) },
	BoxTall = { Name = "Tall box", Class = "Light", Mass = 2.5, Holders = 1, Sound = "Soft", Size = Vector3.new(2, 3.1, 2) },
	Lamp = { Name = "Lamp", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Metal", Size = Vector3.new(1.6, 4.6, 1.6) },
	Stool = { Name = "Stool", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Wood", Size = Vector3.new(1.8, 2.4, 1.8) },
	SideTable = { Name = "Side table", Class = "Light", Mass = 2.5, Holders = 1, Sound = "Wood", Size = Vector3.new(2.2, 2.3, 2.2) },
	Plant = { Name = "Plant", Class = "Light", Mass = 2, Holders = 1, Sound = "Soft", Size = Vector3.new(1.8, 3.4, 1.8) },
	BeachBall = { Name = "Beach ball", Class = "Light", Mass = 1, Holders = 1, Sound = "Soft", Size = Vector3.new(2.2, 2.2, 2.2), Elasticity = 0.7 },
	Flamingo = { Name = "Pool flamingo", Class = "Light", Mass = 1, Holders = 1, Sound = "Soft", Size = Vector3.new(2.8, 3.4, 2), Elasticity = 0.5 },
	Microwave = { Name = "Microwave", Class = "Light", Mass = 3, Holders = 1, Sound = "Metal", Size = Vector3.new(2.4, 1.6, 1.8) },
	Vase = { Name = "Vase", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Glass", Size = Vector3.new(1.4, 2.4, 1.4) },
	Candelabra = { Name = "Candelabra", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Metal", Size = Vector3.new(1.6, 3, 1.6) },
	Parcel = { Name = "Parcel", Class = "Light", Mass = 2, Holders = 1, Sound = "Soft", Size = Vector3.new(2.6, 1.8, 2.2) },
	BoxSmall = { Name = "Small box", Class = "Light", Mass = 1, Holders = 1, Sound = "Soft", Size = Vector3.new(1.8, 1.5, 1.8) },
	BoxFlat = { Name = "Flat box", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Soft", Size = Vector3.new(2.8, 1.2, 2.2) },
	Toaster = { Name = "Toaster", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Metal", Size = Vector3.new(1.8, 1.4, 1.2) },
	Guitar = { Name = "Guitar", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Wood", Size = Vector3.new(1.6, 0.6, 4.2) },
	PlantSmall = { Name = "Cactus", Class = "Light", Mass = 1, Holders = 1, Sound = "Soft", Size = Vector3.new(1.4, 2.2, 1.4) },
	Bin = { Name = "Bin", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Metal", Size = Vector3.new(1.6, 2.4, 1.6) },
	RugRoll = { Name = "Rolled rug", Class = "Light", Mass = 2, Holders = 1, Sound = "Soft", Size = Vector3.new(4.4, 1, 1) },
	Fan = { Name = "Fan", Class = "Light", Mass = 1.5, Holders = 1, Sound = "Metal", Size = Vector3.new(1.6, 3.6, 1.2) },
	Suitcase = { Name = "Suitcase", Class = "Light", Mass = 2, Holders = 1, Sound = "Soft", Size = Vector3.new(2.6, 0.9, 1.8) },

	-- medium
	Chair = { Name = "Chair", Class = "Medium", Mass = 4, Holders = 2, Sound = "Wood", Size = Vector3.new(2.6, 4, 2.6) },
	TV = { Name = "TV", Class = "Medium", Mass = 5, Holders = 2, Sound = "Glass", Size = Vector3.new(3.6, 2.7, 1.4) },
	CoffeeTable = { Name = "Coffee table", Class = "Medium", Mass = 5, Holders = 2, Sound = "Wood", Size = Vector3.new(5, 2, 3) },
	Armchair = { Name = "Armchair", Class = "Medium", Mass = 7, Holders = 2, Sound = "Soft", Size = Vector3.new(3.6, 3.6, 3.4) },
	DeckChair = { Name = "Deck chair", Class = "Medium", Mass = 4, Holders = 2, Sound = "Wood", Size = Vector3.new(2.6, 2.2, 6) },
	Grill = { Name = "Barbecue", Class = "Medium", Mass = 7, Holders = 2, Sound = "Metal", Size = Vector3.new(3, 3.6, 2.2) },
	Cooler = { Name = "Cooler", Class = "Medium", Mass = 5, Holders = 2, Sound = "Soft", Size = Vector3.new(3, 2, 2) },
	Crate = { Name = "Crate", Class = "Medium", Mass = 6, Holders = 2, Sound = "Wood", Size = Vector3.new(3.4, 3.4, 3.4) },
	Barrel = { Name = "Barrel", Class = "Medium", Mass = 6, Holders = 2, Sound = "Metal", Size = Vector3.new(2.6, 3.6, 2.6) },
	Mirror = { Name = "Mirror", Class = "Medium", Mass = 4, Holders = 2, Sound = "Glass", Size = Vector3.new(2.6, 5, 0.8) },
	Toolbox = { Name = "Toolbox", Class = "Medium", Mass = 5, Holders = 2, Sound = "Metal", Size = Vector3.new(2.8, 1.8, 1.6) },
	Dresser = { Name = "Dresser", Class = "Medium", Mass = 8, Holders = 2, Sound = "Wood", Size = Vector3.new(4.4, 3.6, 2.2) },

	-- heavy
	Sofa = { Name = "Sofa", Class = "Heavy", Mass = 16, Holders = 2, Sound = "Soft", Size = Vector3.new(9, 4, 3.6) },
	Bed = { Name = "Bed", Class = "Heavy", Mass = 18, Holders = 2, Sound = "Soft", Size = Vector3.new(5.6, 2.8, 8.6) },
	Fridge = { Name = "Fridge", Class = "Heavy", Mass = 14, Holders = 2, Sound = "Metal", Size = Vector3.new(3.2, 7, 3.2) },
	DiningTable = { Name = "Dining table", Class = "Heavy", Mass = 12, Holders = 2, Sound = "Wood", Size = Vector3.new(7.5, 3.2, 4.2) },
	Piano = { Name = "Piano", Class = "Heavy", Mass = 20, Holders = 2, Sound = "Wood", Size = Vector3.new(6, 5, 2.6) },
	Clock = { Name = "Grandfather clock", Class = "Heavy", Mass = 11, Holders = 2, Sound = "Wood", Size = Vector3.new(2.4, 8, 1.8) },
	Coffin = { Name = "Coffin", Class = "Heavy", Mass = 13, Holders = 2, Sound = "Wood", Size = Vector3.new(3, 2.2, 8) },
	Bookcase = { Name = "Bookcase", Class = "Heavy", Mass = 12, Holders = 2, Sound = "Wood", Size = Vector3.new(4.4, 7, 1.8) },
	Washer = { Name = "Washing machine", Class = "Heavy", Mass = 12, Holders = 2, Sound = "Metal", Size = Vector3.new(3, 3.6, 3) },
	BigCrate = { Name = "Big crate", Class = "Heavy", Mass = 14, Holders = 2, Sound = "Wood", Size = Vector3.new(5, 4, 4) },
	Sunbed = { Name = "Sun bed", Class = "Heavy", Mass = 10, Holders = 2, Sound = "Wood", Size = Vector3.new(3, 2, 8) },
}

FurnitureData.Kinds = K

function FurnitureData.Get(kind: string): Kind
	local k = K[kind]
	assert(k, "unknown furniture kind " .. tostring(kind))
	return k
end

return FurnitureData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Jobs</string>
          <string name="Source"><![CDATA[--[[
	Jobs.luau
	The job list in campaign order, plus the lobby yard. Each level module is pure data
	(see Levels/README in docs/LEVELS.md for the format).
]]

local Levels = script.Parent:WaitForChild("Levels")

local Jobs = {}

Jobs.Lobby = require(Levels:WaitForChild("Depot")) :: any

Jobs.List = {
	require(Levels:WaitForChild("Suburb")) :: any,
	require(Levels:WaitForChild("Poolside")) :: any,
	require(Levels:WaitForChild("Warehouse")) :: any,
	require(Levels:WaitForChild("Haunted")) :: any,
}

Jobs.ById = {} :: { [string]: any }
for i, job in Jobs.List do
	job.Order = i
	Jobs.ById[job.Id] = job
end

function Jobs.Next(id: string): any?
	local job = Jobs.ById[id]
	if not job then
		return nil
	end
	return Jobs.List[job.Order + 1]
end

-- number of required items in a job
function Jobs.RequiredCount(job: any): number
	local n = 0
	for _, item in job.Items do
		if item.Required ~= false then
			n += 1
		end
	end
	return n
end

-- the medal for a time (seconds), with the assist time scale applied
function Jobs.Medal(job: any, seconds: number, scale: number?): string
	local s = scale or 1
	local a = job.Awards
	if seconds <= a.Gold * s then
		return "Gold"
	elseif seconds <= a.Silver * s then
		return "Silver"
	elseif seconds <= a.Bronze * s then
		return "Bronze"
	end
	return "None"
end

Jobs.MedalRank = { None = 0, Bronze = 1, Silver = 2, Gold = 3 }

return Jobs
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Levels</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Depot</string>
            <string name="Source"><![CDATA[--[[
	Depot.luau - the lobby yard (not a job). Movers practise grabbing, throwing,
	carrying the practice sofa together and loading the truck while the host picks a
	job. Items here are never required and never finish anything.
	Level data format: see docs/LEVELS.md.
]]

return {
	Id = "Depot",
	Name = "The Depot",
	Camera = { Yaw = 20, Pitch = 62, View = { Min = { -32, -38 }, Max = { 32, 22 } } },
	Bounds = { Min = { -60, -50 }, Max = { 60, 60 } },
	SpawnFacing = 0,
	WallStyle = {
		Outer = Color3.fromRGB(240, 128, 84), -- orange shed planks
		OuterMaterial = Enum.Material.WoodPlanks,
		Inner = Color3.fromRGB(246, 238, 220),
		Cap = Color3.fromRGB(70, 66, 76),
	},
	Ground = {
		{ Kind = "Concrete", Min = { -34, -40 }, Max = { 34, -14 }, Color = Color3.fromRGB(196, 196, 190) },
		{ Kind = "Pavement", Min = { -34, -14 }, Max = { 34, 30 } },
		{ Kind = "Road", Min = { -60, 30 }, Max = { 60, 42 } },
	},
	Floors = {
		{ Kind = "Concrete", Min = { -30, -36 }, Max = { 30, -14 }, Color = Color3.fromRGB(206, 204, 198), Pattern = "Grid", Tile = 6, Wall = Color3.fromRGB(246, 238, 220) },
	},
	Walls = {
		-- the depot shed (back), with a big doorway and a practice breakable window
