			{ At = 10, Width = 7.4, Kind = "Door" }, -- bedroom double door (bed goes out lengthwise)
			{ At = 30, Width = 8, Kind = "Door" }, -- lounge double door (sofa end-first)
			{ At = 41, Width = 8, Kind = "BreakWindow" }, -- lounge picture window: sofa shortcut
